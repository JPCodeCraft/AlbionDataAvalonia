<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyTitle>Albion Free Market Data Client</AssemblyTitle>
    <AssemblyName>AFMDataClient_Linux64</AssemblyName>
  </PropertyGroup>
  <!-- Precompile the app (ReadyToRun) so startup and each page's first visit don't wait for the JIT. .NET ships its
       own libraries precompiled, so a single-file build must not merge them into one composite image: that compiles
       them all again and doubles the file. The Roslyn compiler libraries aren't used when the app runs, so they
       stay uncompiled to keep the download smaller. -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.dll" />
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.CSharp.dll" />
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.Workspaces.dll" />
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.Scripting.dll" />
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.CSharp.Scripting.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <ProjectReference Include="..\AlbionDataAvalonia\AlbionDataAvalonia.csproj" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="Publish">
    <PropertyGroup>
      <PublishOutput>
        $(ProjectDir)bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/publish</PublishOutput>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)install/AFMDataClient_Linux64_Installer.sh" DestinationFolder="$(PublishOutput)" />
    <Copy SourceFiles="$(ProjectDir)install/AFMDataClient_Linux64_Uninstaller.sh" DestinationFolder="$(PublishOutput)" />
    <Exec Command="chmod +x $(PublishOutput)/AFMDataClient_Linux64_Installer.sh" Condition=" '$(OS)' == 'Unix' " />
    <Exec Command="chmod +x $(PublishOutput)/AFMDataClient_Linux64_Uninstaller.sh" Condition=" '$(OS)' == 'Unix' " />
  </Target>
</Project>