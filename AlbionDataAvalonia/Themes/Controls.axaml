<!-- Shared skins for Fluent controls. Pages and windows opt in with Classes="AppPage". -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AlbionDataAvalonia.Ui"
        xmlns:controls="using:AlbionDataAvalonia.Views.Controls">

    <Style Selector=".AppPage ComboBox, .AppPage TextBox, .AppPage DatePicker, .AppPage CalendarDatePicker, .AppPage TimePicker">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <!-- Time pickers count hours the way the user's own times do. -->
    <Style Selector=".AppPage TimePicker">
        <Setter Property="ClockIdentifier" Value="{x:Static ui:UiFormat.ClockIdentifier}" />
    </Style>
    <!-- Hours and minutes sit in the middle of the box, like other inputs' text. -->
    <Style Selector=".AppPage TimePicker /template/ TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Its calendar marks today, like Fluent's own Calendar does. -->
    <Style Selector=".AppPage CalendarDatePicker">
        <Setter Property="IsTodayHighlighted" Value="True" />
    </Style>
    <!-- The date picker's own box sets the height, so its text box doesn't add the input minimum again. -->
    <Style Selector=".AppPage CalendarDatePicker /template/ TextBox#PART_TextBox">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Fluent fills the days with the calendar's border color; here they share the header's surface. -->
    <Style Selector=".AppPage CalendarItem /template/ Border#BackgroundLayer">
        <Setter Property="Background" Value="{DynamicResource CalendarViewBackground}" />
    </Style>
    <!-- Fluent draws its calendar button in hairlines that vanish on a dark input; this is a plain calendar icon. -->
    <Style Selector=".AppPage CalendarDatePicker /template/ Button#PART_Button">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="8,0,10,0">
                    <PathIcon Width="14" Height="14" Foreground="{DynamicResource UiTextSecondaryBrush}"
                              Data="F1 M5,4 H19 A2,2 0 0 1 21,6 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V6 A2,2 0 0 1 5,4 Z M5,9 V19 H19 V9 Z M7,2 H9 V6 H7 Z M15,2 H17 V6 H15 Z M7,11 H10 V14 H7 Z" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector=".AppPage TextBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
    </Style>
    <Style Selector=".AppPage NumericUpDown /template/ TextBox">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector=".AppPage NumericUpDown /template/ TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
    </Style>
    <Style Selector=".AppPage NumericUpDown /template/ RepeatButton">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
    </Style>
    <Style Selector=".AppPage Expander">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusOverlay}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector=".AppPage Expander /template/ ToggleButton">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <!-- An expander inside a card row, without its own fill. -->
    <Style Selector=".AppPage Expander.Plain">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- An expander on the window with no border; its header reads as a line of text. -->
    <Style Selector=".AppPage Expander.Bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2,6,8" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector=".AppPage Expander.Bare /template/ ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="16,0,16,0" />
    </Style>
    <Style Selector=".AppPage DataGrid">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <!-- The DataGrid theme sizes its cells on its own (15), not on the control font size, so give them the body size. -->
    <Style Selector=".AppPage DataGridCell">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
    </Style>
    <!-- Tables of items: smaller text, so their rows can be shorter. -->
    <Style Selector=".AppPage DataGrid.Compact DataGridCell">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
    </Style>
    <Style Selector=".AppPage DataGridColumnHeader /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
    </Style>
    <Style Selector=".AppPage ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A ScrollRail shows its scrollbar only while the pointer is over it; the fades say there is more. -->
    <Style Selector="controls|ScrollRail:not(:pointerover) ScrollBar">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector=".AppPage GridSplitter">
        <Setter Property="Background" Value="{DynamicResource UiBorderBrush}" />
    </Style>
    <!-- Switches sit at the end of a row with no On/Off text. -->
    <Style Selector=".AppPage ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A wrapping list of chips with one selected, such as the runs of a session. -->
    <Style Selector="ListBox.UiChipList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.UiChipList ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusOverlay}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.UiChipList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiInputBrush}" />
    </Style>
    <Style Selector="ListBox.UiChipList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentTextBrush}" />
    </Style>
    <!-- A legend entry that shows or hides its layer; unchecked entries fade. -->
    <Style Selector="ToggleButton.UiLegend">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.UiLegend:checked">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.UiLegend:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.UiLegend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiHoverBrush}" />
    </Style>
</Styles>
