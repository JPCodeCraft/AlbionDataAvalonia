<!-- Export loot…, Cancel export and progress, shared by the Current, History and Items loot lists. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             x:Class="AlbionDataAvalonia.Views.ActivityLootExportBar"
             x:DataType="vm:ActivityViewModel">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="UiAction" Content="Export loot…" ToolTip.Tip="Export all pages"
                IsEnabled="{Binding $parent[views:ActivityLootExportBar].CanExport}">
            <Button.Flyout>
                <MenuFlyout>
                    <MenuItem Header="AFM CSV" Click="ExportAfmCsv_Click" />
                    <MenuItem Header="Loot Logger Viewer (.txt)" Click="ExportLootLoggerViewer_Click" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
        <Button Classes="UiAction" Content="Cancel export" Command="{Binding CancelLootExportCommand}" IsVisible="{Binding IsLootExporting}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding LootExportProgress}" IsIndeterminate="{Binding IsPreparingLootExport}" IsVisible="{Binding IsLootExporting}"
                     Width="140" Height="6" VerticalAlignment="Center" />
        <Button Classes="UiLink" Content="Open AFM Loot Logger" Command="{Binding OpenLootLoggerCommand}" VerticalAlignment="Center"
                IsVisible="{Binding $parent[views:ActivityLootExportBar].ShowLootLoggerLink}" ToolTip.Tip="View your AFM CSV export on the website" />
    </StackPanel>
</UserControl>
