<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
             x:Class="AlbionDataAvalonia.Views.ActivityStreamerView"
             x:DataType="vm:ActivityStreamerViewModel">
    <UserControl.Resources>
        <ControlTheme x:Key="StreamerScopeButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource UiRadiusPill}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{DynamicResource UiAccentTextBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource UiOnAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ControlTheme>
        <!-- Personal or party totals, switchable from the window itself; shares the setting with Settings › Streamer. -->
        <DataTemplate x:Key="StreamerScopeSwitch" x:DataType="vm:ActivityStreamerViewModel">
            <Border Background="{DynamicResource UiInputBrush}" BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource UiRadiusPill}" Padding="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource StreamerScopeButton}" Content="Personal" IsChecked="{Binding IsPersonalScope}" />
                    <RadioButton Theme="{StaticResource StreamerScopeButton}" Content="Party" IsChecked="{Binding IsPartyScope}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <!-- The streamer window is captured by streaming apps, so its cards and sizes are its own. -->
    <UserControl.Styles>
        <Style Selector="Border.StreamerCard">
            <Setter Property="Background" Value="{DynamicResource UiWindowTranslucentBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource UiRadiusOverlay}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBlock.StreamerLabel"><Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" /><Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" /></Style>
        <Style Selector="TextBlock.StreamerValue"><Setter Property="FontSize" Value="{DynamicResource UiFontSizeSection}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="TextBlock.StreamerSilver"><Setter Property="FontSize" Value="{DynamicResource UiFontSizeHeading}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource UiAccentTextBrush}" /></Style>
        <Style Selector="Grid.StreamerRow TextBlock.StreamerLabel"><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="Grid.StreamerRow TextBlock.StreamerValue"><Setter Property="Margin" Value="10,0" /></Style>
        <Style Selector="Grid.StreamerRow TextBlock.StreamerSilver"><Setter Property="FontSize" Value="{DynamicResource UiFontSizeTitle}" /><Setter Property="Margin" Value="10,0" /></Style>
        <Style Selector="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    </UserControl.Styles>
    <StackPanel Margin="8" Spacing="6">
        <!-- Small: one card with the headline numbers only. -->
        <Border Classes="StreamerCard" IsVisible="{Binding IsSmall}">
            <StackPanel Spacing="3" Grid.IsSharedSizeScope="True">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding SessionTimeText}" Classes="StreamerLabel" VerticalAlignment="Center" />
                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource StreamerScopeSwitch}" />
                </Grid>
                <Grid Classes="StreamerRow" IsVisible="{Binding Settings.StreamerShowSilver}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Silver" Classes="StreamerLabel" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.TotalSilver}" Classes="StreamerSilver" />
                    <TextBlock Grid.Column="2" Text="{Binding SilverPerHourShortText}" Classes="StreamerLabel" />
                </Grid>
                <Grid Classes="StreamerRow" IsVisible="{Binding Settings.StreamerShowCombat}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Fame" Classes="StreamerLabel" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.CombatFame}" Classes="StreamerValue" />
                    <TextBlock Grid.Column="2" Text="{Binding CombatFamePerHourShortText}" Classes="StreamerLabel" />
                </Grid>
                <Grid Classes="StreamerRow" IsVisible="{Binding Settings.StreamerShowCombat}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Damage" Classes="StreamerLabel" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.DamageDealt}" Classes="StreamerValue" />
                    <TextBlock Grid.Column="2" Text="{Binding DpsShortText}" Classes="StreamerLabel" />
                </Grid>
                <Grid Classes="StreamerRow" IsVisible="{Binding Settings.StreamerShowGathering}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Gathering EMV" Classes="StreamerLabel" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.ResourceValueText}" Classes="StreamerValue" />
                    <TextBlock Grid.Column="2" Text="{Binding GatheredPerHourShortText}" Classes="StreamerLabel" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Medium and large: one card per section; large adds the session name and breakdown lines. -->
        <Border Classes="StreamerCard" IsVisible="{Binding ShowCards}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Classes="UiSectionTitle" Text="{Binding TitleText}" IsVisible="{Binding IsLarge}" />
                    <TextBlock Text="{Binding DurationText}" Classes="StreamerLabel" IsVisible="{Binding HasSession}" />
                    <TextBlock Text="{Binding TitleText}" Classes="StreamerLabel" IsVisible="{Binding !HasSession}" />
                </StackPanel>
                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource StreamerScopeSwitch}" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <StackPanel Spacing="6" IsVisible="{Binding ShowCards}">
            <Border Classes="StreamerCard" IsVisible="{Binding Settings.StreamerShowSilver}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <controls:StatTile Classes="Accent Compact" Classes.Heading="{Binding !IsLarge}" Classes.Large="{Binding IsLarge}"
                                           Label="Total silver" Value="{Binding Summary.TotalSilver}" />
                        <controls:StatTile Grid.Column="1" Classes="Accent Compact" Classes.Heading="{Binding !IsLarge}" Classes.Large="{Binding IsLarge}"
                                           Label="Silver / hour" Value="{Binding Summary.TotalSilverPerHour}" />
                    </Grid>
                    <TextBlock Text="{Binding SilverBreakdownText}" Classes="StreamerLabel" IsVisible="{Binding IsLarge}" />
                </StackPanel>
            </Border>

            <Border Classes="StreamerCard" IsVisible="{Binding Settings.StreamerShowCombat}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <controls:StatTile Classes="Compact" Classes.Small="{Binding !IsLarge}"
                                           Label="Damage dealt" Value="{Binding Summary.DamageDealt}" Detail="{Binding Summary.DamageRate}" />
                        <controls:StatTile Grid.Column="1" Classes="Compact" Classes.Small="{Binding !IsLarge}"
                                           Label="Combat fame" Value="{Binding Summary.CombatFame}" Detail="{Binding Summary.CombatFameRate}" />
                    </Grid>
                    <TextBlock Text="{Binding KillsText}" Classes="StreamerLabel" IsVisible="{Binding IsLarge}" />
                </StackPanel>
            </Border>

            <Border Classes="StreamerCard" IsVisible="{Binding Settings.StreamerShowGathering}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <controls:StatTile Classes="Compact" Classes.Small="{Binding !IsLarge}"
                                           Label="Gathering EMV" Value="{Binding Summary.ResourceValueText}" Detail="{Binding Summary.ResourceItemsText}" />
                        <controls:StatTile Grid.Column="1" Classes="Compact" Classes.Small="{Binding !IsLarge}"
                                           Label="Gathering fame" Value="{Binding Summary.GatheringFame}" Detail="{Binding Summary.GatheringFameRate}" />
                    </Grid>
                    <TextBlock Text="{Binding Summary.ResourceRateText}" Classes="StreamerLabel" IsVisible="{Binding IsLarge}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <views:ActivityLiveTimelineView IsVisible="{Binding ShowChart}" IsCompact="True" ShowWindowSelector="False"
                                        ChartMode="{Binding ChartMode}" Snapshot="{Binding Timeline}" />

        <TextBlock Text="Choose what to show in Settings › Streamer." IsVisible="{Binding ShowNothingSelected}"
                   Classes="StreamerLabel" TextWrapping="Wrap" Margin="2" />
    </StackPanel>
</UserControl>
