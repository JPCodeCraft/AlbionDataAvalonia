<!-- AlbionDataAvalonia/Views/MainView.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	x:Class="AlbionDataAvalonia.Views.MainView"
	x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<ScrollViewer Grid.Row="0" Grid.Column="0"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">
				<StackPanel>
					<TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Albion Free Market" Margin="0,15,0,0" />
					<TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Data Client" Margin="0,5,0,15" />

					<Button Classes="UiNav"
						Classes.Active="{Binding IsDashboardSelected}"
						Command="{Binding ShowDashboardCommand}">
						<StackPanel Orientation="Horizontal">
							<PathIcon
								Data="M3,13H11V3H3V13M3,21H11V15H3V21M13,21H21V11H13V21M13,3V9H21V3H13Z"
								Width="16" Height="16" Margin="0,0,8,0" />
							<TextBlock Text="Main" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="UiNav"
						Classes.Active="{Binding IsActivitySelected}"
						Command="{Binding ShowActivityCommand}">
						<StackPanel Orientation="Horizontal">
							<PathIcon
								Data="M12,2A10,10 0 0,1 22,12H20A8,8 0 0,0 12,4V2M12,20A8,8 0 0,0 20,12H22A10,10 0 0,1 12,22V20M12,6A6,6 0 0,1 18,12H16A4,4 0 0,0 12,8V6M12,16A4,4 0 0,0 16,12H18A6,6 0 0,1 12,18V16M10,11H2V13H10V16L15,12L10,8V11Z"
								Width="16" Height="16" Margin="0,0,8,0" />
							<TextBlock Text="Activity" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="UiNav"
						IsVisible="{Binding !UserSettings.DisableAwakeningItemsTracker}"
						Classes.Active="{Binding IsLegendarySelected}"
						Command="{Binding ShowLegendaryCommand}">
						<StackPanel Orientation="Horizontal">
							<PathIcon
								Data="M12,2L15,8L22,9L17,14L18,21L12,18L6,21L7,14L2,9L9,8L12,2Z"
								Width="16" Height="16" Margin="0,0,8,0" />
							<TextBlock Text="Awakened" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="UiNav"
						Classes.Active="{Binding IsTradesSelected}"
						Command="{Binding ShowTradesCommand}">
						<StackPanel Orientation="Horizontal">
							<PathIcon
								Data="M3,3H21V5H3V3M3,7H21V9H3V7M3,11H21V13H3V11M3,15H21V17H3V15M3,19H21V21H3V19Z"
								Width="16" Height="16" Margin="0,0,8,0" />
							<TextBlock Text="Trades" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="UiNav"
						Classes.Active="{Binding IsSettingsSelected}"
						Command="{Binding ShowSettingsCommand}">
						<StackPanel Orientation="Horizontal">
							<PathIcon
								Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
								Width="16" Height="16" Margin="0,0,8,0" />
							<TextBlock Text="Settings" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="UiNav"
						Classes.Active="{Binding IsLogsSelected}"
						Command="{Binding ShowLogsCommand}">
						<StackPanel Orientation="Horizontal">
							<PathIcon
								Data="M14,10H19.5L14,4.5V10M5,3H15L21,9V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3M5,5V19H19V12H12V5H5Z"
								Width="16" Height="16" Margin="0,0,8,0" />
							<TextBlock Text="Logs" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</StackPanel>
			</ScrollViewer>

			<Rectangle Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
				Fill="{DynamicResource UiDividerBrush}" VerticalAlignment="Stretch" />

			<!-- Capture State Section: summarizes the Main tab checklist -->
			<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
				<Button Classes="UiCardButton" Margin="10,0,10,10"
					Command="{Binding ShowDashboardCommand}"
					ToolTip.Tip="{Binding StatusTooltip}">
					<StackPanel Spacing="3">
						<Grid ColumnDefinitions="Auto,*">
							<Ellipse Classes="UiStatusDot"
								Classes.Ok="{Binding StatusIsOk}"
								Classes.Busy="{Binding StatusIsWaiting}"
								Classes.Warning="{Binding StatusIsWarning}"
								Classes.Blocked="{Binding StatusIsBlocked}"
								Margin="0,0,7,0" />
							<TextBlock Grid.Column="1" Classes="UiRowTitle" Text="{Binding StatusTitle}"
								FontSize="{DynamicResource UiFontSizeCompact}" />
						</Grid>
						<TextBlock Classes="UiFine" Text="{Binding StatusSubtitle}" Margin="15,0,0,4" />
						<ItemsControl ItemsSource="{Binding SetupSteps}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Rows="1" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:SetupStepViewModel">
									<Border Height="3" Margin="1,0" CornerRadius="2" Background="{Binding StateBrush}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0"
							IsVisible="{Binding IsDiagnosticsEnabled}"
							ToolTip.Tip="Writing every packet the client uses to a diagnostics file. Turn it off in Settings › About or the Logs tab.">
							<Ellipse Classes="UiStatusDot Warning" Margin="0,0,7,0" />
							<TextBlock Grid.Column="1" Classes="UiWarning" FontSize="{DynamicResource UiFontSizeSmall}" FontWeight="SemiBold"
								TextWrapping="Wrap" Text="Diagnostics on" />
						</Grid>
					</StackPanel>
				</Button>
				<Button IsVisible="{Binding ShowMacOSCapturePermissionSetup}"
					IsEnabled="{Binding !IsInstallingMacOSCapturePermissions}"
					Command="{Binding InstallMacOSCapturePermissionsCommand}"
					HorizontalAlignment="Stretch"
					Margin="10,0,10,10"
					ToolTip.Tip="Runs the bundled macOS packet capture setup through Apple's administrator prompt.">
					<StackPanel Orientation="Horizontal">
						<PathIcon
							Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,7H13V13H11V7M11,15H13V17H11V15Z"
							Width="14" Height="14" Margin="0,0,6,0" />
						<TextBlock Text="{Binding MacOSCapturePermissionButtonText}"
							FontSize="{DynamicResource UiFontSizeCaption}"
							VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</StackPanel>

			<!-- Authentication Section -->
			<Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
				Classes="UiCard Subtle" Margin="10" Padding="10">
				<!-- Single container for both states -->
				<Grid>
					<!-- Login Button (when logged out) -->
					<StackPanel IsVisible="{Binding !UserLoggedIn}">
						<Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
							<Border Width="26" Height="26" CornerRadius="13" Margin="0,0,9,0"
								VerticalAlignment="Top" Background="{DynamicResource UiNeutralFillBrush}">
								<PathIcon
									Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
									Width="13" Height="13" Foreground="{DynamicResource UiTextSecondaryBrush}" />
							</Border>
							<StackPanel Grid.Column="1" Spacing="1">
								<TextBlock Classes="UiRowTitle" Text="Signed out" FontSize="{DynamicResource UiFontSizeCompact}" />
								<TextBlock Classes="UiFine" Text="Public uploads to AODP still work." />
							</StackPanel>
						</Grid>

						<TextBlock Classes="UiFine"
							IsVisible="{Binding ShowLoginStatus}"
							Text="{Binding LoginStatus}"
							Margin="0,0,0,8" />

						<Button Classes="UiPrimary"
							IsVisible="{Binding !IsLoginPending}"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Command="{Binding LoginCommand}"
							ToolTip.Tip="Sign in with Google to send market orders privately to AFM, upload specs and track your island.">
							<TextBlock Text="Sign in" TextAlignment="Center" />
						</Button>

						<StackPanel IsVisible="{Binding IsLoginPending}" Spacing="5">
							<Button HorizontalAlignment="Stretch"
								IsEnabled="{Binding HasLoginAuthorizationUrl}"
								Command="{Binding OpenLoginBrowserCommand}"
								Content="Open browser again" />
							<Button HorizontalAlignment="Stretch"
								IsEnabled="{Binding HasLoginAuthorizationUrl}"
								Click="CopyLoginLink_Click"
								Content="Copy sign-in link" />
							<Button HorizontalAlignment="Stretch"
								Command="{Binding CancelLoginCommand}"
								Content="Cancel" />
						</StackPanel>
					</StackPanel>

					<!-- User Account Section (when logged in) -->
					<StackPanel IsVisible="{Binding UserLoggedIn}" Orientation="Vertical">

						<!-- Options group -->
						<StackPanel Margin="0,0,0,10">
							<TextBlock Classes="UiCaption" Text="MARKET ORDERS" Margin="0,0,0,5" />
							<CheckBox IsChecked="{Binding UploadToAfmOnly}"
								ToolTip.Tip="Send buy and sell orders to AFM for your flipper and website price tools instead of AODP. Sharing follows the options below. Market history, gold prices and bandit events remain public. Requires sign-in."
								Margin="0,0,0,8" FontSize="{DynamicResource UiFontSizeCaption}">Private mode</CheckBox>
							<Border BorderBrush="{DynamicResource UiBorderSubtleBrush}"
								BorderThickness="2,0,0,0"
								Padding="10,0,0,0"
								Margin="0,0,0,6">
								<StackPanel>
									<CheckBox IsChecked="{Binding ContributeToPublic}"
										IsEnabled="{Binding UploadToAfmOnly}"
										ToolTip.Tip="Let other AFM users use your market orders in the flipper and website price tools. These orders are not sent to AODP. Turning sharing off stops new shared uploads. Previously shared price summaries keep their original expiry, up to two days."
										Margin="0,0,0,5" FontSize="{DynamicResource UiFontSizeCaption}">Share with other AFM users</CheckBox>
									<CheckBox IsChecked="{Binding ShareWithFriends}"
										IsEnabled="{Binding UploadToAfmOnly}"
										ToolTip.Tip="Share market orders with up to five people in Settings › Uploads &amp; sharing, only when you have added each other. They can use them in the flipper and website price tools. Turning sharing off stops new shared uploads. Previously shared price summaries keep their original expiry, up to two days."
										Margin="0,0,0,5" FontSize="{DynamicResource UiFontSizeCaption}">Share with friends</CheckBox>
								</StackPanel>
							</Border>
							<Button Classes="UiLink" FontSize="{DynamicResource UiFontSizeCaption}" Margin="0,2,0,0"
								Content="More upload settings ›"
								Command="{Binding ShowUploadSettingsCommand}" />
						</StackPanel>

						<!-- Logout button -->
						<Button Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal">
								<PathIcon
									Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z"
									Width="16" Height="16" Margin="0,0,6,0" />
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="Sign out" VerticalAlignment="Center" />
									<TextBlock Classes="UiFine"
										Text="{Binding FirebaseUser.Initials, StringFormat=' [{0}]'}"
										VerticalAlignment="Center"
										Margin="4,0,0,0" />
								</StackPanel>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- Main Content -->
		<ContentControl Grid.Column="1" Margin="10" Content="{Binding CurrentView}">
		</ContentControl>
	</Grid>
</UserControl>
