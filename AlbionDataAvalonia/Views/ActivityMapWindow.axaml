<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
        xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
        x:Class="AlbionDataAvalonia.Views.ActivityMapWindow" Classes="AppPage"
        x:DataType="vm:ActivityMapViewModel"
        Title="AFM Map" Icon="/Assets/logo.ico"
        Width="980" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#303030">
    <Window.Styles>
        <Style Selector="Border.Overlay">
            <Setter Property="Background" Value="#B0000000" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="ToggleButton.Legend">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ToggleButton.Legend:checked">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ToggleButton.Legend:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.Legend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.MapTool">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#B0000000" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="12,8,12,4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <views:ActivitySegmentedSelector ItemsSource="{Binding ModeOptions}" SelectedIndex="{Binding SelectedModeIndex}"
                                                 AutomationProperties.Name="Map mode" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,4">
                    <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" IsVisible="{Binding IsHistory}"
                              MinWidth="260" MaxWidth="420" AutomationProperties.Name="Run" PlaceholderText="No runs with positions yet">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityMapRunOption">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding RunMaps}" SelectedItem="{Binding SelectedRunMap}" MinWidth="150"
                              IsVisible="{Binding HasMultipleRunMaps}" AutomationProperties.Name="Map in this run">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityMapRunMapOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="Muted"
                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLive}" VerticalAlignment="Center">
                    <TextBlock Text="Fade after" Classes="Muted" VerticalAlignment="Center" Margin="0,0,0,4" />
                    <views:ActivitySegmentedSelector ItemsSource="{Binding FadeOptions}" SelectedIndex="{Binding SelectedFadeIndex}"
                                                     AutomationProperties.Name="Fade path and events after" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:ActivityMapCanvas x:Name="MapCanvas" Scene="{Binding Scene}" Follow="{Binding Follow, Mode=TwoWay}" />

            <Border Classes="Overlay" IsVisible="{Binding HasNote}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" MaxWidth="460">
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" IsVisible="{Binding ShowFollow}">
                <Border Classes="Overlay" IsVisible="{Binding Follow}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AFMOrange}" VerticalAlignment="Center" />
                        <TextBlock Text="Following you" FontSize="12" />
                    </StackPanel>
                </Border>
                <Button Content="Follow me" Command="{Binding FollowMeCommand}" IsVisible="{Binding !Follow}" FontSize="12"
                        Background="#B0000000" ToolTip.Tip="Keep your character in the middle of the map" />
            </StackPanel>

            <Border Classes="Overlay" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="6,4">
                <WrapPanel MaxWidth="560">
                    <ToggleButton Classes="Legend" IsChecked="{Binding ShowPath}" ToolTip.Tip="Show or hide your path">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="4" CornerRadius="2" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="#4FC3F7" Offset="0" />
                                        <GradientStop Color="#FFA726" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="Path" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="Legend" IsChecked="{Binding ShowKills}" ToolTip.Tip="Mobs and players you helped kill">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{Binding KillLegendBrush}" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Kills" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="Legend" IsChecked="{Binding ShowLoot}" ToolTip.Tip="Items you picked up">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{Binding LootLegendBrush}" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Loot" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="Legend" IsChecked="{Binding ShowGathering}" ToolTip.Tip="Resources you gathered and fish you caught">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M5,0 L10,9 L0,9 Z" Fill="{Binding GatheringLegendBrush}" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Gathering" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="Legend" IsChecked="{Binding ShowDeaths}" ToolTip.Tip="Where you died or were knocked down">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{Binding DeathLegendBrush}" StrokeThickness="2" VerticalAlignment="Center" />
                            <TextBlock Text="Deaths" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="Legend" IsChecked="{Binding ShowFeatures}" ToolTip.Tip="Zone exits and the game's minimap icons">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="#4A90E2" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Exits &amp; icons" />
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>
            </Border>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="6">
                <Button Classes="MapTool" Content="+" Click="ZoomIn_Click" ToolTip.Tip="Zoom in" />
                <Button Classes="MapTool" Content="−" Click="ZoomOut_Click" ToolTip.Tip="Zoom out" />
                <Button Classes="MapTool" Content="⤢" FontSize="13" Click="Fit_Click" ToolTip.Tip="Fit to view" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" IsVisible="{Binding IsHistory}" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                <Button Content="{Binding PlayButtonText}" Command="{Binding TogglePlayCommand}" Width="34" Height="34" CornerRadius="17"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Replay this run" />
                <TextBlock Grid.Column="1" Text="{Binding TimelineStartText}" Classes="Muted" VerticalAlignment="Center" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <views:ActivityMapTimelineTicks Ticks="{Binding Ticks}" Height="14" VerticalAlignment="Center" Opacity="0.85" />
                    <Slider Minimum="0" Maximum="{Binding TimelineMaximum}" Value="{Binding TimelineValue}" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding TimelineNowText}" AutomationProperties.Name="Replay position" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding TimelineEndText}" Classes="Muted" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding RunSummaryText}" Classes="Muted" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
