<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="AlbionDataAvalonia.Views.ActivityView"
             x:DataType="vm:ActivityViewModel" Classes="AppPage">
    <UserControl.Resources>
        <StreamGeometry x:Key="ActivityPartyIcon">M6,2.5 A2.5,2.5 0 1 0 6,7.5 A2.5,2.5 0 1 0 6,2.5 Z M1,14 C1,10.5 3,9 6,9 C9,9 11,10.5 11,14 Z M11.5,2.5 A2,2 0 1 0 11.5,6.5 A2,2 0 1 0 11.5,2.5 Z M12,8.5 C14,8.7 15.5,10 15.5,13 L12.3,13 C12.1,11 11.5,9.6 10.6,8.9 C11,8.6 11.5,8.5 12,8.5 Z</StreamGeometry>
        <DataTemplate x:Key="KillSummaryTemplate" x:DataType="vm:ActivitySummaryPresentation">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding OutcomesDetailsText}">
                <TextBlock Classes="UiLabel" Text="Mob kills" />
                <TextBlock Grid.Column="1" Classes="UiLabel" Text="{Binding PlayerKillsLabel}" />
                <TextBlock Grid.Row="1" Classes="ActivityValue" Text="{Binding MobKills}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="ActivityValue" Text="{Binding PlayerKills}" Foreground="#EB9C64" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="UiLabel" Text="{Binding DeathsAndKnockdowns}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SummaryTemplate" x:DataType="vm:ActivitySummaryPresentation">
            <StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,0,0,6" ToolTip.Tip="{Binding TotalSilverDetailsText}">
                <Border Classes="UiCard ActivityIncomeCard"><StackPanel><TextBlock Classes="UiLabel" Text="Total Silver" /><TextBlock Classes="ActivityIncomeValue" Text="{Binding TotalSilver}" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="UiCard ActivityIncomeCard"><StackPanel><TextBlock Classes="UiLabel" Text="Total Silver / Hour" /><TextBlock Classes="ActivityIncomeValue" Text="{Binding TotalSilverPerHour}" /><TextBlock Classes="UiLabel" Text="{Binding TotalSilverPerRunHourText}" IsVisible="{Binding HasRunRate}" ToolTip.Tip="Silver per hour spent in runs, without the time between them" /></StackPanel></Border>
            </Grid>
            <views:ResponsiveUniformGrid IsVisible="{Binding !IsImported}" MaximumColumns="4" MinimumItemWidth="156" Margin="-3">
                <Border Classes="UiCard ActivityMetricCard" Margin="3"><StackPanel><TextBlock Classes="UiLabel" Text="Damage dealt" /><TextBlock Classes="ActivityValue" Text="{Binding DamageDealt}" /><TextBlock Classes="UiLabel" Text="{Binding DamageRate}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3"><StackPanel><TextBlock Classes="UiLabel" Text="Damage received" /><TextBlock Classes="ActivityValue" Text="{Binding DamageReceived}" /><TextBlock Classes="UiLabel" Text="{Binding DamageReceivedRate}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3"><StackPanel><TextBlock Classes="UiLabel" Text="Healing done" /><TextBlock Classes="ActivityValue" Text="{Binding HealingDone}" /><TextBlock Classes="UiLabel" Text="{Binding HealingRate}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3"><StackPanel><TextBlock Classes="UiLabel" Text="Healing received" /><TextBlock Classes="ActivityValue" Text="{Binding HealingReceived}" /><TextBlock Classes="UiLabel" Text="{Binding HealingReceivedRate}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3" ToolTip.Tip="{Binding CombatFameDetailsText}"><StackPanel><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="UiLabel" Text="Combat Fame" /><TextBlock Grid.Column="1" Margin="6,0,0,0" Classes="UiLabel" Text="{Binding CombatQuickLearnFameText}" IsVisible="{Binding HasCombatQuickLearnFame}" Foreground="{DynamicResource AFMOrange}" /></Grid><TextBlock Classes="ActivityValue" Text="{Binding CombatFame}" /><TextBlock Classes="UiLabel" Text="{Binding CombatFameFooterText}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3" ToolTip.Tip="{Binding SilverDetailsText}"><StackPanel><TextBlock Classes="UiLabel" Text="Silver picked up" /><TextBlock Classes="ActivityValue" Text="{Binding Silver}" /><TextBlock Classes="UiLabel" Text="{Binding SilverFooterText}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3" ToolTip.Tip="{Binding ItemsDetailsText}"><StackPanel><TextBlock Classes="UiLabel" Text="Loot value" /><TextBlock Classes="ActivityValue" Text="{Binding LootValue}" /><TextBlock Classes="UiLabel" Text="{Binding ItemsFooterText}" /></StackPanel></Border>
                <Border Classes="UiCard ActivityMetricCard" Margin="3"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource KillSummaryTemplate}" /></Border>
                </views:ResponsiveUniformGrid>
                <Border IsVisible="{Binding !IsImported}" Margin="0,6,0,0" Classes="UiCard" ToolTip.Tip="{Binding ResourceValueDetailsText}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,0"><TextBlock FontSize="16" FontWeight="DemiBold" Text="{Binding ResourceItemsText}" /><TextBlock Classes="UiLabel" Text="{Binding ResourceBreakdownText}" /></StackPanel>
                        <StackPanel Margin="0,0,20,0"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="UiLabel" Text="Gathering EMV" VerticalAlignment="Center" /><TextBlock FontSize="16" FontWeight="DemiBold" Text="{Binding ResourceValueText}" /></StackPanel><TextBlock Classes="UiLabel" Text="{Binding ResourceRateText}" /></StackPanel>
                        <StackPanel Margin="0,0,20,0" ToolTip.Tip="{Binding GatheringFameDetailsText}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="UiLabel" Text="Gathering Fame" VerticalAlignment="Center" /><TextBlock FontSize="16" FontWeight="DemiBold" Text="{Binding GatheringFame}" /></StackPanel><TextBlock Classes="UiLabel" Text="{Binding GatheringFameRate}" IsVisible="{Binding IsSessionAverage}" /><TextBlock Classes="UiLabel" Text="{Binding GatheringQuickLearnFameText}" IsVisible="{Binding HasGatheringQuickLearnFame}" Foreground="{DynamicResource AFMOrange}" /></StackPanel>
                    </WrapPanel>
                </Border>
            <TextBlock Classes="UiLabel" Text="{Binding UnknownFameText}" IsVisible="{Binding HasUnknownFame}" Margin="0,6,0,0" ToolTip.Tip="Fame without a known activity" />
            <Grid IsVisible="{Binding IsImported}" ColumnDefinitions="*,*" ColumnSpacing="6">
                <Border Classes="UiCard ActivityMetricCard" ToolTip.Tip="{Binding ResourceBreakdownText}"><StackPanel><TextBlock Classes="UiLabel" Text="Items gathered" /><TextBlock Classes="ActivityValue" Text="{Binding ResourceQuantityText}" /><TextBlock Classes="UiLabel" Text="{Binding ResourceBreakdownText}" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="UiCard ActivityMetricCard" ToolTip.Tip="{Binding ResourceValueDetailsText}"><StackPanel><TextBlock Classes="UiLabel" Text="Estimated gathering value" /><TextBlock Classes="ActivityValue" Text="{Binding ResourceValueText}" /><TextBlock Classes="UiLabel" Text="{Binding ResourceRateText}" /></StackPanel></Border>
            </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LootTemplate" x:DataType="vm:ActivityLootRow">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTip.Tip="{Binding ItemDetails}">
                <Image Width="32" Height="32" Stretch="Uniform"
                       items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}"
                       items:LazyItemImage.Quality="{Binding ImageQuality}" />
                <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding ItemName}" TextWrapping="Wrap" /><TextBlock Text="{Binding Quality}" Classes="UiLabel" /></StackPanel>
            </StackPanel>
        </DataTemplate>
        <!-- History rows show the same item without hover details. -->
        <DataTemplate x:Key="LootItemTemplate" x:DataType="vm:ActivityLootRow">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Width="32" Height="32" Stretch="Uniform"
                       items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}"
                       items:LazyItemImage.Quality="{Binding ImageQuality}" />
                <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding ItemName}" TextWrapping="Wrap" /><TextBlock Text="{Binding Quality}" Classes="UiLabel" /></StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActivityVisibilityTemplate" x:DataType="vm:ActivityViewModel">
            <!-- Keep spacing between wrapped rows without adding a trailing gap to the section. -->
            <WrapPanel Margin="0,0,0,-4">
                <TextBlock Text="Show" Classes="UiLabel" VerticalAlignment="Center" Margin="0,0,12,4" />
                <CheckBox Content="All" IsChecked="{Binding ShowAllActivities, Mode=TwoWay}" MinHeight="24" Margin="0,0,18,4" />
                <CheckBox Content="Gathering" IsChecked="{Binding ShowGathering, Mode=TwoWay}" MinHeight="24" Margin="0,0,18,4" />
                <CheckBox Content="Fishing" IsChecked="{Binding ShowFishing, Mode=TwoWay}" MinHeight="24" Margin="0,0,18,4" />
                <CheckBox Content="PvE" IsChecked="{Binding ShowPve, Mode=TwoWay}" MinHeight="24" Margin="0,0,18,4" />
                <CheckBox Content="PvP" IsChecked="{Binding ShowPvp, Mode=TwoWay}" MinHeight="24" Margin="0,0,18,4" />
                <CheckBox Content="Other" IsChecked="{Binding ShowOther, Mode=TwoWay}" MinHeight="24" Margin="0,0,18,4" />
            </WrapPanel>
        </DataTemplate>
        <DataTemplate x:Key="ActivityResourceTileTemplate" x:DataType="vm:ActivityResourceRow">
            <Border Width="230" Padding="8" Margin="0,0,6,6" CornerRadius="4" Background="{DynamicResource UiInputBrush}" ToolTip.Tip="{Binding Details}">
                <Grid ColumnDefinitions="32,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                    <Image Grid.RowSpan="2" Width="32" Height="32" Stretch="Uniform" items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}" items:LazyItemImage.Quality="{Binding ImageQuality}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding ItemName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"><TextBlock Text="×" FontSize="12" /><TextBlock Text="{Binding QuantityText}" FontSize="13" FontWeight="DemiBold" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                        <TextBlock Text="{Binding ValueLabel}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="13" FontWeight="DemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="*" Foreground="#FFB74D" IsVisible="{Binding HasMissingPrices}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Expander"><Setter Property="MinHeight" Value="40" /></Style>
        <Style Selector="TextBlock.ActivityValue"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="DemiBold" /><Setter Property="Margin" Value="0,2,0,2" /></Style>
        <Style Selector="Border.ActivityIncomeCard"><Setter Property="MinHeight" Value="64" /><Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Border.ActivityIncomeCard TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="MaxLines" Value="1" /></Style>
        <Style Selector="TextBlock.ActivityIncomeValue"><Setter Property="FontSize" Value="22" /><Setter Property="LineHeight" Value="28" /><Setter Property="FontWeight" Value="DemiBold" /><Setter Property="Foreground" Value="{DynamicResource AFMOrange}" /><Setter Property="Margin" Value="0,2,0,0" /></Style>
        <Style Selector="Border.ActivityMetricCard"><Setter Property="Height" Value="76" /></Style>
        <Style Selector="Border.ActivityMetricCard TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="MaxLines" Value="1" /></Style>
        <Style Selector="Border.ActivityMetricCard TextBlock.UiLabel"><Setter Property="LineHeight" Value="16" /></Style>
        <Style Selector="Border.ActivityMetricCard TextBlock.ActivityValue"><Setter Property="LineHeight" Value="24" /></Style>
        <Style Selector="ListBox.ActivitySessionList"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="ListBox.ActivitySessionList ListBoxItem"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
        <Style Selector="ListBox.ActivitySessionList ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource UiInputBrush}" /></Style>
        <Style Selector="ListBox.ActivitySessionList ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AFMBrown}" /><Setter Property="BorderBrush" Value="{DynamicResource AFMOrange}" /><Setter Property="BorderThickness" Value="3,0,0,0" /></Style>
        <Style Selector="DataGrid"><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" /></Style>
        <Style Selector="Button.ActivityPartyChip"><Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="10,4" /><Setter Property="MinHeight" Value="28" /></Style>
        <Style Selector="Button.ActivityPartyChip:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AFMOrange}" /></Style>
        <Style Selector="Border.ActivityPartyMember"><Setter Property="Background" Value="{DynamicResource UiInputBrush}" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="8,2" /><Setter Property="Margin" Value="0,0,4,4" /></Style>
        <Style Selector="Border.ActivityPartyMember.You"><Setter Property="Background" Value="{DynamicResource AFMBrown}" /><Setter Property="BorderBrush" Value="{DynamicResource AFMOrange}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.ActivityRunChip"><Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,4" /><Setter Property="Margin" Value="0,0,6,6" /></Style>
        <Style Selector="Button.ActivityRunChip.Live"><Setter Property="BorderBrush" Value="{DynamicResource AFMOrange}" /></Style>
        <Style Selector="Button.ActivityRunChip:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AFMOrange}" /></Style>
        <Style Selector="ListBox.ActivityRunChips"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
        <Style Selector="ListBox.ActivityRunChips ListBoxItem"><Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,4" /><Setter Property="Margin" Value="0,0,6,6" /><Setter Property="MinHeight" Value="0" /></Style>
        <Style Selector="ListBox.ActivityRunChips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiInputBrush}" /></Style>
        <Style Selector="ListBox.ActivityRunChips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AFMBrown}" /><Setter Property="BorderBrush" Value="{DynamicResource AFMOrange}" /></Style>
        <Style Selector="TextBlock.PartyChange"><Setter Property="Foreground" Value="#F47D7D" /></Style>
        <Style Selector="TextBlock.PartyChange.Joined"><Setter Property="Foreground" Value="#A0D477" /></Style>
        <Style Selector="TabControl.ActivityDetails TabItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="FontSize" Value="16" /></Style>
        <Style Selector="TabControl.ActivityDetails DataGrid">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MaxHeight" Value="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0" RowSpacing="12">
        <StackPanel Spacing="8">
            <WrapPanel Margin="0,0,0,-4">
                <StackPanel Spacing="2" MinWidth="180" Margin="0,0,24,4">
                    <TextBlock Text="Activity" FontSize="23" FontWeight="DemiBold" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <views:ActivitySegmentedSelector ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope, Mode=TwoWay}" IsVisible="{Binding ShowActivityScope}" AutomationProperties.Name="Activity scope" Margin="0,0,12,0" />
                    <Button Classes="UiAction UiSecondary" Content="{Binding StreamerWindowButtonText}" Command="{Binding ToggleStreamerWindowCommand}" IsVisible="{Binding CanOpenStreamerWindow}"
                            ToolTip.Tip="A compact window with the current session for streaming. Choose what it shows in Settings → Activity." Margin="0,0,10,4" />
                    <Button Classes="UiAction UiSecondary" Content="{Binding RecordingButtonText}" Command="{Binding ToggleRecordingCommand}" Margin="0,0,10,4" />
                    <Button Classes="UiAction" Content="New session" Click="NewSession_Click" IsEnabled="{Binding HasCurrentPlaySession}" Margin="0,0,0,4"
                            ToolTip.Tip="End this session at your last activity. Your next activity starts a new one." />
                </WrapPanel>
            </WrapPanel>
            <TextBlock Text="{Binding LegacyImportWarningText}" IsVisible="{Binding HasLegacyImportWarning}" Foreground="#FFB74D" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Foreground="#FFB74D" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Current">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,8,12,8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding CurrentTitle}" FontSize="20" FontWeight="DemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentDescription}" IsVisible="{Binding CurrentDescription, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Opacity="0.75" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="UiAction UiSecondary" Content="View session" Command="{Binding OpenCurrentSessionCommand}" IsEnabled="{Binding HasCurrentPlaySession}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,0,0,-4">
                                <views:ActivitySegmentedSelector ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" AutomationProperties.Name="Current totals period" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsLastHoursPeriod}" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding LastHours, Mode=TwoWay}" Minimum="1" Maximum="168" Increment="1" FormatString="0" Width="124" Height="32" Background="{DynamicResource UiInputBrush}" BorderBrush="{DynamicResource UiBorderBrush}" ToolTip.Tip="Show activity from the last 1–168 hours" />
                                    <TextBlock Text="hours" Classes="UiLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CurrentPeriodDescription}" MinHeight="16" Classes="UiLabel" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <WrapPanel ToolTip.Tip="{Binding CurrentPeriodWarning}" Margin="0,0,0,-4">
                                        <TextBlock Text="{Binding CurrentDurationText}" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding CurrentRunTimeText}" IsVisible="{Binding HasCurrentRunTime}" Margin="0,0,18,4" ToolTip.Tip="Time spent in runs, without the time between them" />
                                        <TextBlock Text="{Binding CurrentCombatDurationText}" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding CurrentTagsText}" Foreground="#A0D477" Margin="0,0,18,4" IsVisible="{Binding CurrentTagsText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding CurrentStateText}" IsVisible="{Binding HasCurrentState}" Foreground="{DynamicResource AFMOrange}" Margin="0,0,0,4"
                                                   ToolTip.Tip="Time between runs counts once you play again within 30 minutes" />
                                    </WrapPanel>
                                    <Button Grid.Column="1" Classes="ActivityPartyChip" IsVisible="{Binding HasCurrentParty}" ToolTip.Tip="{Binding CurrentPartyDetailsText}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" AutomationProperties.Name="Current party">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource ActivityPartyIcon}" Width="14" Height="14" Foreground="{DynamicResource AFMOrange}" />
                                            <TextBlock Text="{Binding CurrentPartyText}" FontWeight="DemiBold" Foreground="{DynamicResource AFMOrange}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CurrentPartyPreviewText}" IsVisible="{Binding HasCurrentPartyPreview}" Opacity="0.8" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Width="340" Spacing="10">
                                                    <TextBlock Text="{Binding CurrentPartyHeaderText}" FontSize="15" FontWeight="DemiBold" />
                                                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding CurrentPartyMembers}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ActivityPartyMemberChip">
                                                                    <Border Classes="ActivityPartyMember" Classes.You="{Binding IsYou}">
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <StackPanel Spacing="4" IsVisible="{Binding HasCurrentPartyChanges}">
                                                        <TextBlock Text="Recent changes" Classes="UiLabel" />
                                                        <ItemsControl ItemsSource="{Binding CurrentPartyChanges}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ActivityPartyChangeRow">
                                                                    <Grid ColumnDefinitions="64,52,*,Auto" ColumnSpacing="6" Margin="0,1">
                                                                        <TextBlock Text="{Binding TimeText}" Classes="UiLabel" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Change}" Classes="PartyChange" Classes.Joined="{Binding Joined}" FontSize="12" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Player}" ToolTip.Tip="{Binding PlayerDetails}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding PartySizeText}" Classes="UiLabel" VerticalAlignment="Center" ToolTip.Tip="Party size after the change" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <TextBlock Text="Joins and departures are saved with the session. See History → Party for the full timeline." Classes="UiLabel" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding ShowCurrentRuns}">
                                <TextBlock Text="Runs in this session" Classes="UiLabel" />
                                <ItemsControl ItemsSource="{Binding CurrentRuns}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivitySessionRow">
                                            <Button Classes="ActivityRunChip" Classes.Live="{Binding IsLive}" Click="RunChip_Click" ToolTip.Tip="{Binding RunDetailsText}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding RunLabel}" FontSize="12" FontWeight="DemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding RunSummaryText}" Classes="UiLabel" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding CurrentSummary}" ContentTemplate="{StaticResource SummaryTemplate}" />
                        <Expander Header="Gathered" IsExpanded="False" HorizontalAlignment="Stretch" Padding="0">
                            <StackPanel Margin="8,8,8,2"><TextBlock Text="0 items gathered" IsVisible="{Binding !HasCurrentResources}" Classes="UiLabel" Margin="4,4,4,8" /><ScrollViewer MaxHeight="144" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding CurrentResources}" ItemTemplate="{StaticResource ActivityResourceTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></StackPanel>
                        </Expander>
                        <Expander x:Name="CurrentLootPanel" Header="Loot" IsExpanded="{Binding IsCurrentLootExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0">
                            <StackPanel Margin="8,8,8,2" Spacing="8">
                                <TextBlock Text="0 items looted" IsVisible="{Binding !HasCurrentLoot}" Classes="UiLabel" Margin="4,4,4,8" />
                                <DataGrid ItemsSource="{Binding CurrentLoot}" RowHeight="56" IsVisible="{Binding HasCurrentLoot}" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" />
                                        <DataGridTemplateColumn Header="Item" Width="*" MinWidth="200" CellTemplate="{StaticResource LootTemplate}" />
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding AmountText}" />
                                        <DataGridTextColumn Header="Estimated value" Binding="{Binding ValueText}" />
                                        <DataGridTemplateColumn Header="Recipient" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ActivityLootRow">
                                                    <TextBlock Text="{Binding Recipient}" ToolTip.Tip="{Binding RecipientDetails}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" />
                                        <DataGridTextColumn Header="Alliance" Binding="{Binding Alliance}" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                                        <DataGridTextColumn Header="Source guild" Binding="{Binding LootSourceGuild}" />
                                        <DataGridTextColumn Header="Source alliance" Binding="{Binding LootSourceAlliance}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="4,0,4,6" IsVisible="{Binding HasCurrentLoot}">
                                    <TextBlock Text="{Binding CurrentSummary.LootItemsText}" Classes="UiLabel" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="Estimated value" Classes="UiLabel" />
                                        <TextBlock Text="{Binding CurrentSummary.LootValue}" FontWeight="DemiBold" />
                                        <TextBlock Text="silver" Classes="UiLabel" />
                                    </StackPanel>
                                    <Button Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreCurrentLootCommand}" IsVisible="{Binding HasMoreCurrentLoot}" Margin="0,0,8,0" />
                                    <Button Classes="UiAction UiSecondary" Content="Export loot…" IsEnabled="{Binding CanStartLootExport}" ToolTip.Tip="Export the loot shown here across all pages" Margin="0,0,8,0">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="AFM CSV" Tag="{x:Static vm:LootExportFormat.AfmCsv}" Click="ExportCurrentLoot_Click" />
                                                <MenuItem Header="Loot Logger Viewer (.txt)" Tag="{x:Static vm:LootExportFormat.LootLoggerViewer}" Click="ExportCurrentLoot_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="UiAction UiSecondary" Content="Cancel export" Command="{Binding CancelLootExportCommand}" IsVisible="{Binding IsLootExporting}" Margin="0,0,8,0" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding LootExportProgress}" IsIndeterminate="{Binding IsPreparingLootExport}" IsVisible="{Binding IsLootExporting}" Width="140" Height="6" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBlock Classes="UiLabel" Text="{Binding LootExportStatusText}" IsVisible="{Binding HasLootExportStatus}" TextWrapping="Wrap" Margin="4,0,4,6" />
                            </StackPanel>
                        </Expander>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityVisibilityTemplate}" />
                        <views:ActivityLiveTimelineView ChartMode="{Binding ChartMode, Mode=TwoWay}" Snapshot="{Binding CurrentLiveTimeline}" WindowMinutes="{Binding LiveTimelineMinutes, Mode=TwoWay}"
                                                        OpenEncounterCommand="{Binding OpenTimelineEncounterCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" MaxWidth="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <TextBlock Text="Sessions" FontSize="16" FontWeight="DemiBold" />
                    <Border Grid.Row="1" Background="{DynamicResource UiSurfaceBrush}" CornerRadius="6">
                        <ListBox x:Name="SessionList" Classes="ActivitySessionList" ItemsSource="{Binding PlaySessions}" SelectedItem="{Binding SelectedPlaySession, Mode=TwoWay}" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActivityPlaySessionRow">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="DemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MetadataText}" Classes="UiLabel" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetadataText}" />
                                        <WrapPanel><TextBlock Text="{Binding DurationText}" Margin="0,0,12,0" /><TextBlock Text="{Binding RunsText}" Classes="UiLabel" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Text="{Binding TagsText}" Foreground="#A0D477" Margin="0,0,12,0" /><TextBlock Text="{Binding StateText}" Classes="UiLabel" VerticalAlignment="Center" /></WrapPanel>
                                        <TextBlock Text="{Binding PartyText}" IsVisible="{Binding HasParty}" ToolTip.Tip="{Binding PartyDetailsText}" Classes="UiLabel" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <WrapPanel><Button Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreSessionsCommand}" IsVisible="{Binding HasMoreSessions}" Margin="0,0,8,6" /><Button Classes="UiAction UiSecondary" Content="{Binding DeleteButtonText}" Click="DeleteSession_Click" IsEnabled="{Binding CanDeleteSelectedSession}" Margin="0,0,0,6" /></WrapPanel>
                    </StackPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Choose a session to view its activity" IsVisible="{Binding !HasSelectedPlaySession}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Opacity="0.7" FontSize="16" Margin="20" />
                    <ScrollViewer x:Name="HistorySessionDetailScroll" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelectedPlaySession}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4"><TextBlock Text="{Binding DetailTitle}" FontSize="20" FontWeight="DemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding DetailMapMetadataText}" IsVisible="{Binding HasDetailMapMetadata}" Classes="UiLabel" /><TextBlock Text="{Binding DetailDurationText}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedPlaySession.PartyText, FallbackValue=''}" IsVisible="{Binding SelectedPlaySession.HasParty, FallbackValue=False}" ToolTip.Tip="{Binding SelectedPlaySession.PartyDetailsText, FallbackValue=''}" TextWrapping="Wrap" Foreground="{DynamicResource AFMOrange}" /><TextBlock Text="{Binding DetailScopeText}" IsVisible="{Binding DetailScopeText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Classes="UiLabel" /><TextBlock Text="{Binding DetailTagsText}" IsVisible="{Binding DetailTagsText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Foreground="#A0D477" /><TextBlock Text="{Binding ImportedDetailText}" IsVisible="{Binding IsImportedDetail}" Classes="UiLabel" ToolTip.Tip="{Binding ImportedDetailTooltipText}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="UiAction UiSecondary" Content="All runs" Command="{Binding ClearRunCommand}" IsVisible="{Binding HasSelectedSession}" />
                                <Button Classes="UiAction UiSecondary" Content="{Binding ClearSelectionText}" Command="{Binding ClearEncounterCommand}" IsVisible="{Binding HasSelectedDetailSelection}" />
                                <Button Classes="UiAction UiSecondary" Content="All players" Command="{Binding ClearPlayerCommand}" IsVisible="{Binding HasSelectedPlayer}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4" IsVisible="{Binding HasMultipleRuns}">
                            <TextBlock Text="Runs · choose one to see only that run" Classes="UiLabel" />
                            <ListBox Classes="ActivityRunChips" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Runs in this session">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivitySessionRow">
                                        <StackPanel Spacing="1" ToolTip.Tip="{Binding RunDetailsText}">
                                            <TextBlock Text="{Binding RunLabel}" FontSize="12" FontWeight="DemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RunSummaryText}" Classes="UiLabel" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <ContentControl Content="{Binding DetailSummary}" ContentTemplate="{StaticResource SummaryTemplate}" />
                        <TabControl Classes="ActivityDetails" SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}">
                            <TabItem Header="Encounters" IsEnabled="{Binding HasDetailedHistory}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <DataGrid ItemsSource="{Binding Encounters}" Height="{Binding Encounters.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}" SelectedItem="{Binding SelectedEncounter, Mode=TwoWay}" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Classification}" />
                                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" />
                                            <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" />
                                            <DataGridTextColumn Header="DPS" Binding="{Binding DamageRateText}" />
                                            <DataGridTextColumn Header="Healing" Binding="{Binding HealingText}" />
                                            <DataGridTextColumn Header="HPS" Binding="{Binding HealingRateText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="1" Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreEncountersCommand}" IsVisible="{Binding HasMoreEncounters}" HorizontalAlignment="Left" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Charts" IsEnabled="{Binding HasDetailedHistory}">
                                <StackPanel Spacing="12">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityVisibilityTemplate}" />
                                    <views:ActivityLiveTimelineView Snapshot="{Binding HistoryLiveTimeline}" ReplaySnapshot="{Binding HistoryReplayTimeline}" ReplayWindowCommand="{Binding LoadHistoryReplayCommand}" ShowReplayControls="True" ChartMode="{Binding ChartMode, Mode=TwoWay}" IsRolling="False" ShowWindowSelector="False" Title="Activity over time" OpenEncounterCommand="{Binding OpenTimelineEncounterCommand}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Players" IsEnabled="{Binding HasDetailedHistory}">
                                <DataGrid x:Name="HistoryPlayersTable" ItemsSource="{Binding Players}" Height="{Binding Players.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                        <DataGridTextColumn Header="Group" Binding="{Binding Relationship}" />
                                        <DataGridTextColumn Header="Damage dealt" Binding="{Binding DamageDealt}" />
                                        <DataGridTextColumn Header="Damage received" Binding="{Binding DamageReceived}" />
                                        <DataGridTextColumn Header="Healing done" Binding="{Binding HealingDone}" />
                                        <DataGridTextColumn Header="Healing received" Binding="{Binding HealingReceived}" />
                                        <!-- Earnings columns appear only when the session recorded them. -->
                                        <DataGridTextColumn Header="Fame" Binding="{Binding Fame}" Tag="Fame" IsVisible="False" />
                                        <DataGridTextColumn Header="Silver" Binding="{Binding Silver}" Tag="Silver" IsVisible="False" />
                                        <DataGridTextColumn Header="Loot (items)" Binding="{Binding Loot}" Tag="Loot" IsVisible="False" />
                                        <DataGridTextColumn Header="Gathered (items)" Binding="{Binding Gathered}" Tag="Gathered" IsVisible="False" />
                                        <DataGridTextColumn Header="Deaths" Binding="{Binding Deaths}" Tag="Deaths" IsVisible="False" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Killed mobs" IsEnabled="{Binding HasDetailedHistory}">
                                <DataGrid ItemsSource="{Binding Mobs}" Height="{Binding Mobs.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}">
                                    <DataGrid.Columns><DataGridTextColumn Header="Mob" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Kills" Binding="{Binding Count}" /></DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Items">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <views:ActivitySegmentedSelector ItemsSource="{Binding LootScopeOptions}" SelectedItem="{Binding SelectedSessionLootScope, Mode=TwoWay}" AutomationProperties.Name="Session item scope" />
                                        <views:ActivitySegmentedSelector ItemsSource="{Binding ItemSourceOptions}" SelectedItem="{Binding SelectedSessionItemSource, Mode=TwoWay}" AutomationProperties.Name="Session item source" />
                                    </StackPanel>
                                    <Expander Grid.Row="1" Header="Gathered" IsVisible="{Binding HasSessionResources}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{Binding SessionResources}" ItemTemplate="{StaticResource ActivityResourceTileTemplate}" Margin="8,8,8,2"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                    </Expander>
                                    <Expander Grid.Row="2" Header="Loot" IsVisible="{Binding ShowSessionLootPanel}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                    <DataGrid ItemsSource="{Binding SessionLoot}" RowHeight="56" Height="{Binding SessionLoot.Count, Converter={x:Static views:ActivityView.HistoryLootTableHeightConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" />
                                            <DataGridTemplateColumn Header="Item" Width="*" MinWidth="200" CellTemplate="{StaticResource LootItemTemplate}" />
                                            <DataGridTextColumn Header="Quantity" Binding="{Binding AmountText}" />
                                            <DataGridTextColumn Header="Estimated value" Binding="{Binding ValueText}" />
                                            <DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" MinWidth="110" />
                                            <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" />
                                            <DataGridTextColumn Header="Alliance" Binding="{Binding Alliance}" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                                            <DataGridTextColumn Header="Source guild" Binding="{Binding LootSourceGuild}" />
                                            <DataGridTextColumn Header="Source alliance" Binding="{Binding LootSourceAlliance}" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Expander>
                                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <WrapPanel>
                                            <Button Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreSessionLootCommand}" IsVisible="{Binding HasMoreSessionLoot}" Margin="0,0,8,0" />
                                            <Button x:Name="ExportSessionLootButton" Classes="UiAction UiSecondary" Content="Export loot…" IsEnabled="{Binding CanExportSessionLoot}" ToolTip.Tip="Export the loot shown here across all pages" Margin="0,0,8,0">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="AFM CSV" Tag="{x:Static vm:LootExportFormat.AfmCsv}" Click="ExportSessionLoot_Click" />
                                                        <MenuItem Header="Loot Logger Viewer (.txt)" Tag="{x:Static vm:LootExportFormat.LootLoggerViewer}" Click="ExportSessionLoot_Click" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Classes="UiAction UiSecondary" Content="Cancel export" Command="{Binding CancelLootExportCommand}" IsVisible="{Binding IsLootExporting}" Margin="0,0,8,0" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LootExportProgress}" IsIndeterminate="{Binding IsPreparingLootExport}" IsVisible="{Binding IsLootExporting}" Width="140" Height="6" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="1" Classes="UiLabel" Text="{Binding LootExportStatusText}" IsVisible="{Binding HasLootExportStatus}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Timeline" IsEnabled="{Binding HasDetailedHistory}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityVisibilityTemplate}" />
                                    <DataGrid x:Name="HistoryTimelineTable" Grid.Row="1" ItemsSource="{Binding Timeline}" Height="{Binding Timeline.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}"
                                              MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding TimeText}" /><DataGridTextColumn Header="Event" Binding="{Binding Kind}" /><DataGridTextColumn Header="Source" Binding="{Binding Source}" /><DataGridTextColumn Header="Target" Binding="{Binding Target}" /><DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" MinWidth="160" /><DataGridTextColumn Header="Location" Binding="{Binding Location}" /></DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreTimelineCommand}" IsVisible="{Binding HasMoreTimeline}" HorizontalAlignment="Left" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Maps" IsEnabled="{Binding HasDetailedHistory}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Text="Select a map to see its totals." Classes="UiLabel" />
                                    <DataGrid x:Name="HistoryMapsTable" Grid.Row="1" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap, Mode=TwoWay}" SelectionMode="Single" RowHeight="48"
                                              Height="{Binding Maps.Count, Converter={x:Static views:ActivityView.HistoryMapTableHeightConverter}}"
                                              MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Map" Width="*" MinWidth="200" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:ActivityMapRow">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="8,0" ToolTip.Tip="{Binding DetailsText}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DetailsText}" IsVisible="{Binding HasDetails}" Classes="UiLabel" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="First visit" Binding="{Binding StartedText}" />
                                            <DataGridTextColumn Header="Visits" Binding="{Binding VisitCount}" />
                                            <DataGridTextColumn Header="Recorded time" Binding="{Binding DurationText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreMapsCommand}" IsVisible="{Binding HasMoreMaps}" HorizontalAlignment="Left" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Party" IsEnabled="{Binding HasDetailedHistory}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="No party members were recorded in this session." IsVisible="{Binding !HasPartyHistory}" Classes="UiLabel" />
                                    <TextBlock Text="{Binding PartyHistory.SummaryText}" IsVisible="{Binding HasPartyHistory}" Classes="UiLabel" />
                                    <DataGrid ItemsSource="{Binding PartyHistory.Members}" IsVisible="{Binding HasPartyHistory}" Height="{Binding PartyHistory.MemberCount, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Member" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                            <DataGridTextColumn Header="Joined" Binding="{Binding JoinedText}" />
                                            <DataGridTextColumn Header="Left" Binding="{Binding LeftText}" />
                                            <DataGridTextColumn Header="Time in party" Binding="{Binding DurationText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Spacing="6" IsVisible="{Binding HasPartyChanges}">
                                        <TextBlock Text="Changes" Classes="UiSectionTitle" />
                                        <DataGrid ItemsSource="{Binding PartyHistory.Changes}" Height="{Binding PartyHistory.ChangeCount, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" />
                                                <DataGridTemplateColumn Header="Change">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityPartyChangeRow">
                                                            <TextBlock Text="{Binding Change}" Classes="PartyChange" Classes.Joined="{Binding Joined}" VerticalAlignment="Center" Margin="12,0" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Members" Width="*" MinWidth="160">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityPartyChangeRow">
                                                            <TextBlock Text="{Binding Player}" ToolTip.Tip="{Binding PlayerDetails}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Party size" Binding="{Binding PartySizeText}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Items">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,8,12,8">
                    <StackPanel Spacing="4">
                        <WrapPanel>
                            <views:ActivitySegmentedSelector ItemsSource="{Binding LootScopeOptions}" SelectedItem="{Binding SelectedLootScope, Mode=TwoWay}" AutomationProperties.Name="Item scope" Margin="0,0,12,0" />
                            <views:ActivitySegmentedSelector ItemsSource="{Binding ItemSourceOptions}" SelectedItem="{Binding SelectedItemSource, Mode=TwoWay}" AutomationProperties.Name="Item source" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,-4">
                            <TextBox Text="{Binding LootSearch}" Watermark="Search item, player, or source" Width="270" Margin="0,0,10,4" />
                            <Button Classes="UiAction" Content="Search" Command="{Binding ApplyLootFiltersCommand}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                    <Expander Header="Gathered" IsVisible="{Binding HasGlobalResources}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                        <ScrollViewer MaxHeight="108" HorizontalScrollBarVisibility="Disabled" Margin="8,8,8,2"><ItemsControl ItemsSource="{Binding GlobalResources}" ItemTemplate="{StaticResource ActivityResourceTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
                                    </Expander>
                    <Expander Header="Loot" IsVisible="{Binding ShowGlobalLootPanel}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                    <DataGrid ItemsSource="{Binding GlobalLoot}" RowHeight="56" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding DateTimeText}" />
                            <DataGridTemplateColumn Header="Item" Width="*" MinWidth="220" CellTemplate="{StaticResource LootTemplate}" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding AmountText}" />
                            <DataGridTextColumn Header="Estimated value" Binding="{Binding ValueText}" />
                            <DataGridTemplateColumn Header="Recipient" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ActivityLootRow"><TextBlock Text="{Binding Recipient}" ToolTip.Tip="{Binding RecipientDetails}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" />
                            <DataGridTextColumn Header="Alliance" Binding="{Binding Alliance}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="Source guild" Binding="{Binding LootSourceGuild}" />
                            <DataGridTextColumn Header="Source alliance" Binding="{Binding LootSourceAlliance}" />
                            <DataGridTemplateColumn Header="Location" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ActivityLootRow"><TextBlock Text="{Binding Location}" ToolTip.Tip="{Binding ContextDetails}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Expander>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding GlobalLootTotalsText}" FontWeight="DemiBold" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="{Binding GlobalLootDetailsText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="UiAction UiSecondary" Content="Load more" Command="{Binding LoadMoreGlobalLootCommand}" IsVisible="{Binding HasMoreGlobalLoot}" />
                            <Button Classes="UiAction UiSecondary" Content="Export loot…" IsEnabled="{Binding CanStartLootExport}" IsVisible="{Binding ShowGlobalLootPanel}" ToolTip.Tip="Export the loot shown here across all pages">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="AFM CSV" Tag="{x:Static vm:LootExportFormat.AfmCsv}" Click="ExportGlobalLoot_Click" />
                                        <MenuItem Header="Loot Logger Viewer (.txt)" Tag="{x:Static vm:LootExportFormat.LootLoggerViewer}" Click="ExportGlobalLoot_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="UiAction UiSecondary" Content="Cancel export" Command="{Binding CancelLootExportCommand}" IsVisible="{Binding IsLootExporting}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LootExportProgress}" IsIndeterminate="{Binding IsPreparingLootExport}" IsVisible="{Binding IsLootExporting}" Width="140" Height="6" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="UiLabel" Text="{Binding LootExportStatusText}" IsVisible="{Binding HasLootExportStatus}" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Cleanup">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,8,12,8" MaxWidth="1000" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4"><TextBlock Text="Stored activity" FontSize="20" FontWeight="DemiBold" /><TextBlock Text="All characters and servers" Classes="UiLabel" /></StackPanel>
                            <Button Grid.Column="1" Classes="UiAction UiSecondary" Content="Refresh" Command="{Binding RefreshCleanupCommand}" IsEnabled="{Binding !IsCleanupBusy}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                            <Border Classes="UiCard ActivityMetricCard"><StackPanel><TextBlock Classes="UiLabel" Text="Activity storage" /><TextBlock Classes="ActivityValue" Text="{Binding CleanupActivitySizeText}" /><TextBlock Classes="UiLabel" Text="Includes history and items" /></StackPanel></Border>
                            <Border Grid.Column="1" Classes="UiCard ActivityMetricCard"><StackPanel><TextBlock Classes="UiLabel" Text="Sessions" /><TextBlock Classes="ActivityValue" Text="{Binding CleanupSessionsText}" /></StackPanel></Border>
                            <Border Grid.Column="2" Classes="UiCard ActivityMetricCard"><StackPanel><TextBlock Classes="UiLabel" Text="Encounters" /><TextBlock Classes="ActivityValue" Text="{Binding CleanupEncountersText}" /></StackPanel></Border>
                            <Border Grid.Row="1" Classes="UiCard ActivityMetricCard"><StackPanel><TextBlock Classes="UiLabel" Text="Whole local database" /><TextBlock Classes="ActivityValue" Text="{Binding CleanupDatabaseSizeText}" /><TextBlock Classes="UiLabel" Text="Includes other app data" /></StackPanel></Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="UiCard ActivityMetricCard"><StackPanel><TextBlock Classes="UiLabel" Text="Events" /><TextBlock Classes="ActivityValue" Text="{Binding CleanupEventsText}" /></StackPanel></Border>
                            <Border Grid.Row="1" Grid.Column="2" Classes="UiCard ActivityMetricCard"><StackPanel><TextBlock Classes="UiLabel" Text="Item pickups" /><TextBlock Classes="ActivityValue" Text="{Binding CleanupItemsText}" /></StackPanel></Border>
                        </Grid>
                        <Border Classes="UiCard" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Clean up history" FontSize="18" FontWeight="DemiBold" />
                                <WrapPanel>
                                    <CheckBox Content="Remove activity older than" IsChecked="{Binding CleanupDeleteOld, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <NumericUpDown Value="{Binding CleanupOlderThanDays, Mode=TwoWay}" Minimum="1" Maximum="36500" FormatString="0" Width="110" Height="32" Background="{DynamicResource UiInputBrush}" IsEnabled="{Binding CleanupDeleteOld}" />
                                    <TextBlock Text="days" Classes="UiLabel" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </WrapPanel>
                                <CheckBox Content="Remove loot picked up by others outside your party" IsChecked="{Binding CleanupDeleteOutsidePartyLoot, Mode=TwoWay}" />
                                <TextBlock Text="Current sessions and original gathering records are kept." Classes="UiLabel" />
                                <WrapPanel>
                                    <Button Classes="UiAction UiSecondary" Content="Preview cleanup" Command="{Binding PreviewCleanupCommand}" IsEnabled="{Binding CanPreviewCleanup}" Margin="0,0,8,4" />
                                    <Button Classes="UiAction" Content="Delete matching data…" Click="CleanupActivity_Click" IsEnabled="{Binding CanApplyCleanup}" Margin="0,0,0,4" />
                                </WrapPanel>
                                <TextBlock Text="{Binding CleanupPreviewText}" IsVisible="{Binding HasCleanupPreview}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CleanupStatusText}" Classes="UiLabel" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <WrapPanel><Button Classes="UiAction UiSecondary" Content="Delete loot outside sessions…" Click="DeleteUnassignedLoot_Click" /></WrapPanel>
                        <TextBlock Text="Removed data cannot be restored here. Storage is reused for new activity; the database file may stay the same size." Classes="UiLabel" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
