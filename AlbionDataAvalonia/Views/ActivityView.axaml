<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
        xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="AlbionDataAvalonia.Views.ActivityView"
             x:DataType="vm:ActivityViewModel" Classes="AppPage">
    <UserControl.Resources>
        <StreamGeometry x:Key="ActivityPartyIcon">M6,2.5 A2.5,2.5 0 1 0 6,7.5 A2.5,2.5 0 1 0 6,2.5 Z M1,14 C1,10.5 3,9 6,9 C9,9 11,10.5 11,14 Z M11.5,2.5 A2,2 0 1 0 11.5,6.5 A2,2 0 1 0 11.5,2.5 Z M12,8.5 C14,8.7 15.5,10 15.5,13 L12.3,13 C12.1,11 11.5,9.6 10.6,8.9 C11,8.6 11.5,8.5 12,8.5 Z</StreamGeometry>
        <DataTemplate x:Key="KillSummaryTemplate" x:DataType="vm:ActivitySummaryPresentation">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding OutcomesDetailsText}">
                <TextBlock Classes="UiLabel" Text="Mob kills" />
                <TextBlock Grid.Column="1" Classes="UiLabel" Text="{Binding PlayerKillsLabel}" />
                <TextBlock Grid.Row="1" Classes="UiValue" Margin="0,2" Text="{Binding MobKills}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="UiValue" Margin="0,2" Text="{Binding PlayerKills}" Foreground="{DynamicResource UiActivityKillBrush}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="UiLabel" Text="{Binding DeathsAndKnockdowns}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SummaryTemplate" x:DataType="vm:ActivitySummaryPresentation">
            <StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,0,0,6" ToolTip.Tip="{Binding TotalSilverDetailsText}">
                <controls:StatTile Classes="Card Outlined Large Accent Compact" MinHeight="64" Label="Total silver" Value="{Binding TotalSilver}" />
                <controls:StatTile Grid.Column="1" Classes="Card Outlined Large Accent Compact" MinHeight="64" Label="Total silver / hour" Value="{Binding TotalSilverPerHour}"
                                   Detail="{Binding TotalSilverPerRunHourText}" />
            </Grid>
            <views:ResponsiveUniformGrid IsVisible="{Binding !IsImported}" MaximumColumns="4" MinimumItemWidth="156" Margin="-3">
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Damage dealt" Value="{Binding DamageDealt}" Detail="{Binding DamageRate}" />
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Damage received" Value="{Binding DamageReceived}" Detail="{Binding DamageReceivedRate}" />
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Healing done" Value="{Binding HealingDone}" Detail="{Binding HealingRate}" />
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Healing received" Value="{Binding HealingReceived}" Detail="{Binding HealingReceivedRate}" />
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Combat fame" Value="{Binding CombatFame}" Detail="{Binding CombatFameFooterText}" ToolTip.Tip="{Binding CombatFameDetailsText}" />
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Silver picked up" Value="{Binding Silver}" Detail="{Binding SilverFooterText}" ToolTip.Tip="{Binding SilverDetailsText}" />
                <controls:StatTile Classes="Card Compact" Height="76" Margin="3" Label="Loot EMV" Value="{Binding LootValue}" Detail="{Binding ItemsFooterText}" ToolTip.Tip="{Binding ItemsDetailsText}" />
                <Border Classes="UiCard" Height="76" Margin="3" Padding="10,8"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource KillSummaryTemplate}" /></Border>
                </views:ResponsiveUniformGrid>
                <Border IsVisible="{Binding !IsImported}" Margin="0,6,0,0" Classes="UiCard" Padding="10,8" ToolTip.Tip="{Binding ResourceValueDetailsText}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,0"><TextBlock Classes="UiSectionTitle" Text="{Binding ResourceItemsText}" /><TextBlock Classes="UiLabel" Text="{Binding ResourceBreakdownText}" /></StackPanel>
                        <StackPanel Margin="0,0,20,0"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="UiLabel" Text="Gathering EMV" VerticalAlignment="Center" /><TextBlock Classes="UiSectionTitle" Text="{Binding ResourceValueText}" /></StackPanel><TextBlock Classes="UiLabel" Text="{Binding ResourceRateText}" /></StackPanel>
                        <StackPanel Margin="0,0,20,0" ToolTip.Tip="{Binding GatheringFameDetailsText}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="UiLabel" Text="Gathering fame" VerticalAlignment="Center" /><TextBlock Classes="UiSectionTitle" Text="{Binding GatheringFame}" /></StackPanel><TextBlock Classes="UiLabel" Text="{Binding GatheringFameRate}" IsVisible="{Binding IsSessionAverage}" /></StackPanel>
                    </WrapPanel>
                </Border>
            <TextBlock Classes="UiLabel" Text="{Binding UnknownFameText}" IsVisible="{Binding HasUnknownFame}" Margin="0,6,0,0" ToolTip.Tip="Fame without a known activity" />
            <Grid IsVisible="{Binding IsImported}" ColumnDefinitions="*,*" ColumnSpacing="6">
                <controls:StatTile Classes="Card Compact" Height="76" Label="Items gathered" Value="{Binding ResourceQuantityText}" Detail="{Binding ResourceBreakdownText}" ToolTip.Tip="{Binding ResourceBreakdownText}" />
                <controls:StatTile Grid.Column="1" Classes="Card Compact" Height="76" Label="Gathering EMV" Value="{Binding ResourceValueText}" Detail="{Binding ResourceRateText}" ToolTip.Tip="{Binding ResourceValueDetailsText}" />
            </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LootTemplate" x:DataType="vm:ActivityLootRow">
            <controls:ItemCell Classes="Compact" IconSize="28" ItemUniqueName="{Binding ItemUniqueName}" ImageQuality="{Binding ImageQuality}" Title="{Binding ItemName}" Subtitle="{Binding Quality}"
                               ToolTip.Tip="{Binding ItemTip}" />
        </DataTemplate>
        <!-- History rows show the same item without hover details. -->
        <DataTemplate x:Key="LootItemTemplate" x:DataType="vm:ActivityLootRow">
            <controls:ItemCell Classes="Compact" IconSize="28" ItemUniqueName="{Binding ItemUniqueName}" ImageQuality="{Binding ImageQuality}" Title="{Binding ItemName}" Subtitle="{Binding Quality}" />
        </DataTemplate>
        <!-- A killed mob as a tile beside the gathered ones: its portrait, name and kills. -->
        <DataTemplate x:Key="ActivityMobTileTemplate" x:DataType="vm:ActivityMobRow">
            <Border Width="230" Padding="8,6" Margin="0,0,6,6" CornerRadius="{DynamicResource UiRadiusControl}" Background="{DynamicResource UiInputBrush}">
                <controls:MobCell MobUniqueName="{Binding MobUniqueName}" IconSize="40" Title="{Binding Name}" Subtitle="{Binding KillsText}" ToolTip.Tip="{Binding Tip}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActivityVisibilityTemplate" x:DataType="vm:ActivityFilterState">
            <!-- Several kinds can be on at once; All turns the others off. The negative margin drops the last row's gap. -->
            <WrapPanel Margin="0,0,0,-4">
                <TextBlock Text="Show" Classes="UiLabel" VerticalAlignment="Center" Margin="0,0,12,4" />
                <ToggleButton Theme="{StaticResource UiToggleChip}" Content="All" IsChecked="{Binding ShowAllActivities, Mode=TwoWay}" />
                <ToggleButton Theme="{StaticResource UiToggleChip}" Content="Gathering" IsChecked="{Binding ShowGathering, Mode=TwoWay}" />
                <ToggleButton Theme="{StaticResource UiToggleChip}" Content="Fishing" IsChecked="{Binding ShowFishing, Mode=TwoWay}" />
                <ToggleButton Theme="{StaticResource UiToggleChip}" Content="PvE" IsChecked="{Binding ShowPve, Mode=TwoWay}" />
                <ToggleButton Theme="{StaticResource UiToggleChip}" Content="PvP" IsChecked="{Binding ShowPvp, Mode=TwoWay}" />
                <ToggleButton Theme="{StaticResource UiToggleChip}" Content="Other" IsChecked="{Binding ShowOther, Mode=TwoWay}" />
            </WrapPanel>
        </DataTemplate>
        <DataTemplate x:Key="ActivityResourceTileTemplate" x:DataType="vm:ActivityResourceRow">
            <Border Width="230" Padding="8" Margin="0,0,6,6" CornerRadius="{DynamicResource UiRadiusControl}" Background="{DynamicResource UiInputBrush}" ToolTip.Tip="{Binding Tip}">
                <Grid ColumnDefinitions="32,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                    <Image Grid.RowSpan="2" Width="32" Height="32" Stretch="Uniform" items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}" items:LazyItemImage.Quality="{Binding ImageQuality}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding ItemName}" FontSize="{DynamicResource UiFontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"><TextBlock Text="×" FontSize="{DynamicResource UiFontSizeSmall}" /><TextBlock Text="{Binding QuantityText}" FontSize="{DynamicResource UiFontSizeCompact}" FontWeight="SemiBold" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                        <TextBlock Classes="UiFine" Text="{Binding ValueLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="{DynamicResource UiFontSizeCompact}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="UiWarning" Text="*" IsVisible="{Binding HasMissingPrices}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.DataTemplates>
        <!-- Hover cards for items and mobs: the image larger than the row shows it, like the chart and map tooltips. -->
        <DataTemplate DataType="vm:ActivityTip" x:DataType="vm:ActivityTip">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaxWidth="360">
                <Image Width="56" Height="56" Stretch="Uniform" IsVisible="{Binding IsItem}" VerticalAlignment="Top"
                       items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}" items:LazyItemImage.Quality="{Binding Quality}" />
                <Image Width="64" Height="64" Stretch="Uniform" IsVisible="{Binding IsMob}" VerticalAlignment="Top" items:LazyMobImage.MobUniqueName="{Binding Mob}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="UiLabel" Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <!-- The session list and party changes appear only here. -->
    <UserControl.Styles>
        <Style Selector="ListBox.ActivitySessionList"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="ListBox.ActivitySessionList ListBoxItem"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
        <Style Selector="ListBox.ActivitySessionList ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource UiInputBrush}" /></Style>
        <Style Selector="ListBox.ActivitySessionList ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource UiSelectedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentTextBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /></Style>
        <Style Selector="TextBlock.PartyChange"><Setter Property="Foreground" Value="{DynamicResource UiNegativeTextBrush}" /></Style>
        <Style Selector="TextBlock.PartyChange.Joined"><Setter Property="Foreground" Value="{DynamicResource UiPositiveTextBrush}" /></Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0" RowSpacing="12">
        <StackPanel Spacing="8">
            <!-- Toolbar: recording state and scope on the left, actions on the right. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <WrapPanel VerticalAlignment="Center">
                    <Border Classes="UiChip" Margin="0,0,12,4" VerticalAlignment="Center" ToolTip.Tip="Recording status">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Classes="UiStatusDot" Classes.Ok="{Binding IsStatusRecording}" Classes.Busy="{Binding IsStatusWaiting}" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>
                    </Border>
                    <controls:SegmentedSelector ItemsSource="{Binding Filters.ScopeOptions}" SelectedItem="{Binding Filters.SelectedScope, Mode=TwoWay}" IsVisible="{Binding ShowActivityScope}"
                                                AutomationProperties.Name="Activity scope" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="UiAction" Content="{Binding StreamerWindowButtonText}" Command="{Binding ToggleStreamerWindowCommand}" IsVisible="{Binding CanOpenStreamerWindow}"
                            ToolTip.Tip="Compact window for streaming. Set it up in Settings › Streamer." Margin="10,0,0,4" />
                    <Button Classes="UiAction" Content="{Binding MapWindowButtonText}" Command="{Binding ToggleMapWindowCommand}" IsVisible="{Binding CanOpenMapWindow}"
                            ToolTip.Tip="Live map of your current zone with your path and events, and a replay of past runs." Margin="10,0,0,4" />
                    <Button Classes="UiAction" Content="{Binding RecordingButtonText}" Command="{Binding ToggleRecordingCommand}" Margin="10,0,0,4" />
                    <Button Classes="UiAction" Content="Start session" Command="{Binding StartSessionCommand}" IsEnabled="{Binding CanStartSession}"
                            IsVisible="{Binding !Current.HasCurrentPlaySession}" Margin="10,0,0,4"
                            ToolTip.Tip="Starts a session now, before your first activity. It ends after 30 minutes without activity or when you press End session." />
                    <Button Classes="UiAction" Content="End session…" Command="{Binding EndSessionCommand}" IsVisible="{Binding Current.HasCurrentPlaySession}" Margin="10,0,0,4"
                            ToolTip.Tip="Ends the session now. Your next activity starts a new session." />
                </WrapPanel>
            </Grid>
            <TextBlock Classes="UiWarning" Text="{Binding LegacyImportWarningText}" IsVisible="{Binding HasLegacyImportWarning}" TextWrapping="Wrap" />
            <TextBlock Classes="UiError" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Current">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Current}" x:DataType="vm:ActivityCurrentViewModel">
                    <StackPanel Spacing="12" Margin="0,8,12,8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="UiHeading" Text="{Binding CurrentTitle}" />
                                    <TextBlock Classes="UiMuted" Text="{Binding CurrentDescription}" IsVisible="{Binding CurrentDescription, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="UiAction" Content="View session" Command="{Binding OpenCurrentSessionCommand}" IsEnabled="{Binding HasCurrentPlaySession}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,0,0,-4">
                                <controls:SegmentedSelector ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" AutomationProperties.Name="Current totals period" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsLastHoursPeriod}" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding LastHours, Mode=TwoWay}" Minimum="1" Maximum="168" Increment="1" FormatString="0" Width="124" Height="32" Background="{DynamicResource UiInputBrush}" BorderBrush="{DynamicResource UiBorderBrush}" ToolTip.Tip="Show activity from the last 1–168 hours" />
                                    <TextBlock Text="hours" Classes="UiLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CurrentPeriodDescription}" MinHeight="16" Classes="UiLabel" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <WrapPanel ToolTip.Tip="{Binding CurrentPeriodWarning}" Margin="0,0,0,-4">
                                        <TextBlock Text="{Binding CurrentDurationText}" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding CurrentRunTimeText}" IsVisible="{Binding HasCurrentRunTime}" Margin="0,0,18,4" ToolTip.Tip="Time in runs only" />
                                        <TextBlock Text="{Binding CurrentCombatDurationText}" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding CurrentTagsText}" Foreground="{DynamicResource UiPositiveTextBrush}" Margin="0,0,18,4" IsVisible="{Binding CurrentTagsText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding CurrentStateText}" IsVisible="{Binding HasCurrentState}" Foreground="{DynamicResource UiAccentTextBrush}" Margin="0,0,0,4"
                                                   ToolTip.Tip="Gaps under 30 minutes count" />
                                    </WrapPanel>
                                    <Button Grid.Column="1" Classes="UiChipButton" CornerRadius="{DynamicResource UiRadiusPill}" MinHeight="28" IsVisible="{Binding HasCurrentParty}" ToolTip.Tip="{Binding CurrentPartyDetailsText}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" AutomationProperties.Name="Current party">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource ActivityPartyIcon}" Width="14" Height="14" Foreground="{DynamicResource UiAccentTextBrush}" />
                                            <TextBlock Text="{Binding CurrentPartyText}" FontWeight="SemiBold" Foreground="{DynamicResource UiAccentTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Classes="UiMuted" Text="{Binding CurrentPartyPreviewText}" IsVisible="{Binding HasCurrentPartyPreview}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Width="340" Spacing="10">
                                                    <TextBlock Classes="UiSectionTitle" Text="{Binding CurrentPartyHeaderText}" />
                                                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding CurrentPartyMembers}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ActivityPartyMemberChip">
                                                                    <Border Classes="UiChip" Classes.Selected="{Binding IsYou}" Margin="0,0,4,4">
                                                                        <TextBlock Text="{Binding Name}" MaxWidth="150" ToolTip.Tip="{Binding Name}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <StackPanel Spacing="4" IsVisible="{Binding HasCurrentPartyChanges}">
                                                        <TextBlock Text="Recent changes" Classes="UiLabel" />
                                                        <ItemsControl ItemsSource="{Binding CurrentPartyChanges}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ActivityPartyChangeRow">
                                                                    <Grid ColumnDefinitions="64,52,*,Auto" ColumnSpacing="6" Margin="0,1">
                                                                        <TextBlock Text="{Binding TimeText}" Classes="UiLabel" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Change}" Classes="PartyChange" Classes.Joined="{Binding Joined}" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Player}" ToolTip.Tip="{Binding PlayerDetails}" FontSize="{DynamicResource UiFontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding PartySizeText}" Classes="UiLabel" VerticalAlignment="Center" ToolTip.Tip="Party size after the change" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <TextBlock Text="Joins and departures are saved with the session. See History → Party for the full timeline." Classes="UiLabel" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding ShowCurrentRuns}">
                                <TextBlock Text="Runs in this session" Classes="UiLabel" />
                                <ItemsControl ItemsSource="{Binding CurrentRuns}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivitySessionRow">
                                            <Button Classes="UiChipButton" Classes.Accent="{Binding IsLive}" Margin="0,0,6,6" ToolTip.Tip="{Binding RunDetailsText}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ActivityCurrentViewModel)DataContext).OpenRunRowCommand}" CommandParameter="{Binding}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding RunLabel}" FontSize="{DynamicResource UiFontSizeSmall}" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding RunSummaryText}" Classes="UiLabel" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding CurrentSummary}" ContentTemplate="{StaticResource SummaryTemplate}" />
                        <Expander Header="Gathered" IsExpanded="False" HorizontalAlignment="Stretch" Padding="0">
                            <StackPanel Margin="8,8,8,2"><controls:EmptyState Classes="Inline" Message="No items gathered yet." IsVisible="{Binding !HasCurrentResources}" Margin="4,4,4,8" /><ScrollViewer MaxHeight="144" HorizontalScrollBarVisibility="Disabled"><ItemsRepeater ItemsSource="{Binding CurrentResources}" ItemTemplate="{StaticResource ActivityResourceTileTemplate}"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="236" MinItemHeight="56" ItemsStretch="None" /></ItemsRepeater.Layout></ItemsRepeater></ScrollViewer></StackPanel>
                        </Expander>
                        <Expander Header="Killed mobs" IsExpanded="{Binding IsCurrentMobsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0">
                            <StackPanel Margin="8,8,8,2"><controls:EmptyState Classes="Inline" Message="No mobs killed yet." IsVisible="{Binding !HasCurrentMobs}" Margin="4,4,4,8" /><ScrollViewer MaxHeight="144" HorizontalScrollBarVisibility="Disabled"><ItemsRepeater ItemsSource="{Binding CurrentMobs}" ItemTemplate="{StaticResource ActivityMobTileTemplate}"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="236" MinItemHeight="58" ItemsStretch="None" /></ItemsRepeater.Layout></ItemsRepeater></ScrollViewer></StackPanel>
                        </Expander>
                        <Expander x:Name="CurrentLootPanel" Header="Loot" IsExpanded="{Binding IsCurrentLootExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0">
                            <StackPanel Margin="8,8,8,2" Spacing="8">
                                <controls:EmptyState Classes="Inline" Message="No loot picked up yet." IsVisible="{Binding !HasCurrentLoot}" Margin="4,4,4,8" />
                                <DataGrid ItemsSource="{Binding CurrentLoot}" Classes="Compact" RowHeight="40" IsVisible="{Binding HasCurrentLoot}" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" />
                                        <DataGridTemplateColumn Header="Item" Width="*" MinWidth="200" CellTemplate="{StaticResource LootTemplate}" />
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding AmountText}" />
                                        <DataGridTextColumn Header="EMV" Binding="{Binding ValueText}" />
                                        <DataGridTemplateColumn Header="Recipient" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ActivityLootRow">
                                                    <TextBlock Text="{Binding Recipient}" ToolTip.Tip="{Binding RecipientDetails}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" />
                                        <DataGridTextColumn Header="Alliance" Binding="{Binding Alliance}" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                                        <DataGridTextColumn Header="Source guild" Binding="{Binding LootSourceGuild}" />
                                        <DataGridTextColumn Header="Source alliance" Binding="{Binding LootSourceAlliance}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="4,0,4,6" IsVisible="{Binding HasCurrentLoot}">
                                    <TextBlock Text="{Binding CurrentSummary.LootItemsText}" Classes="UiLabel" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="Loot EMV" Classes="UiLabel" />
                                        <TextBlock Text="{Binding CurrentSummary.LootValue}" FontWeight="SemiBold" />
                                        <TextBlock Text="silver" Classes="UiLabel" />
                                    </StackPanel>
                                    <Button Classes="UiAction" Content="Load more" Command="{Binding LoadMoreCurrentLootCommand}" IsVisible="{Binding HasMoreCurrentLoot}" Margin="0,0,8,0" />
                                    <views:ActivityLootExportBar Export="{Binding Export}" ExportCommand="{Binding ExportCurrentLootCommand}" CanExport="{Binding Export.CanStart}" />
                                </WrapPanel>
                                <TextBlock Classes="UiLabel" Text="{Binding Export.StatusText}" IsVisible="{Binding Export.HasStatus}" TextWrapping="Wrap" Margin="4,0,4,6" />
                            </StackPanel>
                        </Expander>
                        <ContentControl Content="{Binding Filters}" ContentTemplate="{StaticResource ActivityVisibilityTemplate}" />
                        <views:ActivityLiveTimelineView ChartMode="{Binding Filters.ChartMode, Mode=TwoWay}" Snapshot="{Binding CurrentLiveTimeline}" WindowMinutes="{Binding LiveTimelineMinutes, Mode=TwoWay}"
                                                        OpenEncounterCommand="{Binding OpenTimelineEncounterCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="0,8,0,0" DataContext="{Binding History}" x:DataType="vm:ActivityHistoryViewModel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" MaxWidth="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="UiSectionTitle" Text="Sessions" />
                        <TextBlock Grid.Column="1" Classes="UiLabel" Text="{Binding CombineHintText}" VerticalAlignment="Center"
                                   ToolTip.Tip="Select several sessions to see their combined totals. Shift+click selects a range." />
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource UiSurfaceBrush}" CornerRadius="6">
                        <!-- Ctrl and Shift add sessions; code-behind hands the whole selection to the view model. -->
                        <ListBox x:Name="SessionList" Classes="ActivitySessionList" ItemsSource="{Binding PlaySessions}" SelectedItem="{Binding SelectedPlaySession, Mode=OneWay}"
                                 SelectionMode="Multiple" SelectionChanged="SessionList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActivityPlaySessionRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                        <TextBlock Classes="UiRowTitle" Text="{Binding Title}" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Grid.Column="1" Classes="UiLabel" Classes.UiAccent="{Binding IsOpen}" Text="{Binding WhenText}" TextWrapping="NoWrap"
                                                   ToolTip.Tip="{Binding WhenDetailsText}" Margin="0,1,0,0" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DurationText}" />
                                            <TextBlock Text="{Binding RunsText}" IsVisible="{Binding HasSeveralRuns}" Classes="UiLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalSilverText}" IsVisible="{Binding HasTotalSilver}" Classes="UiAccent" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" ToolTip.Tip="Total silver: silver + loot EMV + gathering EMV" />
                                        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding HasFooter}">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding TagsText}" Classes="UiLabel" Foreground="{DynamicResource UiPositiveTextBrush}" TextWrapping="NoWrap" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding DetailsText}" IsVisible="{Binding HasDetails}" ToolTip.Tip="{Binding PartyDetailsText}"
                                                       Classes="UiLabel" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <WrapPanel><Button Classes="UiAction" Content="Load more" Command="{Binding LoadMoreSessionsCommand}" IsVisible="{Binding HasMoreSessions}" Margin="0,0,8,6" /><Button Classes="UiAction UiDanger" Content="{Binding Detail.DeleteButtonText}" Command="{Binding DeleteSessionCommand}" IsEnabled="{Binding Detail.CanDelete}" Margin="0,0,0,6" /></WrapPanel>
                    </StackPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" />
                    <controls:EmptyState Grid.Column="2" Message="Choose a session to view its activity." IsVisible="{Binding !HasSelectedPlaySession}" />
                    <ScrollViewer x:Name="HistorySessionDetailScroll" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelectedPlaySession}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4"><TextBlock Classes="UiHeading" Text="{Binding Detail.Title}" /><TextBlock Text="{Binding Detail.MapMetadataText}" IsVisible="{Binding Detail.HasMapMetadata}" Classes="UiLabel" /><TextBlock Text="{Binding Detail.SelectionText}" IsVisible="{Binding Detail.HasSelectionText}" Classes="UiLabel" /><TextBlock Text="{Binding Detail.DurationText}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail.PartyText}" IsVisible="{Binding Detail.HasParty}" ToolTip.Tip="{Binding Detail.PartyDetailsText}" TextWrapping="Wrap" Foreground="{DynamicResource UiAccentTextBrush}" /><TextBlock Text="{Binding Detail.ScopeText}" IsVisible="{Binding Detail.ScopeText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Classes="UiLabel" /><TextBlock Text="{Binding Detail.TagsText}" IsVisible="{Binding Detail.TagsText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource UiPositiveTextBrush}" /><TextBlock Text="{Binding Detail.ImportedText}" IsVisible="{Binding Detail.IsImported}" Classes="UiLabel" ToolTip.Tip="{Binding Detail.ImportedTooltipText}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="UiAction" Content="Show on map" Command="{Binding ShowRunOnMapCommand}" IsVisible="{Binding Detail.CanShowOnMap}"
                                        ToolTip.Tip="Replay this run's path and events on the map" />
                                <Button Classes="UiAction" Content="All runs" Command="{Binding ClearRunCommand}" IsVisible="{Binding Detail.HasRun}" />
                                <Button Classes="UiAction" Content="{Binding Detail.ClearSelectionText}" Command="{Binding ClearEncounterCommand}" IsVisible="{Binding Detail.HasEncounterOrMap}" />
                                <Button Classes="UiAction" Content="All players" Command="{Binding ClearPlayerCommand}" IsVisible="{Binding Detail.HasPlayer}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4" IsVisible="{Binding Detail.HasMultipleRuns}">
                            <TextBlock Text="Runs · choose one to see only that run" Classes="UiLabel" />
                            <ListBox Classes="UiChipList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Runs in this session">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivitySessionRow">
                                        <StackPanel Spacing="1" ToolTip.Tip="{Binding RunDetailsText}">
                                            <TextBlock Text="{Binding RunLabel}" FontSize="{DynamicResource UiFontSizeSmall}" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RunSummaryText}" Classes="UiLabel" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <ContentControl Content="{Binding DetailSummary}" ContentTemplate="{StaticResource SummaryTemplate}" />
                        <TabControl SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}">
                            <TabItem Header="Encounters" IsEnabled="{Binding Detail.HasDetailedHistory}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <DataGrid ItemsSource="{Binding Encounters}" Height="{Binding Encounters.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}" MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedEncounter, Mode=TwoWay}" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Classification}" />
                                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" />
                                            <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" />
                                            <DataGridTextColumn Header="DPS" Binding="{Binding DamageRateText}" />
                                            <DataGridTextColumn Header="Healing" Binding="{Binding HealingText}" />
                                            <DataGridTextColumn Header="HPS" Binding="{Binding HealingRateText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="1" Classes="UiAction" Content="Load more" Command="{Binding LoadMoreEncountersCommand}" IsVisible="{Binding HasMoreEncounters}" HorizontalAlignment="Left" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Charts" IsEnabled="{Binding Detail.HasCharts}" ToolTip.ShowOnDisabled="True"
                                     ToolTip.Tip="{Binding Detail.ChartsTip}">
                                <StackPanel Spacing="12">
                                    <ContentControl Content="{Binding Filters}" ContentTemplate="{StaticResource ActivityVisibilityTemplate}" />
                                    <views:ActivityLiveTimelineView Snapshot="{Binding HistoryLiveTimeline}" ReplaySnapshot="{Binding HistoryReplayTimeline}" ReplayWindowCommand="{Binding LoadHistoryReplayCommand}" ShowReplayControls="True" ChartMode="{Binding Filters.ChartMode, Mode=TwoWay}" IsRolling="False" ShowWindowSelector="False" Title="Activity over time" OpenEncounterCommand="{Binding OpenTimelineEncounterCommand}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Players" IsEnabled="{Binding Detail.HasDetailedHistory}">
                                <DataGrid x:Name="HistoryPlayersTable" ItemsSource="{Binding Players}" Height="{Binding Players.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}" MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                        <DataGridTextColumn Header="Group" Binding="{Binding Relationship}" />
                                        <DataGridTextColumn Header="Damage dealt" Binding="{Binding DamageDealt}" />
                                        <DataGridTextColumn Header="Damage received" Binding="{Binding DamageReceived}" />
                                        <DataGridTextColumn Header="Healing done" Binding="{Binding HealingDone}" />
                                        <DataGridTextColumn Header="Healing received" Binding="{Binding HealingReceived}" />
                                        <!-- Earnings columns appear only when the session recorded them. -->
                                        <DataGridTextColumn Header="Fame" Binding="{Binding Fame}" Tag="Fame" IsVisible="False" />
                                        <DataGridTextColumn Header="Silver" Binding="{Binding Silver}" Tag="Silver" IsVisible="False" />
                                        <DataGridTextColumn Header="Loot (items)" Binding="{Binding Loot}" Tag="Loot" IsVisible="False" />
                                        <DataGridTextColumn Header="Gathered (items)" Binding="{Binding Gathered}" Tag="Gathered" IsVisible="False" />
                                        <DataGridTextColumn Header="Deaths" Binding="{Binding Deaths}" Tag="Deaths" IsVisible="False" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Killed mobs" IsEnabled="{Binding Detail.HasDetailedHistory}">
                                <DataGrid ItemsSource="{Binding Mobs}" RowHeight="36" Height="{Binding Mobs.Count, Converter={x:Static views:ActivityView.HistoryMobTableHeightConverter}}" MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Mob" Width="*" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ActivityMobRow">
                                                    <controls:MobCell MobUniqueName="{Binding MobUniqueName}" IconSize="32" Title="{Binding Name}" Margin="8,0" ToolTip.Tip="{Binding Tip}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Kills" Binding="{Binding Count}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Items">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <controls:SegmentedSelector ItemsSource="{Binding Filters.LootScopeOptions}" SelectedItem="{Binding SelectedSessionLootScope, Mode=TwoWay}" AutomationProperties.Name="Session item scope" />
                                        <controls:SegmentedSelector ItemsSource="{Binding Filters.ItemSourceOptions}" SelectedItem="{Binding SelectedSessionItemSource, Mode=TwoWay}" AutomationProperties.Name="Session item source" />
                                    </StackPanel>
                                    <Expander Grid.Row="1" Header="Gathered" IsVisible="{Binding HasSessionResources}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                        <ItemsRepeater ItemsSource="{Binding SessionResources}" ItemTemplate="{StaticResource ActivityResourceTileTemplate}" Margin="8,8,8,2"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="236" MinItemHeight="56" ItemsStretch="None" /></ItemsRepeater.Layout></ItemsRepeater>
                                    </Expander>
                                    <Expander Grid.Row="2" Header="Loot" IsVisible="{Binding Detail.ShowLootPanel}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                    <DataGrid ItemsSource="{Binding SessionLoot}" Classes="Compact" RowHeight="40" Height="{Binding SessionLoot.Count, Converter={x:Static views:ActivityView.HistoryLootTableHeightConverter}}" MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" />
                                            <DataGridTemplateColumn Header="Item" Width="*" MinWidth="200" CellTemplate="{StaticResource LootItemTemplate}" />
                                            <DataGridTextColumn Header="Quantity" Binding="{Binding AmountText}" />
                                            <DataGridTextColumn Header="EMV" Binding="{Binding ValueText}" />
                                            <DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" MinWidth="110" />
                                            <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" />
                                            <DataGridTextColumn Header="Alliance" Binding="{Binding Alliance}" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                                            <DataGridTextColumn Header="Source guild" Binding="{Binding LootSourceGuild}" />
                                            <DataGridTextColumn Header="Source alliance" Binding="{Binding LootSourceAlliance}" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Expander>
                                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <WrapPanel>
                                            <Button Classes="UiAction" Content="Load more" Command="{Binding LoadMoreSessionLootCommand}" IsVisible="{Binding HasMoreSessionLoot}" Margin="0,0,8,0" />
                                            <views:ActivityLootExportBar Export="{Binding Export}" ExportCommand="{Binding ExportSessionLootCommand}" CanExport="{Binding Detail.CanExportLoot}" ShowLootLoggerLink="True" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="1" Classes="UiLabel" Text="{Binding Export.StatusText}" IsVisible="{Binding Export.HasStatus}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Timeline" IsEnabled="{Binding Detail.HasDetailedHistory}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <ContentControl Content="{Binding Filters}" ContentTemplate="{StaticResource ActivityVisibilityTemplate}" />
                                    <DataGrid x:Name="HistoryTimelineTable" Grid.Row="1" ItemsSource="{Binding Timeline}" Height="{Binding Timeline.Count, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}"
                                              MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding TimeText}" /><DataGridTextColumn Header="Event" Binding="{Binding Kind}" /><DataGridTemplateColumn Header="Source" SortMemberPath="Source"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ActivityEventRow"><StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center" ToolTip.Tip="{Binding SourceTip}"><Image Width="24" Height="24" Stretch="Uniform" IsVisible="{Binding HasSourceMob}" items:LazyMobImage.MobUniqueName="{Binding SourceMob}" /><TextBlock Text="{Binding Source}" VerticalAlignment="Center" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Target" SortMemberPath="Target"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ActivityEventRow"><StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center" ToolTip.Tip="{Binding TargetTip}"><Image Width="24" Height="24" Stretch="Uniform" IsVisible="{Binding HasTargetMob}" items:LazyMobImage.MobUniqueName="{Binding TargetMob}" /><TextBlock Text="{Binding Target}" VerticalAlignment="Center" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" MinWidth="160" /><DataGridTextColumn Header="Location" Binding="{Binding Location}" /></DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Classes="UiAction" Content="Load more" Command="{Binding LoadMoreTimelineCommand}" IsVisible="{Binding HasMoreTimeline}" HorizontalAlignment="Left" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Maps" IsEnabled="{Binding Detail.HasDetailedHistory}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Text="Select a map to see its totals." Classes="UiLabel" />
                                    <DataGrid x:Name="HistoryMapsTable" Grid.Row="1" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap, Mode=TwoWay}" SelectionMode="Single" RowHeight="48"
                                              Height="{Binding Maps.Count, Converter={x:Static views:ActivityView.HistoryMapTableHeightConverter}}"
                                              MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Map" Width="*" MinWidth="200" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:ActivityMapRow">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="8,0" ToolTip.Tip="{Binding DetailsText}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DetailsText}" IsVisible="{Binding HasDetails}" Classes="UiLabel" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="First visit" Binding="{Binding StartedText}" />
                                            <DataGridTextColumn Header="Visits" Binding="{Binding VisitCount}" />
                                            <DataGridTextColumn Header="Recorded time" Binding="{Binding DurationText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Classes="UiAction" Content="Load more" Command="{Binding LoadMoreMapsCommand}" IsVisible="{Binding HasMoreMaps}" HorizontalAlignment="Left" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Party" IsEnabled="{Binding Detail.HasDetailedHistory}">
                                <StackPanel Spacing="12">
                                    <controls:EmptyState Classes="Inline" Message="No party members were recorded." IsVisible="{Binding !HasPartyHistory}" />
                                    <TextBlock Text="{Binding PartyHistory.SummaryText}" IsVisible="{Binding HasPartyHistory}" Classes="UiLabel" />
                                    <DataGrid ItemsSource="{Binding PartyHistory.Members}" IsVisible="{Binding HasPartyHistory}" Height="{Binding PartyHistory.MemberCount, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}" MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Member" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                            <DataGridTextColumn Header="Joined" Binding="{Binding JoinedText}" />
                                            <DataGridTextColumn Header="Left" Binding="{Binding LeftText}" />
                                            <DataGridTextColumn Header="Time in party" Binding="{Binding DurationText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Spacing="6" IsVisible="{Binding HasPartyChanges}">
                                        <TextBlock Text="Changes" Classes="UiSectionTitle" />
                                        <DataGrid ItemsSource="{Binding PartyHistory.Changes}" Height="{Binding PartyHistory.ChangeCount, Converter={x:Static views:ActivityView.HistoryTableHeightConverter}}" MaxHeight="{Binding #HistorySessionDetailScroll.Bounds.Height, Converter={x:Static views:ActivityView.HistoryTimelineViewportHeightConverter}}" VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" />
                                                <DataGridTemplateColumn Header="Change">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityPartyChangeRow">
                                                            <TextBlock Text="{Binding Change}" Classes="PartyChange" Classes.Joined="{Binding Joined}" VerticalAlignment="Center" Margin="12,0" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Members" Width="*" MinWidth="160">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityPartyChangeRow">
                                                            <TextBlock Text="{Binding Player}" ToolTip.Tip="{Binding PlayerDetails}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Party size" Binding="{Binding PartySizeText}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Items">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Items}" x:DataType="vm:ActivityItemsViewModel">
                <StackPanel Spacing="12" Margin="0,8,12,8">
                    <StackPanel Spacing="4">
                        <WrapPanel>
                            <controls:SegmentedSelector ItemsSource="{Binding Filters.LootScopeOptions}" SelectedItem="{Binding SelectedLootScope, Mode=TwoWay}" AutomationProperties.Name="Item scope" Margin="0,0,12,0" />
                            <controls:SegmentedSelector ItemsSource="{Binding Filters.ItemSourceOptions}" SelectedItem="{Binding SelectedItemSource, Mode=TwoWay}" AutomationProperties.Name="Item source" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,-8">
                            <controls:FilterField Label="Search loot">
                                <TextBox Text="{Binding LootSearch}" Watermark="Item, player or source" Width="230">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding ApplyLootFiltersCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </controls:FilterField>
                            <Button Classes="UiAction UiPrimary" Content="Search" Command="{Binding ApplyLootFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                    <Expander Header="Gathered" IsVisible="{Binding HasGlobalResources}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                        <ScrollViewer MaxHeight="108" HorizontalScrollBarVisibility="Disabled" Margin="8,8,8,2"><ItemsRepeater ItemsSource="{Binding GlobalResources}" ItemTemplate="{StaticResource ActivityResourceTileTemplate}"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="236" MinItemHeight="56" ItemsStretch="None" /></ItemsRepeater.Layout></ItemsRepeater></ScrollViewer>
                                    </Expander>
                    <Expander Header="Loot" IsVisible="{Binding ShowGlobalLootPanel}" IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                    <DataGrid ItemsSource="{Binding GlobalLoot}" Classes="Compact" RowHeight="40" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding DateTimeText}" />
                            <DataGridTemplateColumn Header="Item" Width="*" MinWidth="220" CellTemplate="{StaticResource LootTemplate}" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding AmountText}" />
                            <DataGridTextColumn Header="EMV" Binding="{Binding ValueText}" />
                            <DataGridTemplateColumn Header="Recipient" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ActivityLootRow"><TextBlock Text="{Binding Recipient}" ToolTip.Tip="{Binding RecipientDetails}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" />
                            <DataGridTextColumn Header="Alliance" Binding="{Binding Alliance}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="Source guild" Binding="{Binding LootSourceGuild}" />
                            <DataGridTextColumn Header="Source alliance" Binding="{Binding LootSourceAlliance}" />
                            <DataGridTemplateColumn Header="Location" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ActivityLootRow"><TextBlock Text="{Binding Location}" ToolTip.Tip="{Binding ContextDetails}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Expander>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding GlobalLootTotalsText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="{Binding GlobalLootDetailsText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="UiAction" Content="Load more" Command="{Binding LoadMoreGlobalLootCommand}" IsVisible="{Binding HasMoreGlobalLoot}" />
                            <views:ActivityLootExportBar Export="{Binding Export}" ExportCommand="{Binding ExportGlobalLootCommand}" CanExport="{Binding Export.CanStart}" IsVisible="{Binding ShowGlobalLootPanel}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="UiLabel" Text="{Binding Export.StatusText}" IsVisible="{Binding Export.HasStatus}" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
