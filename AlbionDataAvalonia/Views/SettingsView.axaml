<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AlbionDataAvalonia.Views.SettingsView"
             x:Name="SettingsRoot"
             Classes="AppPage"
             x:DataType="vm:SettingsViewModel">

    <TabControl Margin="0,0,20,20">
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,14,0,0">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="Start with Windows"
                                  IsChecked="{Binding UserSettings.StartWithWindows}"
                                  IsVisible="{Binding IsWindows}"
                                  Margin="0,0,28,8" />
                        <CheckBox Content="Minimize button hides window to system tray"
                                  IsChecked="{Binding UserSettings.MinimizeButtonMinimizesToTray}"
                                  Margin="0,0,28,8" />
                        <CheckBox Content="Close button hides window to system tray"
                                  IsChecked="{Binding CloseButtonHidesToTray}"
                                  Margin="0,0,28,8" />
                        <CheckBox Content="Join beta program"
                                  IsChecked="{Binding UserSettings.JoinBetaProgram}"
                                  Margin="0,0,28,8" />
                    </WrapPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="When AFM Data Client starts:" />
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Content="Display main window"
                                         GroupName="StartupWindowMode"
                                         IsChecked="{Binding IsShowMainWindowOnStartup}"
                                         Margin="0,0,28,8" />
                            <RadioButton Content="Minimize main window to taskbar"
                                         GroupName="StartupWindowMode"
                                         IsChecked="{Binding IsMinimizedToTaskbarOnStartup}"
                                         Margin="0,0,28,8" />
                            <RadioButton Content="Hide main window in system tray"
                                         GroupName="StartupWindowMode"
                                         IsChecked="{Binding IsHiddenToTrayOnStartup}"
                                         Margin="0,0,28,8" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Uploads">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,14,0,0" RowSpacing="18">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Parallel uploads" />
                        <TextBlock Grid.Column="1" Text="{Binding UserSettings.DesiredThreadCount, Mode=OneWay, StringFormat={}{0:N0}}" />
                    </Grid>

                    <Slider Grid.Row="1"
                            Minimum="1"
                            Maximum="{Binding UserSettings.MaxThreadCount}"
                            Value="{Binding UserSettings.DesiredThreadCount}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True" />

                    <Expander Grid.Row="2" Header="Diagnostics" IsExpanded="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Top">
                        <StackPanel Spacing="8" Margin="12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Classes="UiSectionTitle" Text="Proof-of-work performance" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="UiAction UiSecondary" Content="Clear" Command="{Binding ClearPowSolveStatsCommand}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock FontSize="12" Opacity="0.8">
                                <Run Text="Tracking last " />
                                <Run Text="{Binding PowSolveSampleCount, Mode=OneWay, StringFormat={}{0:N0}}" />
                                <Run Text=" of " />
                                <Run Text="{Binding PowSolveWindowSize, Mode=OneWay, StringFormat={}{0:N0}}" />
                                <Run Text=" solves" />
                            </TextBlock>

                            <UniformGrid Columns="2" Rows="4" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                <TextBlock Text="Latest:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimeLatest, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,6">
                                <TextBlock Text="Average:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimeAverage, Mode=OneWay, StringFormat={}{0:N1} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                <TextBlock Text="Median:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimeMedian, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,6">
                                <TextBlock Text="95th percentile:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimePercentile95, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Min:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimeMin, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                <TextBlock Text="Max:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimeMax, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Std dev:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveTimeStandardDeviation, Mode=OneWay, StringFormat={}{0:N1} ms}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                <TextBlock Text="Samples:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowSolveSampleCount, Mode=OneWay, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Expander>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Sharing">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,14,20,0" HorizontalAlignment="Stretch">
                    <TextBlock Text="Sign in to manage private sharing settings."
                               IsVisible="{Binding !IsUserLoggedIn}"
                               Opacity="0.8" />

                    <StackPanel Spacing="12" IsEnabled="{Binding CanUseSharingSettings}">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="Your ID:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                   Text="{Binding RedactedCurrentFirebaseUserId}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   MaxWidth="720" />
                            <Button Grid.Column="2" Classes="UiAction UiSecondary"
                                    Content="Copy"
                                    Click="CopyUserIdButton_Click"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.8"
                                   HorizontalAlignment="Left"
                                   Text="Add up to five people by user ID, email or AFM website username (not an Albion character name). Sharing works only when you have added each other and Share with Friends is enabled. They can use your market orders in the flipper and website price tools. Send them your ID, email or AFM username so they can add you. Turning sharing off stops new shared uploads. Previously shared price summaries keep their original expiry, up to two days." />

                        <TextBlock Text="{Binding SharedFriendsLimitText}"
                                   FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="360,Auto" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBox Grid.Column="0"
                                     Text="{Binding FriendInput}"
                                     Watermark="User ID, email or AFM username" />
                            <Button Grid.Column="1" Classes="UiAction"
                                    Content="Add"
                                    Command="{Binding AddSharedUserCommand}"
                                    IsEnabled="{Binding CanAddSharedUser}"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SharedUsers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PrivateOrderShareEntryViewModel">
                                    <Border Background="rgba(255,255,255,0.08)"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            Margin="0,0,8,8"
                                            BorderBrush="rgba(255,255,255,0.16)"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Value}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="280"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Button Width="24" Height="24"
                                                    Padding="0"
                                                    MinWidth="24"
                                                    MinHeight="24"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Remove from sharing"
                                                    AutomationProperties.Name="Remove from sharing"
                                                    Tag="{Binding}"
                                                    Click="RemoveSharedUserButton_Click">
                                                <PathIcon Width="10" Height="10"
                                                          Data="M 1,0 L 5,4 L 9,0 L 10,1 L 6,5 L 10,9 L 9,10 L 5,6 L 1,10 L 0,9 L 4,5 L 0,1 Z" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock IsVisible="{Binding HasUnresolvedEntries}"
                                   Text="{Binding SharingStatus}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8"
                                   Foreground="{StaticResource AFMOrange}" />
                        <TextBlock IsVisible="{Binding HasNormalSharingStatus}"
                                   Text="{Binding SharingStatus}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Activity">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,14,20,0" Spacing="12">
                    <CheckBox Content="Record activity"
                              IsChecked="{Binding UserSettings.ActivityRecordingEnabled}" />
                    <TextBlock Text="{Binding ActivityRecordingStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="Combat, gathering, fishing, and loot are saved together in local sessions. Turning recording off finishes the current session and keeps your history. Records remain until you delete them in Activity."
                               TextWrapping="Wrap" Opacity="0.65" />
                    <TextBlock Text="Party filters change what is shown. All observed loot pickups are recorded while recording is enabled."
                               TextWrapping="Wrap" Opacity="0.65" />

                    <TextBlock Text="Streamer window" FontSize="16" FontWeight="DemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="A compact window with the current session. Capture it as a window source in your streaming app."
                               TextWrapping="Wrap" Opacity="0.65" />
                    <WrapPanel>
                        <CheckBox Content="Silver totals" IsChecked="{Binding UserSettings.StreamerShowSilver}" Margin="0,0,18,4" />
                        <CheckBox Content="Combat" IsChecked="{Binding UserSettings.StreamerShowCombat}" Margin="0,0,18,4" />
                        <CheckBox Content="Gathering" IsChecked="{Binding UserSettings.StreamerShowGathering}" Margin="0,0,18,4" />
                        <CheckBox Content="Chart" IsChecked="{Binding UserSettings.StreamerShowChart}" Margin="0,0,18,4" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UserSettings.StreamerShowChart}">
                        <TextBlock Text="Chart shows" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding UserSettings.StreamerChartModeIndex}" Width="140">
                            <ComboBoxItem Content="Combat" />
                            <ComboBoxItem Content="Gathering" />
                            <ComboBoxItem Content="Fame" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Content="Show party totals instead of personal"
                              IsChecked="{Binding UserSettings.StreamerPartyTotals}" />
                    <CheckBox Content="Green background for chroma key"
                              IsChecked="{Binding UserSettings.StreamerChromaKey}" />
                    <Button Classes="UiAction" Content="{Binding StreamerWindowButtonText}" Command="{Binding ToggleStreamerWindowCommand}"
                            IsVisible="{Binding CanOpenStreamerWindow}" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>



        <TabItem Header="Awakened">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,14,0,0" Spacing="8">
                    <CheckBox Content="Disable Awakened Items Tracker"
                              IsChecked="{Binding UserSettings.DisableAwakeningItemsTracker}" />
                    <TextBlock Text="Stops detecting and storing awakened items. Existing records are kept."
                               TextWrapping="Wrap"
                               Opacity="0.65" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Backup">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,14,20,0" Spacing="14">
                    <TextBlock Text="Automatic database backups"
                               FontWeight="Bold"
                               FontSize="16" />
                    <TextBlock Text="AFM Data Client creates a compressed backup every 24 hours. It keeps the three newest backups plus recovery points closest to 5, 10, and 15 days old."
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Backup folder" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BackupFolderPath}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="UiAction UiSecondary"
                                Content="Open backup folder"
                                Command="{Binding OpenBackupFolderCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Border Classes="UiCard"
                            Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Privacy" FontWeight="Bold" />
                            <TextBlock Text="Backups contain your stored history and player data. Your saved sign-in token is removed, so you must sign in again after restoring a backup."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="How to restore a backup"
                                   FontWeight="Bold"
                                   FontSize="16" />
                        <TextBlock Text="1. Exit AFM from the system tray and confirm that it is no longer running."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="2. Make a safety copy of the current data folder:"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DataFolderPath}"
                                   Margin="20,0,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                        <TextBlock Text="3. Extract the selected backup ZIP. It contains afmdataclient.db."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="4. In the data folder, move aside afmdataclient.db and any afmdataclient.db-wal or afmdataclient.db-shm files."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="5. Copy the extracted afmdataclient.db into the data folder."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="6. Start AFM, verify the restored history, and sign in again."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
