<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AlbionDataAvalonia.Views.SettingsView"
             x:Name="SettingsRoot"
             Classes="AppPage"
             x:DataType="vm:SettingsViewModel">

    <!-- Page spacing and the market-order choice rows are specific to Settings. -->
    <UserControl.Styles>
        <Style Selector="StackPanel.Page">
            <Setter Property="Spacing" Value="18" />
            <Setter Property="Margin" Value="0,12,16,16" />
        </Style>
        <Style Selector="RadioButton.Choice">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>
    </UserControl.Styles>

    <TabControl Margin="0,0,20,20" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="Page">
                    <controls:SettingsGroup Header="UPDATES">
                        <controls:SettingsRow Title="Update channel" Hint="{Binding UpdateChannelText}">
                            <controls:SegmentedSelector ItemsSource="{Binding UpdateChannelOptions}"
                                                        SelectedIndex="{Binding UpdateChannelIndex}" />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="STARTUP">
                        <controls:SettingsRow Classes="Stacked" Title="When the client starts" Hint="The client keeps capturing in every mode.">
                            <controls:SegmentedSelector ItemsSource="{Binding StartupWindowModeOptions}" SelectedIndex="{Binding StartupWindowModeIndex}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Start with Windows" Hint="Open AFM Data Client when you sign in to Windows." IsVisible="{Binding IsWindows}">
                            <ToggleSwitch IsChecked="{Binding UserSettings.StartWithWindows}" />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="WINDOW BUTTONS">
                        <controls:SettingsRow Title="Minimize hides to tray" Hint="The window leaves the taskbar. Open it again from the tray icon.">
                            <ToggleSwitch IsChecked="{Binding UserSettings.MinimizeButtonMinimizesToTray}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Close hides to tray" Hint="The client keeps running. Quit from the tray icon menu.">
                            <ToggleSwitch IsChecked="{Binding CloseButtonHidesToTray}" />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Uploads &amp; sharing">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="Page">
                    <controls:InfoBanner IsVisible="{Binding !IsUserLoggedIn}"
                                         Message="Signed out. Market data uploads to the Albion Online Data Project. Sign in to use private mode, sharing and AFM account features." />

                    <controls:SettingsGroup Header="MARKET ORDERS">
                        <controls:SettingsRow>
                            <RadioButton Classes="Choice" GroupName="MarketOrders" IsChecked="{Binding IsPublicMode}">
                                <StackPanel>
                                    <TextBlock Classes="UiRowTitle" Text="Public" />
                                    <TextBlock Classes="UiLabel" Margin="0,2,0,0" Text="Buy and sell orders go to the Albion Online Data Project, where any site or sheet can use them." />
                                </StackPanel>
                            </RadioButton>
                        </controls:SettingsRow>
                        <controls:SettingsRow>
                            <RadioButton Classes="Choice" GroupName="MarketOrders" IsChecked="{Binding IsPrivateMode}" IsEnabled="{Binding IsUserLoggedIn}">
                                <StackPanel>
                                    <TextBlock Classes="UiRowTitle" Text="Private mode" />
                                    <TextBlock Classes="UiLabel" Margin="0,2,0,0" Text="Orders go to AFM only, for your flipper and website price tools. Market history, gold prices and bandit events stay public." />
                                </StackPanel>
                            </RadioButton>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="SHARING IN PRIVATE MODE">
                        <controls:SettingsRow Title="Share with other AFM users" IsEnabled="{Binding CanUsePrivateSharing}"
                                              Hint="Other AFM users can use your orders in the flipper and price tools. They are not sent to AODP.">
                            <ToggleSwitch IsChecked="{Binding UserSettings.ContributeToPublic}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Share with friends" IsEnabled="{Binding CanUsePrivateSharing}"
                                              Hint="{Binding Sharing.LimitText, StringFormat='Up to five people, once you’ve added each other. {0}'}">
                            <ToggleSwitch IsChecked="{Binding UserSettings.ShareWithFriends}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Classes="Inset" Padding="30,10,14,12" IsEnabled="{Binding Sharing.CanEdit}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding Sharing.FriendInput}" Watermark="User ID, email or AFM username" AutomationProperties.Name="Friend to add" />
                                    <Button Grid.Column="1" Classes="UiAction" Content="Add"
                                            Command="{Binding Sharing.AddCommand}" IsEnabled="{Binding Sharing.CanAdd}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Sharing.Friends}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PrivateOrderShareEntryViewModel">
                                            <Border Classes="UiChip" Margin="0,0,8,8" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Value}" MaxWidth="280" />
                                                    <Button Classes="UiIcon UiGhost" Width="24" Height="24"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Remove from sharing"
                                                            AutomationProperties.Name="Remove from sharing"
                                                            Command="{Binding #SettingsRoot.((vm:SettingsViewModel)DataContext).Sharing.RemoveCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Width="10" Height="10"
                                                                  Data="M 1,0 L 5,4 L 9,0 L 10,1 L 6,5 L 10,9 L 9,10 L 5,6 L 1,10 L 0,9 L 4,5 L 0,1 Z" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <TextBlock Classes="UiLabel" Text="Friends add you with your ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Sharing.RedactedUserId}" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Classes="UiAction" Content="Copy" Command="{Binding Sharing.CopyUserIdCommand}" AutomationProperties.Name="Copy your user ID" />
                                </WrapPanel>
                                <TextBlock Classes="UiLabel UiWarning"
                                           IsVisible="{Binding Sharing.HasUnresolvedEntries}"
                                           Text="{Binding Sharing.Status}" />
                                <TextBlock Classes="UiLabel"
                                           IsVisible="{Binding Sharing.HasNormalStatus}"
                                           Text="{Binding Sharing.Status}" />
                            </StackPanel>
                        </controls:SettingsRow>
                        <controls:SettingsRow>
                            <TextBlock Classes="UiLabel" Text="Turning sharing off stops new shared uploads. Summaries you already shared expire within two days." />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="AFM ACCOUNT" IsEnabled="{Binding IsUserLoggedIn}">
                        <controls:SettingsRow Title="Upload character specs" Hint="Your specs appear on the AFM website.">
                            <ToggleSwitch IsChecked="{Binding UserSettings.UploadSpecsToAfm}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Island tracker" Hint="Tracks island plots and farming collections for your AFM account. After turning it back on, leave and re-enter your island.">
                            <ToggleSwitch IsChecked="{Binding UserSettings.AfmIslandTrackerEnabled}" />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="UPLOAD SPEED">
                        <controls:SettingsRow>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="UiRowTitle" Text="Parallel uploads" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding UserSettings.DesiredThreadCount, Mode=OneWay, StringFormat={}{0:N0}}" />
                                </Grid>
                                <Slider Minimum="1"
                                        Maximum="{Binding UserSettings.MaxThreadCount}"
                                        Value="{Binding UserSettings.DesiredThreadCount}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Parallel uploads" />
                                <TextBlock Classes="UiLabel" Text="More parallel uploads clear the queue faster and use more CPU for the proof-of-work each upload needs." />
                            </StackPanel>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Trackers">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="Page">
                    <controls:SettingsGroup Header="ACTIVITY">
                        <controls:SettingsRow Title="Record activity"
                                              Hint="{Binding ActivityRecordingStatus, StringFormat='Saves combat, gathering, fishing and loot into local sessions.&#10;{0}'}">
                            <ToggleSwitch IsChecked="{Binding UserSettings.ActivityRecordingEnabled}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow>
                            <Expander Classes="Plain" Header="How sessions work" IsExpanded="False"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Margin="4,8">
                                    <TextBlock Classes="UiLabel" Text="Combat, gathering, fishing, and loot are saved together in local sessions. A session starts when you leave a city, Rest, portal town or hideout for the open world, a dungeon or the Mists, or when you press Start session on the Activity page. Nothing you do in town starts one. Its time runs until you press End session, switch character or turn recording off, or until you stop moving for 30 minutes. Leaving the game or closing the app pauses it, and it continues if you're back within 30 minutes. Each dungeon, Mists visit or stretch of open world is a run inside it, from when you enter it. Records remain until you delete them in Settings › Data &amp; backups." />
                                    <TextBlock Classes="UiLabel" Text="Party filters change what is shown. All observed loot pickups are recorded while recording is on." />
                                </StackPanel>
                            </Expander>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="AWAKENED ITEMS">
                        <controls:SettingsRow Title="Track awakened items" Hint="Detects and stores awakened items. Turning it off keeps existing records.">
                            <ToggleSwitch IsChecked="{Binding TrackAwakenedItems}" />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Streamer">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="Page">
                    <TextBlock Classes="UiLabel" Margin="2,0,0,0"
                               Text="A compact window with the current session. Capture it as a window source in your streaming app." />

                    <Border Classes="UiCard Sunken" Padding="16" IsVisible="{Binding StreamerPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Classes="UiStreamerBackdrop" Classes.ChromaKey="{Binding StreamerPreview.UseChromaKey, FallbackValue=False}"
                                HorizontalAlignment="Center" CornerRadius="{DynamicResource UiRadiusOverlay}"
                                Width="{Binding StreamerPreview.WindowWidth, FallbackValue=330}">
                            <views:ActivityStreamerView DataContext="{Binding StreamerPreview}" />
                        </Border>
                    </Border>

                    <controls:SettingsGroup Header="LAYOUT">
                        <controls:SettingsRow Title="Size" Hint="{Binding StreamerSizeText}">
                            <controls:SegmentedSelector ItemsSource="{Binding StreamerSizeOptions}"
                                                        SelectedIndex="{Binding UserSettings.StreamerSizeIndex}"
                                                        AutomationProperties.Name="Streamer size" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Silver totals">
                            <ToggleSwitch IsChecked="{Binding UserSettings.StreamerShowSilver}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Combat">
                            <ToggleSwitch IsChecked="{Binding UserSettings.StreamerShowCombat}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Gathering">
                            <ToggleSwitch IsChecked="{Binding UserSettings.StreamerShowGathering}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Chart" Hint="{Binding StreamerChartText}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:SegmentedSelector ItemsSource="{Binding StreamerChartModeOptions}"
                                                            SelectedIndex="{Binding UserSettings.StreamerChartModeIndex}"
                                                            IsVisible="{Binding UserSettings.StreamerShowChart}"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Chart shows" />
                                <ToggleSwitch IsChecked="{Binding UserSettings.StreamerShowChart}" AutomationProperties.Name="Chart" />
                            </StackPanel>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="OPTIONS">
                        <controls:SettingsRow Title="Party totals" Hint="Show the party's numbers instead of yours. You can also switch it in the window itself.">
                            <ToggleSwitch IsChecked="{Binding UserSettings.StreamerPartyTotals}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="Green background" Hint="For chroma key in your streaming app.">
                            <ToggleSwitch IsChecked="{Binding UserSettings.StreamerChromaKey}" />
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <WrapPanel IsVisible="{Binding CanOpenStreamerWindow}">
                        <Button Classes="UiAction UiPrimary" Content="{Binding StreamerWindowButtonText}" Command="{Binding ToggleStreamerWindowCommand}" Margin="0,0,12,4" />
                        <TextBlock Classes="UiLabel" VerticalAlignment="Center" Text="Left open, it reopens when the client starts." />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Data &amp; backups">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="Page">
                    <controls:SettingsGroup Header="STORAGE">
                        <controls:SettingsRow>
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="UiRowTitle" Text="{Binding DatabaseSizeText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="UiLabel" Text="{Binding StorageNoteText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Refresh" Padding="10,3" FontSize="{DynamicResource UiFontSizeSmall}"
                                            Command="{Binding RefreshStorageCommand}" IsEnabled="{Binding !IsMeasuringStorage}" />
                                </Grid>
                                <views:StorageBar Height="12" Segments="{Binding StorageSegments}" />
                                <ItemsControl ItemsSource="{Binding StorageLegend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StorageLegendItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,2">
                                                <Border Classes="UiSwatch" Background="{Binding Kind, Converter={x:Static views:UiValueConverters.StorageBrush}}" />
                                                <TextBlock Classes="UiLabel" VerticalAlignment="Center">
                                                    <Run Text="{Binding Label}" />
                                                    <Run Text="{Binding SizeText}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <!-- The cleanup card lists one row per kind of data, then the age and the action under a darker inset. -->
                    <controls:SettingsGroup Header="CLEAN UP" IsEnabled="{Binding !IsCleanupBusy}">
                        <ItemsControl ItemsSource="{Binding CleanupRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DataCleanupRowViewModel">
                                    <Border Padding="14,9" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                                      AutomationProperties.Name="{Binding Label}" />
                                            <Border Grid.Column="1" Classes="UiSwatch" Background="{Binding Type, Converter={x:Static views:UiValueConverters.StorageBrush}}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Classes="UiRowTitle" Text="{Binding Label}" />
                                                <TextBlock Classes="UiLabel" Text="{Binding CountText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Padding="44,8,14,8" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding ShowPartyLootOption}">
                            <CheckBox IsChecked="{Binding RemoveOutsidePartyLoot}" FontSize="{DynamicResource UiFontSizeSmall}"
                                      Content="Also loot picked up by others outside your party, at any age" />
                        </Border>
                        <Border Padding="14,10" Background="{DynamicResource UiInsetBrush}" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <TextBlock Classes="UiLabel" Margin="0,0,12,0" VerticalAlignment="Center" Text="Older than" />
                                <controls:SegmentedSelector ItemsSource="{Binding CleanupAgeOptions}"
                                                            SelectedIndex="{Binding SelectedCleanupAgeIndex}"
                                                            AutomationProperties.Name="Remove records older than" />
                            </WrapPanel>
                        </Border>
                        <Border Padding="14,10" Background="{DynamicResource UiInsetBrush}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CleanupPreviewText}" FontSize="{DynamicResource UiFontSizeSmall}" TextWrapping="Wrap" />
                                    <TextBlock Classes="UiLabel" Text="{Binding CleanupStatusText}"
                                               IsVisible="{Binding CleanupStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding CompactAfterCleanup}" FontSize="{DynamicResource UiFontSizeSmall}" VerticalAlignment="Center"
                                          Content="Compact afterwards"
                                          ToolTip.Tip="Rewrites the database file so it gets smaller. Recording pauses briefly while it runs." />
                                <Button Grid.Column="2" Classes="UiAction UiDanger" Content="Delete…" VerticalAlignment="Center"
                                        Command="{Binding DeleteDataCommand}" IsEnabled="{Binding CanDeleteData}" />
                            </Grid>
                        </Border>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="BACKUPS">
                        <controls:SettingsRow>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="UiRowTitle" Text="Automatic, every 24 hours" />
                                    <TextBlock Classes="UiLabel" Margin="0,2,0,0" Text="Keeps the three newest plus points about 5, 10 and 15 days old. Backups include your history, not your sign-in, so sign in again after restoring." />
                                    <TextBlock Classes="UiMono UiMuted" Margin="0,4,0,0" Text="{Binding BackupFolderPath}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="UiAction" Content="Open folder"
                                        Command="{Binding OpenBackupFolderCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </controls:SettingsRow>
                        <controls:SettingsRow>
                            <Expander Classes="Plain" Header="How to restore a backup" IsExpanded="False"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="6" Margin="4,8">
                                    <TextBlock Classes="UiLabel" Text="1. Exit AFM from the system tray and confirm that it is no longer running." />
                                    <TextBlock Classes="UiLabel" Text="2. Make a safety copy of the data folder below." />
                                    <TextBlock Classes="UiLabel" Text="3. Extract the selected backup ZIP. It contains afmdataclient.db." />
                                    <TextBlock Classes="UiLabel" Text="4. In the data folder, move aside afmdataclient.db and any afmdataclient.db-wal or afmdataclient.db-shm files." />
                                    <TextBlock Classes="UiLabel" Text="5. Copy the extracted afmdataclient.db into the data folder." />
                                    <TextBlock Classes="UiLabel" Text="6. Start AFM, verify the restored history, and sign in again." />
                                </StackPanel>
                            </Expander>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="DATA FOLDER">
                        <controls:SettingsRow>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="UiRowTitle" Text="History database" />
                                    <TextBlock Classes="UiMono UiMuted" Margin="0,4,0,0" Text="{Binding DataFolderPath}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="UiAction" Content="Open folder"
                                        Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="About">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="Page">
                    <controls:SettingsGroup Header="VERSION">
                        <controls:SettingsRow Title="{Binding AppVersionText}" Hint="{Binding UpdatesText}" />
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="LINKS">
                        <controls:SettingsRow>
                            <WrapPanel>
                                <Button Classes="UiAction" Content="Albion Free Market" Command="{Binding OpenAfmWebsiteCommand}" Margin="0,0,8,0" />
                                <Button Classes="UiAction" Content="Albion Online Data Project" Command="{Binding OpenAodpWebsiteCommand}" Margin="0,0,8,0" />
                                <Button Classes="UiAction" Content="AFM Discord" Command="{Binding OpenDiscordCommand}" />
                            </WrapPanel>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup Header="DIAGNOSTICS">
                        <controls:SettingsRow Title="Diagnostics mode"
                                              Hint="Writes every packet the client uses to a separate file for bug reports. Files are deleted after 2 days. It turns off when the client restarts.">
                            <ToggleSwitch IsChecked="{Binding DiagnosticsEnabled}" />
                        </controls:SettingsRow>
                        <controls:SettingsRow IsVisible="{Binding DiagnosticsEnabled}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="UiRowTitle UiAccent" Text="Recording packets" />
                                    <TextBlock Classes="UiMono UiMuted" Margin="0,4,0,0" Text="{Binding DiagnosticsFilePath}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="UiAction" Content="Open folder"
                                        Command="{Binding OpenLogsFolderCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </controls:SettingsRow>
                        <controls:SettingsRow>
                            <Expander Classes="Plain" Header="Proof-of-work performance" IsExpanded="False"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Margin="4,8">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <TextBlock Classes="UiLabel" VerticalAlignment="Center">
                                            <Run Text="Last " />
                                            <Run Text="{Binding PowSolveSampleCount, Mode=OneWay, StringFormat={}{0:N0}}" />
                                            <Run Text=" of " />
                                            <Run Text="{Binding PowSolveWindowSize, Mode=OneWay, StringFormat={}{0:N0}}" />
                                            <Run Text=" solves. Useful when reporting slow uploads." />
                                        </TextBlock>
                                        <Button Grid.Column="1" Classes="UiAction" Content="Clear" Command="{Binding ClearPowSolveStatsCommand}" />
                                    </Grid>
                                    <UniformGrid Columns="2" Rows="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                            <TextBlock Text="Latest:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimeLatest, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,6">
                                            <TextBlock Text="Average:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimeAverage, Mode=OneWay, StringFormat={}{0:N1} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                            <TextBlock Text="Median:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimeMedian, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,6">
                                            <TextBlock Text="95th percentile:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimePercentile95, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Min:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimeMin, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                            <TextBlock Text="Max:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimeMax, Mode=OneWay, StringFormat={}{0:N0} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Std dev:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveTimeStandardDeviation, Mode=OneWay, StringFormat={}{0:N1} ms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                            <TextBlock Text="Samples:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowSolveSampleCount, Mode=OneWay, StringFormat={}{0:N0}}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Expander>
                        </controls:SettingsRow>
                    </controls:SettingsGroup>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
