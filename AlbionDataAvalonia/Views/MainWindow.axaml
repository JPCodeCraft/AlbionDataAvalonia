<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
		xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AlbionDataAvalonia.Views.MainWindow" Classes="AppPage"
        Icon="/Assets/logo.ico"
        Title="Albion Data Client"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaTitleBarHeightHint="30"
		MinWidth="800" MinHeight="600"
		x:DataType="vm:MainViewModel">


	<Grid Margin="0 30 0 0">
		<Grid.RowDefinitions>
			<RowDefinition Height="1" />
			<RowDefinition Height="*" />
			<RowDefinition Height="1" />
			<RowDefinition Height="30" />
		</Grid.RowDefinitions>

		<Rectangle Grid.Row="0" Classes="UiDivider" />

		<views:MainView Grid.Row="1" />

		<Border Grid.Row="1"
				ZIndex="1"
				Background="{DynamicResource UiScrimBrush}"
				IsVisible="{Binding IsInitializing}">
			<StackPanel Width="320"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="14">
				<TextBlock HorizontalAlignment="Center"
						   Classes="UiTitle"
						   Text="Starting Albion Data Client…" />
				<ProgressBar Height="6" IsIndeterminate="True" />
			</StackPanel>
		</Border>

		<Rectangle Grid.Row="2" Classes="UiDivider" />

		<Grid ColumnDefinitions="*, *, *" Grid.Row="3"  Margin="10 0 10 0">
			<Button Grid.Column="0" Classes="UiLink" Content="Albion Free Market" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding OpenAFMWebsiteCommand}" />
			<StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
				<TextBlock Text="{Binding AppVersion, StringFormat='App version {0}'}" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSizeSmall}" />
			</StackPanel>
			<Button Grid.Column="2" Classes="UiLink" Content="Albion Data Project" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenAODPWebsiteCommand}"/>
		</Grid>
	</Grid>


</Window>
