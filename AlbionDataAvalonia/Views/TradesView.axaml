<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="AlbionDataAvalonia.Views.TradesView"
             x:DataType="vm:TradesViewModel"
             Classes="AppPage">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <WrapPanel Margin="0,8,0,0">
            <StackPanel Margin="0,0,10,8" Spacing="3">
                <TextBlock Classes="UiLabel" Text="Search loaded items" />
                <TextBox Text="{Binding FilterText}" Name="FilterBox" Width="230" Watermark="Item name" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Spacing="3">
                <TextBlock Classes="UiLabel" Text="Trades to load" />
                <ComboBox ItemsSource="{Binding TradesToLoadOptions}" SelectedItem="{Binding SelectedTradesToLoad}" Width="120" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Spacing="3">
                <TextBlock Classes="UiLabel" Text="Server" />
                <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Width="145" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Spacing="3">
                <TextBlock Classes="UiLabel" Text="Trade type" />
                <ComboBox ItemsSource="{Binding TradeTypes}" SelectedItem="{Binding SelectedTradeType}" Width="120" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Spacing="3">
                <TextBlock Classes="UiLabel" Text="Operation" />
                <ComboBox ItemsSource="{Binding TradeOperations}" SelectedItem="{Binding SelectedOperation}" Width="120" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Spacing="3">
                <TextBlock Classes="UiLabel" Text="Location" />
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" Width="170" />
            </StackPanel>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,2">
            <Button Classes="UiAction UiSecondary" Margin="0,0,8,6" Content="Reload" Command="{Binding LoadTradesCommand}" />
            <Button Classes="UiAction UiSecondary" Margin="0,0,8,6" Content="Export CSV" Name="ExportCsvButton" Click="ExportCsvButton_Click" IsEnabled="{Binding !IsExporting}" />
            <Button Classes="UiAction UiSecondary" Margin="0,0,8,6" Content="Set quality" Name="SetQualityButton" Click="SetQualityButton_Click" IsEnabled="{Binding CanSetSelectedTradeQuality}" />
            <Button Classes="UiAction UiSecondary" Margin="0,0,8,6" Content="Add to portfolio" Name="AddToPortfolioButton" Click="AddToPortfolioButton_Click" IsEnabled="{Binding CanAddSelectedTradesToPortfolio}" />
            <Button Classes="UiAction UiSecondary" Margin="0,0,8,6" Content="Cleanup..." Name="CleanupButton" Click="CleanupButton_Click" />
            <Button Classes="UiAction UiSecondary" Margin="0,0,8,6" Content="Delete selected..." Name="DeleteButton" Click="DeleteButton_Click" IsEnabled="{Binding HasSelectedRows}" />
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,6" Spacing="4">
            <TextBlock Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}" TextWrapping="Wrap" Foreground="#FFB4A8" FontSize="12" />
            <TextBlock Text="{Binding PortfolioImportStatus}" IsVisible="{Binding HasPortfolioImportStatus}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding PortfolioPostLimitHelperText}" IsVisible="{Binding IsSelectedPortfolioPostLimitExceeded}" TextWrapping="Wrap" Foreground="#FFB4A8" FontSize="12" />
        </StackPanel>
        <DataGrid Grid.Row="3" Margin="0" ItemsSource="{Binding Trades}"
                  Name="TradesGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionChanged="TradesGrid_SelectionChanged"
                  GridLinesVisibility="None"
                  BorderThickness="0" BorderBrush="Gray">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Server" Binding="{Binding Server.Name}" />
                <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" />
                <DataGridTextColumn Header="Premium" Binding="{Binding PremiumStatusFormatted}" />
                <DataGridTextColumn Header="Received" Binding="{Binding DateTime, Mode=OneWay, Converter={x:Static views:UiValueConverters.LocalDateTime}}" SortMemberPath="DateTime" />
                <DataGridTextColumn Header="Type" Binding="{Binding TradeTypeFormatted}" />
                <DataGridTextColumn Header="Operation" Binding="{Binding TradeOperationFormatted}" />
                <DataGridTextColumn Header="Quality" Binding="{Binding QualityLevelFormatted}" />
                <DataGridTextColumn Header="Portfolio" Binding="{Binding UploadedToPortfolioFormatted}" />
                <DataGridTemplateColumn Header="Item" SortMemberPath="ItemName" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="30" Height="30" Stretch="Uniform"
                                       items:LazyItemImage.ItemUniqueName="{Binding ItemId}"
                                       items:LazyItemImage.Quality="{Binding ImageQuality}" />
                                <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Location" Binding="{Binding Location.FriendlyName}" />

                <DataGridTemplateColumn Header="Amount" CanUserSort="True" SortMemberPath="Amount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Amount, Converter={x:Static views:UiValueConverters.WholeNumber}}" Classes="TableNumber" />
                                <TextBlock Text="{Binding OrderAmountFormatted}" Classes="UiLabel" VerticalAlignment="Center"
                                           IsVisible="{Binding IsPartialOrder}" ToolTip.Tip="Filled amount of the full order" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Unit Silver" CanUserSort="True"  SortMemberPath="UnitSilver">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UnitSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}" Classes="TableNumber" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Total Silver" CanUserSort="True"  SortMemberPath="TotalSilver">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}" Classes="TableNumber" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" ColumnDefinitions="*,150" MinHeight="42" Margin="0,6,0,0" ColumnSpacing="12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Classes="UiLabel" Text="Selected:" Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedAmountTotal, Converter={x:Static views:UiValueConverters.WholeNumber}}" Tag="{Binding SelectedAmountTotal}" Cursor="Hand" PointerPressed="CopyValuePointerPressed" ToolTip.Tip="Click to copy" />
                    <TextBlock Classes="UiLabel" Text="items" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedTotalSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}" Tag="{Binding SelectedTotalSilver}" Cursor="Hand" PointerPressed="CopyValuePointerPressed" ToolTip.Tip="Click to copy" />
                    <TextBlock Classes="UiLabel" Text="silver" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="UiLabel" Text="Average:" />
                    <TextBlock Text="{Binding SelectedAverageSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}" Tag="{Binding SelectedAverageSilver}" Cursor="Hand" PointerPressed="CopyValuePointerPressed" ToolTip.Tip="Click to copy" />
                </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsExporting}">
                <TextBlock Classes="UiLabel" Text="Exporting CSV..." />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}" Height="4" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
