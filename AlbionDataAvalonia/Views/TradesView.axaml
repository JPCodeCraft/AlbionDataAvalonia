<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="AlbionDataAvalonia.Views.TradesView"
             x:DataType="vm:TradesViewModel"
             Classes="AppPage">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <WrapPanel Margin="0,8,0,0">
            <controls:FilterField Label="Search loaded items">
                <TextBox Text="{Binding FilterText}" Name="FilterBox" Width="230" Watermark="Item name" />
            </controls:FilterField>
            <controls:FilterField Label="Trades to load">
                <ComboBox ItemsSource="{Binding TradesToLoadOptions}" SelectedItem="{Binding SelectedTradesToLoad}" Width="120" />
            </controls:FilterField>
            <controls:FilterField Label="Server">
                <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Width="145" />
            </controls:FilterField>
            <controls:FilterField Label="Trade type">
                <ComboBox ItemsSource="{Binding TradeTypes}" SelectedItem="{Binding SelectedTradeType}" Width="120" />
            </controls:FilterField>
            <controls:FilterField Label="Operation">
                <ComboBox ItemsSource="{Binding TradeOperations}" SelectedItem="{Binding SelectedOperation}" Width="120" />
            </controls:FilterField>
            <controls:FilterField Label="Location">
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" Width="170" />
            </controls:FilterField>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,2">
            <Button Classes="UiAction" Margin="0,0,8,6" Content="Refresh" Command="{Binding LoadTradesCommand}" />
            <Button Classes="UiAction" Margin="0,0,8,6" Content="Export CSV…" Command="{Binding ExportCsvCommand}" IsEnabled="{Binding !IsExporting}" />
            <Button Classes="UiAction" Margin="0,0,8,6" Content="Set quality…" Command="{Binding SetQualityCommand}" IsEnabled="{Binding CanSetSelectedTradeQuality}" />
            <Button Classes="UiAction" Margin="0,0,8,6" Content="Add to Portfolio…" Command="{Binding AddToPortfolioCommand}" IsEnabled="{Binding CanAddSelectedTradesToPortfolio}" />
            <Button Classes="UiAction UiDanger" Margin="0,0,8,6" Content="Delete selected…" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelectedRows}" />
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,6" Spacing="4">
            <TextBlock Classes="UiError" Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}" />
            <TextBlock Classes="UiLabel" Text="{Binding PortfolioImportStatus}" IsVisible="{Binding HasPortfolioImportStatus}" />
            <TextBlock Classes="UiError" Text="{Binding PortfolioPostLimitHelperText}" IsVisible="{Binding IsSelectedPortfolioPostLimitExceeded}" />
        </StackPanel>
        <DataGrid Grid.Row="3" Margin="0" ItemsSource="{Binding Trades}"
                  Name="TradesGrid"
                  SelectionMode="Extended"
                  SelectionChanged="TradesGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Server" Binding="{Binding Server.Name}" />
                <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" />
                <DataGridTextColumn Header="Premium" Binding="{Binding PremiumStatusFormatted}" />
                <DataGridTextColumn Header="Received" Binding="{Binding DateTime, Mode=OneWay, Converter={x:Static views:UiValueConverters.LocalDateTime}}" SortMemberPath="DateTime" />
                <DataGridTextColumn Header="Type" Binding="{Binding TradeTypeFormatted}" />
                <DataGridTextColumn Header="Operation" Binding="{Binding TradeOperationFormatted}" />
                <DataGridTextColumn Header="Quality" Binding="{Binding QualityLevelFormatted}" />
                <DataGridTextColumn Header="Portfolio" Binding="{Binding UploadedToPortfolioFormatted}" />
                <DataGridTemplateColumn Header="Item" SortMemberPath="ItemName" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TradeRowViewModel">
                            <controls:ItemCell Classes="SingleLine" IconSize="30" ItemUniqueName="{Binding ItemId}" ImageQuality="{Binding ImageQuality}" Title="{Binding ItemName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Location" Binding="{Binding Location.FriendlyName}" />

                <DataGridTemplateColumn Header="Amount" CanUserSort="True" SortMemberPath="Amount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TradeRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Amount, Converter={x:Static views:UiValueConverters.WholeNumber}}" Classes="TableNumber" />
                                <TextBlock Text="{Binding OrderAmountFormatted}" Classes="UiLabel" VerticalAlignment="Center"
                                           IsVisible="{Binding IsPartialOrder}" ToolTip.Tip="Filled amount of the full order" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Unit silver" CanUserSort="True" SortMemberPath="UnitSilver">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TradeRowViewModel">
                            <TextBlock Text="{Binding UnitSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}" Classes="TableNumber" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Total silver" CanUserSort="True" SortMemberPath="TotalSilver">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TradeRowViewModel">
                            <TextBlock Text="{Binding TotalSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}" Classes="TableNumber" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <controls:EmptyState Grid.Row="3" IsVisible="{Binding Trades.Count, Converter={x:Static views:UiValueConverters.IsZero}}"
                             Message="No trades to show."
                             Hint="Market trades you make while the client runs appear here. If you expected some, check the filters above." />
        <Grid Grid.Row="4" ColumnDefinitions="*,150" MinHeight="42" Margin="0,6,0,0" ColumnSpacing="12">
            <!-- Each total copies as a plain number. -->
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Classes="UiLabel" Text="Selected:" Margin="0,0,4,0" VerticalAlignment="Center" />
                <Button Classes="UiGhost" Padding="4,2" Content="{Binding SelectedAmountTotal, Converter={x:Static views:UiValueConverters.WholeNumber}}"
                        Command="{Binding CopyValueCommand}" CommandParameter="{Binding SelectedAmountTotal}"
                        ToolTip.Tip="Copy" AutomationProperties.Name="Copy selected items" />
                <TextBlock Classes="UiLabel" Text="items" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Button Classes="UiGhost" Padding="4,2" Content="{Binding SelectedTotalSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}"
                        Command="{Binding CopyValueCommand}" CommandParameter="{Binding SelectedTotalSilver}"
                        ToolTip.Tip="Copy" AutomationProperties.Name="Copy selected silver" />
                <TextBlock Classes="UiLabel" Text="silver" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Classes="UiLabel" Text="Average:" VerticalAlignment="Center" />
                <Button Classes="UiGhost" Padding="4,2" Content="{Binding SelectedAverageSilver, Converter={x:Static views:UiValueConverters.WholeNumber}}"
                        Command="{Binding CopyValueCommand}" CommandParameter="{Binding SelectedAverageSilver}"
                        ToolTip.Tip="Copy" AutomationProperties.Name="Copy average silver" />
            </WrapPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsExporting}">
                <TextBlock Classes="UiLabel" Text="Exporting CSV…" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}" Height="4" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
