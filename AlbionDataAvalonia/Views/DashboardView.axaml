<UserControl
	x:Class="AlbionDataAvalonia.Views.DashboardView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
	xmlns:ui="using:AlbionDataAvalonia.Ui"
	xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
	d:DesignHeight="600"
	d:DesignWidth="860"
	x:DataType="vm:MainViewModel"
	Classes="AppPage"
	mc:Ignorable="d">

	<UserControl.Resources>
		<DataTemplate x:Key="SetupStepTemplate" x:DataType="vm:SetupStepViewModel">
			<Border Classes="Step" Classes.Current="{Binding HasHint}">
				<Grid ColumnDefinitions="Auto,*">
					<Grid Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
						<Ellipse Classes="UiStepState" Classes.Done="{Binding IsDone}" Classes.Stale="{Binding IsStale}" IsVisible="{Binding IsChecked}" />
						<Path IsVisible="{Binding IsChecked}" Data="M5,9.3 L7.9,12.1 L13.1,6.6" Stroke="White"
							  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
						<Ellipse Classes="UiStepState" Classes.Warning="{Binding IsWarning}" Classes.Blocked="{Binding IsBlocked}" IsVisible="{Binding NeedsAttention}" />
						<Canvas IsVisible="{Binding NeedsAttention}" Width="18" Height="18">
							<Path Data="M9,4.4 L9,10" Stroke="{DynamicResource UiOnAccentBrush}" StrokeThickness="2.2" StrokeLineCap="Round" />
							<Ellipse Canvas.Left="7.7" Canvas.Top="11.8" Width="2.6" Height="2.6" Fill="{DynamicResource UiOnAccentBrush}" />
						</Canvas>
						<Ellipse IsVisible="{Binding IsActive}" Margin="1" Stroke="{DynamicResource UiAccentTintBrush}" StrokeThickness="2" />
						<Path IsVisible="{Binding IsActive}" Data="M9,2 A7,7 0 1 1 2,9" Stroke="{DynamicResource UiAccentTextBrush}"
							  StrokeThickness="2" StrokeLineCap="Round" />
						<Ellipse IsVisible="{Binding IsPending}" Margin="1" Stroke="{DynamicResource UiTextDisabledBrush}" StrokeThickness="1.2"
								 StrokeDashArray="2,2" />
					</Grid>
					<StackPanel Grid.Column="1" Spacing="4">
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Classes="StepLabel" Classes.Pending="{Binding IsPending}" Text="{Binding Label}" />
							<TextBlock Grid.Column="1" Classes="StepValue" Classes.Pending="{Binding IsPending}"
									   Classes.Warning="{Binding IsWarning}" Classes.Blocked="{Binding IsBlocked}"
									   Classes.Stale="{Binding IsStale}" Text="{Binding Value}" />
						</Grid>
						<TextBlock Classes="UiLabel" MaxWidth="620" HorizontalAlignment="Left" IsVisible="{Binding HasHint}" Text="{Binding Hint}" />
						<Border Classes="UiCode" IsVisible="{Binding HasCode}">
							<SelectableTextBlock Text="{Binding Code}" />
						</Border>
						<ItemsControl IsVisible="{Binding HasActions}" ItemsSource="{Binding Actions}" Margin="0,4,0,2">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:SetupStepAction">
									<Button Classes="UiAction" Classes.UiPrimary="{Binding IsPrimary}" Margin="0,0,8,0"
											Content="{Binding Label}" Command="{Binding Command}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<!-- The setup checklist is the only list of its kind, so its row styles stay here. -->
	<UserControl.Styles>
		<Style Selector="Border.Step">
			<Setter Property="Padding" Value="10,8" />
			<Setter Property="CornerRadius" Value="{DynamicResource UiRadiusOverlay}" />
		</Style>
		<Style Selector="Border.Step.Current">
			<Setter Property="Background" Value="{DynamicResource UiHoverBrush}" />
		</Style>
		<Style Selector="TextBlock.StepLabel">
			<Setter Property="FontSize" Value="{DynamicResource UiFontSizeCompact}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,16,0" />
		</Style>
		<Style Selector="TextBlock.StepLabel.Pending">
			<Setter Property="Foreground" Value="{DynamicResource UiTextDisabledBrush}" />
		</Style>
		<Style Selector="TextBlock.StepValue">
			<Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
			<Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="TextAlignment" Value="Right" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style Selector="TextBlock.StepValue.Pending, TextBlock.StepValue.Stale">
			<Setter Property="Foreground" Value="{DynamicResource UiTextTertiaryBrush}" />
		</Style>
		<Style Selector="TextBlock.StepValue.Warning">
			<Setter Property="Foreground" Value="{DynamicResource UiWarningBrush}" />
		</Style>
		<Style Selector="TextBlock.StepValue.Blocked">
			<Setter Property="Foreground" Value="{DynamicResource UiDangerBrush}" />
		</Style>
		<Style Selector="Grid.DetailRow">
			<Setter Property="Margin" Value="0,3" />
		</Style>
		<Style Selector="Grid.DetailRow TextBlock">
			<Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
		</Style>
		<Style Selector="Grid.DetailRow.Dimmed">
			<Setter Property="Opacity" Value="{DynamicResource UiDisabledOpacity}" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="10,6,20,16" Spacing="14">

			<!--  SETUP: shown until the client knows the server, character and location  -->
			<StackPanel IsVisible="{Binding !Setup.ShowReadyView}" Spacing="12">
				<Grid ColumnDefinitions="Auto,*" Margin="0,4,0,2">
					<Grid Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
						<Grid IsVisible="{Binding Setup.HeroIsRadar}">
							<Ellipse Fill="{DynamicResource UiAccentTintSubtleBrush}" Stroke="{DynamicResource UiAccentEdgeBrush}" StrokeThickness="1.5" />
							<Ellipse Width="18" Height="18" Fill="{DynamicResource UiAccentTextBrush}" />
						</Grid>
						<Grid IsVisible="{Binding Setup.HeroIsIdle}">
							<Ellipse Fill="{DynamicResource UiHoverBrush}" Stroke="{DynamicResource UiBorderSubtleBrush}" StrokeThickness="1.5" />
							<Ellipse Width="18" Height="18" Fill="{DynamicResource UiTextTertiaryBrush}" />
						</Grid>
						<Grid IsVisible="{Binding Setup.HeroIsWarning}">
							<Ellipse Fill="{DynamicResource UiAccentTintBrush}" />
							<PathIcon Width="28" Height="28" Foreground="{DynamicResource UiWarningBrush}"
									  Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,7H13V13H11V7M11,15H13V17H11V15Z" />
						</Grid>
						<Grid IsVisible="{Binding Setup.HeroIsBlocked}">
							<Ellipse Fill="{DynamicResource UiDangerTintBrush}" />
							<PathIcon Width="28" Height="28" Foreground="{DynamicResource UiDangerBrush}"
									  Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,7H13V13H11V7M11,15H13V17H11V15Z" />
						</Grid>
						<Grid IsVisible="{Binding Setup.HeroIsZone}">
							<Ellipse Fill="{DynamicResource UiAccentTintBrush}" />
							<Canvas Width="32" Height="32">
								<Ellipse Canvas.Left="7" Canvas.Top="5" Width="12" Height="22" Stroke="{DynamicResource UiAccentTextBrush}" StrokeThickness="2.4" />
								<Path Data="M15,16 L28,16 M23,11 L28,16 L23,21" Stroke="{DynamicResource UiAccentTextBrush}" StrokeThickness="2.4"
									  StrokeLineCap="Round" StrokeJoin="Round" />
							</Canvas>
						</Grid>
					</Grid>
					<StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
						<TextBlock Classes="UiHeading" Text="{Binding Setup.HeroTitle}" />
						<TextBlock Classes="UiMuted" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeCompact}" Text="{Binding Setup.HeroText}" />
						<TextBlock Classes="UiLabel" Foreground="{DynamicResource UiTextTertiaryBrush}" Text="{Binding Setup.HeroMeta}" Margin="0,4,0,0"
								   IsVisible="{Binding Setup.HeroMeta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</StackPanel>
				</Grid>

				<ItemsControl ItemsSource="{Binding Setup.SetupSteps}" ItemTemplate="{StaticResource SetupStepTemplate}" />

				<Expander IsVisible="{Binding Setup.ShowTroubleshooting}"
						  IsExpanded="{Binding Setup.IsTroubleshootingOpen, Mode=TwoWay}">
					<Expander.Header>
						<TextBlock Classes="UiAccent" Text="{Binding Setup.TroubleshootingTitle}" FontWeight="SemiBold" />
					</Expander.Header>
					<ItemsControl ItemsSource="{Binding Setup.TroubleshootingSteps}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:TroubleshootingStep">
								<Grid ColumnDefinitions="22,*" Margin="0,3">
									<TextBlock Classes="UiMuted" Text="{Binding Number}" FontSize="{DynamicResource UiFontSizeCompact}" />
									<StackPanel Grid.Column="1" Spacing="5">
										<TextBlock FontSize="{DynamicResource UiFontSizeCompact}" TextWrapping="Wrap">
											<Run Text="{Binding Title}" FontWeight="SemiBold" />
											<Run Text="{Binding Text}" />
										</TextBlock>
										<Border Classes="UiCode" IsVisible="{Binding HasCode}">
											<SelectableTextBlock Text="{Binding Code}" />
										</Border>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Expander>
			</StackPanel>

			<!--  READY: everything detected  -->
			<StackPanel IsVisible="{Binding Setup.ShowReadyView}" Spacing="12">
				<controls:InfoBanner Classes="Stacked" IsVisible="{Binding ShowEncrypted}"
									 Title="Market orders are encrypted right now"
									 Message="The client can’t read buy and sell orders, so it can’t upload them. Other tracking continues.">
					<Button Classes="UiLink" FontSize="{DynamicResource UiFontSizeSmall}" Content="Updates on the AFM Discord" Command="{Binding OpenDiscordCommand}" />
				</controls:InfoBanner>
				<controls:InfoBanner IsVisible="{Binding Setup.IsLocationUnrecognized}"
									 Title="Unrecognized zone"
									 Message="Market uploads pause until you reach a city or another known zone." />

				<Border Classes="UiCard Subtle">
					<StackPanel Spacing="10">
						<Grid ColumnDefinitions="*,*,*">
							<StackPanel Spacing="2" Margin="0,0,12,0">
								<TextBlock Classes="UiCaption" Text="SERVER" />
								<TextBlock Classes="UiSectionTitle" TextTrimming="CharacterEllipsis" Text="{Binding AlbionServerName}" />
							</StackPanel>
							<StackPanel Grid.Column="1" Spacing="2" Margin="0,0,12,0">
								<TextBlock Classes="UiCaption" Text="CHARACTER" />
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Classes="UiSectionTitle" TextTrimming="CharacterEllipsis" Text="{Binding PlayerName}" VerticalAlignment="Center" />
									<Border Classes="UiBadge PremiumStatus" Classes.Premium="{Binding IsPremium}" Classes.NotPremium="{Binding IsNotPremium}">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<Image Width="16" Height="16" VerticalAlignment="Center" Source="/Assets/Icons/icon_shop_premium.png" Stretch="Uniform" />
											<TextBlock Text="{Binding PremiumStatusText}" />
										</StackPanel>
									</Border>
								</StackPanel>
								<TextBlock Classes="UiLabel" IsVisible="{Binding HasPlayerAffiliation}" Text="{Binding PlayerAffiliationText}" />
							</StackPanel>
							<StackPanel Grid.Column="2" Spacing="2">
								<TextBlock Classes="UiCaption" Text="LOCATION" />
								<TextBlock Classes="UiSectionTitle UiWarning" TextTrimming="CharacterEllipsis" Text="{Binding LocationName}"
										   IsVisible="{Binding Setup.IsLocationUnrecognized}" />
								<TextBlock Classes="UiSectionTitle" TextTrimming="CharacterEllipsis" Text="{Binding LocationName}" IsVisible="{Binding !Setup.IsLocationUnrecognized}" />
							</StackPanel>
						</Grid>
						<Rectangle Classes="UiDivider" />
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Ellipse Classes="UiStatusDot Ok" Width="7" Height="7" />
							<TextBlock Classes="UiLabel" Text="Live" VerticalAlignment="Center" />
						</StackPanel>
					</StackPanel>
				</Border>

				<Expander Classes="Bare">
					<Expander.Header>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Grid Width="16" Height="16" VerticalAlignment="Center">
								<Ellipse Fill="{DynamicResource UiSuccessBrush}" IsVisible="{Binding Setup.AllChecksPassed}" />
								<Path IsVisible="{Binding Setup.AllChecksPassed}" Data="M4.4,8.3 L7,10.8 L11.6,5.9" Stroke="White"
									  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
								<Ellipse Fill="{DynamicResource UiWarningBrush}" IsVisible="{Binding !Setup.AllChecksPassed}" />
								<TextBlock IsVisible="{Binding !Setup.AllChecksPassed}" Text="!" FontWeight="Bold" FontSize="{DynamicResource UiFontSizeCaption}"
										   Foreground="{DynamicResource UiOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Grid>
							<TextBlock Classes="UiMuted" Text="{Binding Setup.ChecksPassedText}" FontSize="{DynamicResource UiFontSizeCompact}" VerticalAlignment="Center" />
						</StackPanel>
					</Expander.Header>
					<ItemsControl ItemsSource="{Binding Setup.SetupSteps}" ItemTemplate="{StaticResource SetupStepTemplate}" />
				</Expander>

				<Grid ColumnDefinitions="*,12,*">
					<Border Classes="UiCard Bordered">
						<StackPanel Spacing="2">
							<TextBlock Classes="UiCaption" Text="PUBLIC · AODP" />
							<TextBlock Classes="UiValueLarge" Text="{Binding PublicUploadSuccessCount, StringFormat=N0}" />
							<WrapPanel>
								<TextBlock Classes="UiLabel" Text="uploads since start" />
								<TextBlock Classes="UiLabel UiWarning" IsVisible="{Binding HasPublicUploadFailures}"
										   Text="{Binding PublicUploadFailedCount, StringFormat=' · {0:N0} failed'}" />
							</WrapPanel>
						</StackPanel>
					</Border>
					<Border Grid.Column="2" Classes="UiCard Bordered">
						<StackPanel Spacing="2">
							<TextBlock Classes="UiCaption" Text="PRIVATE · AFM" />
							<StackPanel IsVisible="{Binding UserLoggedIn}" Spacing="2">
								<TextBlock Classes="UiValueLarge" Text="{Binding PrivateUploadSuccessCount, StringFormat=N0}" />
								<WrapPanel>
									<TextBlock Classes="UiLabel" Text="uploads since start" />
									<TextBlock Classes="UiLabel UiWarning" IsVisible="{Binding HasPrivateUploadFailures}"
											   Text="{Binding PrivateUploadFailedCount, StringFormat=' · {0:N0} failed'}" />
									<TextBlock Classes="UiLabel" IsVisible="{Binding UploadToAfmOnly}" Text=" · private mode on" />
								</WrapPanel>
							</StackPanel>
							<StackPanel IsVisible="{Binding !UserLoggedIn}" Spacing="2">
								<TextBlock Classes="UiValueLarge" Text="{x:Static ui:UiText.None}" Foreground="{DynamicResource UiTextDisabledBrush}" />
								<TextBlock Classes="UiLabel" Text="Sign in to upload specs, island data and private orders." />
							</StackPanel>
						</StackPanel>
					</Border>
				</Grid>

				<Expander Classes="Bare">
					<Expander.Header>
						<TextBlock Classes="UiMuted" Text="Upload details" FontSize="{DynamicResource UiFontSizeCompact}" />
					</Expander.Header>
					<Grid ColumnDefinitions="*,32,*" Margin="10,4,10,0">
						<StackPanel>
							<TextBlock Classes="UiCaption" Text="PUBLIC · AODP" Margin="0,0,0,4" />
							<Grid Classes="DetailRow" Classes.Dimmed="{Binding UploadToAfmOnly}" ColumnDefinitions="*,Auto">
								<TextBlock Text="Market offers" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedMarketOffersCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" Classes.Dimmed="{Binding UploadToAfmOnly}" ColumnDefinitions="*,Auto">
								<TextBlock Text="Market requests" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedMarketRequestsCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Gold histories" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedGoldHistoriesCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Monthly histories" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedMonthlyHistoriesCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Weekly histories" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedWeeklyHistoriesCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Daily histories" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedDailyHistoriesCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Bandit events" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedBanditEventsCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Festivities" />
								<TextBlock Grid.Column="1" Text="{Binding PublicUploadedFestivitiesCount, StringFormat=N0}" />
							</Grid>
						</StackPanel>
						<StackPanel Grid.Column="2">
							<TextBlock Classes="UiCaption" Text="PRIVATE · AFM" Margin="0,0,0,4" />
							<Grid Classes="DetailRow" Classes.Dimmed="{Binding !UploadToAfmOnly}" ColumnDefinitions="*,Auto">
								<TextBlock Text="Market offers" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateUploadedMarketOffersCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" Classes.Dimmed="{Binding !UploadToAfmOnly}" ColumnDefinitions="*,Auto">
								<TextBlock Text="Market requests" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateUploadedMarketRequestsCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Specs" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateUploadedAchievementsCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Global multipliers" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateUploadedGlobalMultipliersCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Estimated market values" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateUploadedItemEstimatedMarketValuesCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" ColumnDefinitions="*,Auto">
								<TextBlock Text="Festivities" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateUploadedFestivitiesCount, StringFormat=N0}" />
							</Grid>
							<Grid Classes="DetailRow" Classes.Dimmed="{Binding !UserSettings.AfmIslandTrackerEnabled}" ColumnDefinitions="*,Auto"
								  ToolTip.Tip="Successful uploads of island, plot and farming collection data during this client session.">
								<TextBlock Text="Island uploads" />
								<TextBlock Grid.Column="1" Text="{Binding PrivateIslandUploadsCount, StringFormat=N0}" />
							</Grid>
						</StackPanel>
					</Grid>
				</Expander>
			</StackPanel>

			<!--  FOOTER  -->
			<Border BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
				<Grid ColumnDefinitions="*,Auto,Auto,Auto">
					<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Ellipse Classes="UiStatusDot" Classes.Busy="{Binding IsUploading}" Width="7" Height="7" />
						<TextBlock Classes="UiLabel" Text="{Binding UploadStatusText}" VerticalAlignment="Center" />
					</StackPanel>
					<Button Grid.Column="1" Classes="UiGhost" FontSize="{DynamicResource UiFontSizeSmall}" Content="Logs" Command="{Binding ShowLogsCommand}" />
					<Button Grid.Column="2" Classes="UiGhost" FontSize="{DynamicResource UiFontSizeSmall}" Content="{Binding CopyDiagnosticsLabel}" Command="{Binding CopyDiagnosticsCommand}"
							ToolTip.Tip="Copies a report of your setup, adapters, uploads and recent warnings to paste in the AFM Discord. It leaves out your character, guild, email, IP address and file paths." />
					<Button Grid.Column="3" Classes="UiGhost" FontSize="{DynamicResource UiFontSizeSmall}" Content="Discord" Command="{Binding OpenDiscordCommand}" />
				</Grid>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
