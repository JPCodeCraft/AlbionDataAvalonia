<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AlbionDataAvalonia.Views.CsvExportOptionsWindow" Classes="AppPage"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Export to CSV"
        Icon="/Assets/logo.ico">

    <StackPanel Margin="20" Spacing="14">
        <TextBlock Classes="UiTitle" Text="Export to CSV" />
        <TextBlock Classes="UiMuted" Text="Choose the CSV separator and decimal symbol for this export." TextWrapping="Wrap" />

        <Border Classes="UiBanner Info">
            <StackPanel Spacing="6">
                <TextBlock x:Name="DefaultsTextBlock" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="UiLabel" Text="Separator" />
                <TextBox x:Name="SeparatorTextBox"
                         MinWidth="120"
                         MaxLength="4"
                         Watermark=","
                         AutomationProperties.Name="Separator"
                         TextChanged="Input_TextChanged" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="UiLabel" Text="Decimal symbol" />
                <TextBox x:Name="DecimalSymbolTextBox"
                         MinWidth="120"
                         MaxLength="4"
                         Watermark="."
                         AutomationProperties.Name="Decimal symbol"
                         TextChanged="Input_TextChanged" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ValidationTextBlock"
                   Classes="UiError"
                   IsVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="UiAction" Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
            <Button Classes="UiAction UiPrimary" Content="Continue" IsDefault="True" Click="ContinueButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
