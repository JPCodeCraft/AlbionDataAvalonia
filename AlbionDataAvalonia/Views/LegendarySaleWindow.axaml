<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
        xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="760"
        x:Class="AlbionDataAvalonia.Views.LegendarySaleWindow" Classes="AppPage"
        x:DataType="vm:LegendaryItemRowViewModel"
        Width="500"
        MaxHeight="820"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="List awakened item for sale"
        Icon="/Assets/logo.ico">

    <Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,0,8,0">
                <Border Classes="UiCard Sunken Outlined">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="PriceTextBox"
                                     FontSize="{DynamicResource UiFontSizeHeading}"
                                     FontWeight="SemiBold"
                                     Watermark="Asking price"
                                     MaxLength="18" />
                            <TextBlock Grid.Column="1"
                                       Classes="UiSectionTitle"
                                       Text="silver"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="ListingSubtitleTextBlock"
                                   Classes="UiLabel" />

                        <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="10">
                            <Border Width="64"
                                    Height="64"
                                    Background="{DynamicResource UiSurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource UiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource UiRadiusOverlay}">
                                <Image Margin="2"
                                       Stretch="Uniform"
                                       items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}"
                                       items:LazyItemImage.Quality="{Binding ImageQuality}" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{Binding ItemName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="UiLabel"
                                           Text="{Binding Quality}"
                                           Foreground="{DynamicResource UiQualityTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                <TextBlock Classes="UiValue"
                                           Text="★"
                                           Foreground="{DynamicResource UiRatingBrush}" />
                                <TextBlock Classes="UiValue" Text="{Binding LegendaryRating}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="UiLabel" Text="Attuned to" />
                                <TextBlock Text="{Binding AttunedTo}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="UiLabel" Text="Strain" />
                                <TextBlock Text="{Binding Strain}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="UiLabel" Text="PvP fame" />
                                <TextBlock Text="{Binding PvPFameGained}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="7">
                            <TextBlock Classes="UiSectionTitle" Text="Traits" />
                            <TextBlock Classes="UiMuted"
                                       Text="No traits"
                                       IsVisible="{Binding !HasTraits}" />
                            <ItemsControl ItemsSource="{Binding Traits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LegendaryTraitRowViewModel">
                                        <StackPanel Spacing="4" Margin="0,0,0,7">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                                <TextBlock Text="{Binding Value}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2"
                                                           Classes="UiMuted"
                                                           Text="{Binding Rarity}" />
                                            </Grid>
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding RollPercentage}"
                                                         Height="5"
                                                         Foreground="{DynamicResource UiTraitRollBrush}"
                                                         Background="{DynamicResource UiNeutralFillBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Button x:Name="CalculatorButton"
                                Classes="UiAction"
                                Content="View in calculator"
                                Click="CalculatorButton_Click" />

                        <StackPanel Spacing="4">
                            <TextBlock Classes="UiLabel" Text="In-game contact" />
                            <TextBox x:Name="InGameNameTextBox"
                                     Watermark="Albion character name"
                                     MaxLength="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="UiCard Sunken Outlined">
                    <StackPanel Spacing="7">
                        <TextBlock x:Name="DeliveryTitleTextBlock"
                                   Classes="UiSectionTitle"
                                   Text="Where this listing will appear" />
                        <TextBlock x:Name="WebsiteStatusTextBlock"
                                   Text="AFM website — Will be listed"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DiscordStatusTextBlock"
                                   Text="Discord — AFM will attempt an automatic post"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DiscordHelpTextBlock"
                                   Classes="UiLabel"
                                   Text="For the automatic Discord post, make sure Discord is linked on your AFM account and that you have joined the AFM Discord server." />
                        <WrapPanel x:Name="DiscordSetupButtonsPanel">
                            <Button x:Name="AccountLinkButton"
                                    Classes="UiAction"
                                    Content="Check AFM account"
                                    Margin="0,0,8,0"
                                    Click="AccountLinkButton_Click" />
                            <Button x:Name="DiscordInviteButton"
                                    Classes="UiAction"
                                    Content="Open AFM Discord"
                                    Click="DiscordInviteButton_Click" />
                        </WrapPanel>
                        <Button x:Name="OpenDiscordPostButton"
                                Classes="UiAction"
                                Content="Open Discord post"
                                HorizontalAlignment="Left"
                                IsVisible="False"
                                Click="OpenDiscordPostButton_Click" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationTextBlock"
                           Classes="UiError" />
                <ProgressBar x:Name="PostingProgressBar"
                             IsIndeterminate="True"
                             IsVisible="False" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CancelButton"
                    Classes="UiAction"
                    Content="Cancel"
                    MinWidth="90"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button x:Name="SubmitButton"
                    Classes="UiAction UiPrimary"
                    Content="List for sale"
                    MinWidth="130"
                    IsDefault="True"
                    Click="SubmitButton_Click" />
        </StackPanel>
    </Grid>
</Window>
