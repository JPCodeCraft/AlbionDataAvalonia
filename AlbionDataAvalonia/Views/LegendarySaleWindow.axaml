<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
        xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
        xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="760"
        x:Class="AlbionDataAvalonia.Views.LegendarySaleWindow" Classes="AppPage"
        x:DataType="vm:LegendarySaleViewModel"
        Width="500"
        MaxHeight="820"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Icon="/Assets/logo.ico">

    <Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,0,8,0">
                <Border Classes="UiCard Sunken Outlined">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding PriceText}"
                                     IsEnabled="{Binding CanEditInputs}"
                                     AutomationProperties.Name="Asking price in silver"
                                     FontSize="{DynamicResource UiFontSizeHeading}"
                                     FontWeight="SemiBold"
                                     Watermark="Asking price"
                                     MaxLength="18" />
                            <TextBlock Grid.Column="1"
                                       Classes="UiSectionTitle"
                                       Text="silver"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Classes="UiLabel" Text="{Binding Subtitle}" />

                        <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="10">
                            <Border Width="64"
                                    Height="64"
                                    Background="{DynamicResource UiSurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource UiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource UiRadiusOverlay}">
                                <Image Margin="2"
                                       Stretch="Uniform"
                                       items:LazyItemImage.ItemUniqueName="{Binding Item.ItemUniqueName}"
                                       items:LazyItemImage.Quality="{Binding Item.ImageQuality}" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{Binding Item.ItemName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="UiLabel"
                                           Text="{Binding Item.Quality}"
                                           Foreground="{DynamicResource UiQualityTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                <TextBlock Classes="UiValue"
                                           Text="★"
                                           Foreground="{DynamicResource UiRatingBrush}" />
                                <TextBlock Classes="UiValue" Text="{Binding Item.LegendaryRating}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <controls:StatTile Classes="Text" Label="Attuned to" Value="{Binding Item.AttunedTo}" />
                            <controls:StatTile Grid.Column="1" Classes="Text" Label="Strain" Value="{Binding Item.Strain}" />
                            <controls:StatTile Grid.Column="2" Classes="Text" Label="PvP fame" Value="{Binding Item.PvPFameGained}" />
                        </Grid>

                        <StackPanel Spacing="7">
                            <TextBlock Classes="UiSectionTitle" Text="Traits" />
                            <controls:EmptyState Classes="Inline" Message="No traits." IsVisible="{Binding !Item.HasTraits}" />
                            <ItemsControl ItemsSource="{Binding Item.Traits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LegendaryTraitRowViewModel">
                                        <StackPanel Spacing="4" Margin="0,0,0,7">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                                <TextBlock Text="{Binding Value}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2"
                                                           Classes="UiMuted"
                                                           Text="{Binding Rarity}" />
                                            </Grid>
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding RollPercentage}"
                                                         Height="5"
                                                         Foreground="{DynamicResource UiTraitRollBrush}"
                                                         Background="{DynamicResource UiNeutralFillBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Button Classes="UiAction"
                                Content="View in calculator"
                                IsVisible="{Binding Item.CanViewInCalculator}"
                                IsEnabled="{Binding !IsPosting}"
                                Command="{Binding OpenCalculatorCommand}" />

                        <StackPanel Spacing="4">
                            <TextBlock Classes="UiLabel" Text="In-game contact" />
                            <TextBox Text="{Binding InGameName}"
                                     IsEnabled="{Binding CanEditInputs}"
                                     AutomationProperties.Name="In-game contact"
                                     Watermark="Albion character name"
                                     MaxLength="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="UiCard Sunken Outlined">
                    <StackPanel Spacing="7">
                        <TextBlock Classes="UiSectionTitle" Text="{Binding DeliveryTitle}" />
                        <TextBlock Text="{Binding WebsiteStatus}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DiscordStatus}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="UiLabel" Text="{Binding DiscordHelp}" />
                        <WrapPanel IsVisible="{Binding ShowDiscordSetup}">
                            <Button Classes="UiAction"
                                    Content="Check AFM account"
                                    Margin="0,0,8,0"
                                    IsVisible="{Binding ShowAccountLink}"
                                    Command="{Binding OpenAccountCommand}" />
                            <Button Classes="UiAction"
                                    Content="Open AFM Discord"
                                    IsVisible="{Binding ShowDiscordInvite}"
                                    Command="{Binding OpenDiscordInviteCommand}" />
                        </WrapPanel>
                        <Button Classes="UiAction"
                                Content="Open Discord post"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding ShowOpenDiscordPost}"
                                Command="{Binding OpenDiscordPostCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="UiError"
                           Text="{Binding ValidationText}"
                           IsVisible="{Binding ValidationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPosting}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Classes="UiAction"
                    Content="{Binding CancelText}"
                    MinWidth="90"
                    IsCancel="True"
                    IsEnabled="{Binding !IsPosting}"
                    Command="{Binding CancelCommand}" />
            <Button Classes="UiAction UiPrimary"
                    Content="{Binding SubmitText}"
                    MinWidth="130"
                    IsDefault="True"
                    IsVisible="{Binding ShowSubmit}"
                    IsEnabled="{Binding !IsPosting}"
                    Command="{Binding SubmitCommand}" />
        </StackPanel>
    </Grid>
</Window>
