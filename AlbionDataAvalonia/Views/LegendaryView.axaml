<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="AlbionDataAvalonia.Views.LegendaryView"
             x:DataType="vm:LegendaryViewModel"
             Classes="AppPage">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
        <WrapPanel Margin="0,8,0,8"
                   VerticalAlignment="Top">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Search" Classes="UiLabel" />
                <TextBox Text="{Binding FilterText}" Width="260" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Server" Classes="UiLabel" />
                <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Width="140" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Ownership" Classes="UiLabel" />
                <CheckBox Content="Attuned to me"
                          IsChecked="{Binding OnlyAttunedToMe}"
                          IsEnabled="{Binding CanFilterAttunedToMe}"
                          ToolTip.Tip="{Binding AttunedToMeHint}"
                          ToolTip.ShowOnDisabled="True"
                          MinHeight="36"
                          VerticalContentAlignment="Center"
                          Padding="8,0,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Sale status" Classes="UiLabel" />
                <ComboBox ItemsSource="{Binding SaleStatuses}"
                          SelectedItem="{Binding SelectedSaleStatus}"
                          Width="140" />
            </StackPanel>
            <Button Content="Refresh" Classes="UiAction" Command="{Binding RefreshCommand}"
                    VerticalAlignment="Bottom" Margin="0,0,10,0" />
            <Button Content="Delete selected…"
                    Classes="UiAction UiDanger"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding HasSelectedItem}"
                    Click="DeleteSelectedButton_Click" />
        </WrapPanel>

        <TextBlock Grid.Row="1"
                   Classes="UiError"
                   Margin="2,0,2,8"
                   Text="{Binding LoadError}"
                   IsVisible="{Binding HasLoadError}" />

        <Grid Grid.Row="2"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="380" />
            </Grid.ColumnDefinitions>
            <DataGrid Name="LegendaryItemsGrid"
                      Grid.Column="0"
                      IsVisible="{Binding HasItems}"
                      RowHeight="52"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Extended"
                      FontSize="{DynamicResource UiFontSizeSmall}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" />
                    <DataGridTemplateColumn Header="Item" SortMemberPath="ItemName" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:LegendaryItemRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="28" Height="28" Stretch="Uniform"
                                           items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}"
                                           items:LazyItemImage.Quality="{Binding ImageQuality}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemName}" />
                                        <TextBlock Classes="UiFine" Text="{Binding Quality}" />
                                        <TextBlock Classes="UiFine"
                                                   Text="{Binding SoulName}"
                                                   IsVisible="{Binding HasSoulName}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Attuned to" Binding="{Binding AttunedTo}" SortMemberPath="Source.AttunedToPlayerName" />
                    <DataGridTextColumn Header="Rating" Binding="{Binding LegendaryRating}" SortMemberPath="LegendaryRatingValue" />
                    <DataGridTextColumn Header="Strain" Binding="{Binding Strain}" SortMemberPath="Source.Strain" />
                    <DataGridTextColumn Header="PvP fame" Binding="{Binding PvPFameGained}" SortMemberPath="Source.PvPFameGained" />
                    <DataGridTextColumn Header="Attunement spent" Binding="{Binding AttunementSpent}" SortMemberPath="Source.AttunementSpent" />
                    <DataGridTextColumn Header="Last seen" Binding="{Binding Source.LastSeenAtUtc, Mode=OneWay, Converter={x:Static views:UiValueConverters.LocalDateTime}}" SortMemberPath="Source.LastSeenAtUtc" />
                    <DataGridTextColumn Header="Sale status" Binding="{Binding SaleState}" SortMemberPath="SaleState" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Classes="UiCard Subtle"
                    IsVisible="{Binding HasItems}"
                    MinWidth="280"
                    MaxWidth="380"
                    Padding="10">
                <Grid>
                    <TextBlock Classes="UiMuted"
                               Text="Select an item to view its details."
                               IsVisible="{Binding !HasSelectedItem}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                    <ScrollViewer IsVisible="{Binding HasSelectedItem}">
                        <StackPanel Spacing="10" Margin="0,0,10,0">
                            <Border Classes="UiCard">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="UiTitle" Text="{Binding SelectedItem.ItemName}" />
                                    <TextBlock Classes="UiMuted"
                                               Text="{Binding SelectedItem.SoulName}"
                                               IsVisible="{Binding SelectedItem.HasSoulName}"
                                               FontStyle="Italic"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                                        <Image Width="48"
                                               Height="48"
                                               Stretch="Uniform"
                                               items:LazyItemImage.ItemUniqueName="{Binding SelectedItem.ItemUniqueName}"
                                               items:LazyItemImage.Quality="{Binding SelectedItem.ImageQuality}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <WrapPanel>
                                                <TextBlock Classes="UiFine" Text="{Binding SelectedItem.ServerName}" Margin="0,0,8,0" />
                                                <TextBlock Classes="UiFine" Text="{Binding SelectedItem.Quality}" Foreground="{DynamicResource UiQualityTextBrush}" />
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Rating" Classes="UiLabel" VerticalAlignment="Center" />
                                                <TextBlock Classes="UiSectionTitle"
                                                           Text="{Binding SelectedItem.LegendaryRating}"
                                                           Foreground="{DynamicResource UiRatingBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="View in calculator"
                                                Classes="UiAction"
                                                Tag="{Binding SelectedItem.CalculatorUrl}"
                                                IsEnabled="{Binding SelectedItem.CanViewInCalculator}"
                                                Click="OpenCalculatorButton_Click"
                                                Margin="0,0,8,0" />
                                        <Button Name="ListForSaleButton"
                                                Classes="UiAction"
                                                Content="{Binding SelectedItem.SaleActionText, TargetNullValue='List for sale'}"
                                                IsEnabled="{Binding CanListSelectedItem}"
                                                Click="ListForSaleButton_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SaleStatus}" Classes="UiLabel" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="10"
                                  DataContext="{Binding SelectedItem}">
                                <Border Grid.Row="2" Classes="UiCard">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Classes="UiSectionTitle" Text="Sale listing" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="UiBadge" IsVisible="{Binding !HasListing}">
                                                <TextBlock Text="Not listed" />
                                            </Border>
                                            <Border Grid.Column="1" Classes="UiBadge Success" IsVisible="{Binding IsActiveListing}">
                                                <TextBlock Text="Active" />
                                            </Border>
                                            <Border Grid.Column="1" Classes="UiBadge Warning" IsVisible="{Binding IsSold}">
                                                <TextBlock Text="Sold" />
                                            </Border>
                                            <Border Grid.Column="1" Classes="UiBadge Danger" IsVisible="{Binding IsCanceled}">
                                                <TextBlock Text="Canceled" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Classes="UiMuted"
                                                   Text="{Binding SaleStatusSummary}"
                                                   TextWrapping="Wrap" />

                                        <Grid IsVisible="{Binding HasListing}"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock Classes="UiLabel" Text="Current price" />
                                                <TextBlock Classes="UiValue" Text="{Binding LatestPrice}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="UiLabel" Text="Last listed" />
                                                <TextBlock Text="{Binding Listing.LastListedAt, Converter={x:Static views:UiValueConverters.LocalDateTime}}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel IsVisible="{Binding HasListing}">
                                            <CheckBox Name="SoldCheckBox"
                                                      Content="Mark as sold"
                                                      IsVisible="{Binding !IsCanceled}"
                                                      IsChecked="{Binding IsSold, Mode=OneWay}"
                                                      IsEnabled="{Binding CanChangeSold}"
                                                      Click="SoldCheckBox_Click"
                                                      Margin="0,0,12,0" />
                                            <Button Content="Cancel listing"
                                                    Classes="UiAction"
                                                    IsVisible="{Binding IsActiveListing}"
                                                    Click="CancelListingButton_Click" />
                                        </WrapPanel>

                                        <Expander Header="{Binding SellOrdersHeading}"
                                                  IsVisible="{Binding HasListing}"
                                                  IsExpanded="False"
                                                  HorizontalContentAlignment="Stretch">

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Classes="UiMuted"
                                                           Text="No sale orders have been recorded."
                                                           IsVisible="{Binding !HasSellOrders}"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding SellOrders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LegendarySellOrderRowViewModel">
                                                            <Border Classes="UiCard Outlined" Margin="0,0,0,8">
                                                                <StackPanel Spacing="7">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <StackPanel>
                                                                            <TextBlock Classes="UiSectionTitle" Text="{Binding Price}" />
                                                                            <TextBlock Classes="UiFine" Text="{Binding Source.CreatedAt, Converter={x:Static views:UiValueConverters.LocalDateTime}}" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="1" Classes="UiBadge Dark" VerticalAlignment="Top">
                                                                            <TextBlock Classes="UiAccent" Text="{Binding OrderLabel}" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Classes="UiLabel" Text="Contact" />
                                                                        <TextBlock Text="{Binding Contact}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <Border Classes="UiCard Subtle" Padding="8,5">
                                                                        <TextBlock Classes="UiFine" Text="{Binding DiscordStatus}" />
                                                                    </Border>
                                                                    <Button Content="Open Discord post"
                                                                            Classes="UiAction"
                                                                            Tag="{Binding MessageUrl}"
                                                                            IsVisible="{Binding HasDiscordPost}"
                                                                            Click="OpenDiscordPostButton_Click"
                                                                            HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Classes="UiCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="UiSectionTitle" Text="Traits" />
                                        <TextBlock Classes="UiMuted" Text="No traits" IsVisible="{Binding !HasTraits}" />
                                        <ItemsControl ItemsSource="{Binding Traits}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LegendaryTraitRowViewModel">
                                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Classes="UiMuted" Text="{Binding Rarity}" />
                                                        </Grid>
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding RollPercentage}"
                                                                     Height="5"
                                                                     Foreground="{DynamicResource UiTraitRollBrush}"
                                                                     Background="{DynamicResource UiNeutralFillBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Classes="UiCard">
                                    <StackPanel Spacing="9">
                                        <TextBlock Classes="UiSectionTitle" Text="Awakened stats" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                                            <StackPanel>
                                                <TextBlock Classes="UiLabel" Text="Attuned to" />
                                                <TextBlock Text="{Binding AttunedTo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="UiLabel" Text="Strain" />
                                                <TextBlock Text="{Binding Strain}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Classes="UiLabel" Text="PvP fame gained" />
                                                <TextBlock Text="{Binding PvPFameGained}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Classes="UiLabel" Text="Attunement" />
                                                <TextBlock Text="{Binding Attunement}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                                <TextBlock Classes="UiLabel" Text="Attunement spent" />
                                                <TextBlock Text="{Binding AttunementSpent}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Expander Grid.Row="3" Header="Other details" IsExpanded="False" HorizontalContentAlignment="Stretch">
                                    <Border Classes="UiCard">
                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowSpacing="6">
                                            <TextBlock Grid.Row="0" Classes="UiLabel" Text="Crafter" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Source.CrafterName, TargetNullValue=Unknown}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Classes="UiLabel" Text="Location" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Location}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Classes="UiLabel" Text="First seen" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source.FirstSeenAtUtc, Converter={x:Static views:UiValueConverters.LocalDateTime}}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Classes="UiLabel" Text="Last seen" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Source.LastSeenAtUtc, Converter={x:Static views:UiValueConverters.LocalDateTime}}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="4" Classes="UiLabel" Text="Item ID" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ItemUniqueName}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Expander>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <TextBlock Grid.ColumnSpan="2" Text="{Binding EmptyStateText}"
                       IsVisible="{Binding !HasItems}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Classes="UiLabel" TextAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
