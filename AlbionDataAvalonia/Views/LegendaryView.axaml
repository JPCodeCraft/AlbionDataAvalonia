<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:items="clr-namespace:AlbionDataAvalonia.Items"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="AlbionDataAvalonia.Views.LegendaryView"
             x:DataType="vm:LegendaryViewModel"
             Classes="AppPage">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
        <WrapPanel Margin="0,8,0,8"
                   VerticalAlignment="Top"
                   IsVisible="{Binding !IsAwakeningItemsTrackerDisabled}">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Search" Classes="UiLabel" />
                <TextBox Text="{Binding FilterText}" Width="260" Padding="8" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Server" Classes="UiLabel" />
                <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Width="140" Padding="8" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Ownership" Classes="UiLabel" />
                <CheckBox Content="Attuned to me"
                          IsChecked="{Binding OnlyAttunedToMe}"
                          IsEnabled="{Binding CanFilterAttunedToMe}"
                          Padding="0,4" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Sale status" Classes="UiLabel" />
                <ComboBox ItemsSource="{Binding SaleStatuses}"
                          SelectedItem="{Binding SelectedSaleStatus}"
                          Width="140"
                          Padding="8" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Height="18" />
                <Button Content="Reload" Classes="UiAction UiSecondary" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Height="18" />
                <Button Content="Delete selected..."
                        Classes="UiAction UiSecondary"
                        IsEnabled="{Binding HasSelectedItem}"
                        Click="DeleteSelectedButton_Click" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Grid.Row="1"
                   Margin="2,0,2,8"
                   Text="{Binding LoadError}"
                   FontSize="11"
                   IsVisible="{Binding HasLoadError}"
                   Foreground="#FFB4A8"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2"
              ColumnSpacing="12"
              IsVisible="{Binding !IsAwakeningItemsTrackerDisabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="380" />
            </Grid.ColumnDefinitions>
            <DataGrid Name="LegendaryItemsGrid"
                      Grid.Column="0"
                      IsVisible="{Binding HasItems}"
                      RowHeight="52"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      FontSize="11">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" />
                    <DataGridTemplateColumn Header="Item" SortMemberPath="ItemName" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:LegendaryItemRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="28" Height="28" Stretch="Uniform"
                                           items:LazyItemImage.ItemUniqueName="{Binding ItemUniqueName}"
                                           items:LazyItemImage.Quality="{Binding ImageQuality}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemName}" FontSize="11" />
                                        <TextBlock Text="{Binding Quality}"
                                                   FontSize="10"
                                                   Opacity="0.65" />
                                        <TextBlock Text="{Binding SoulName}"
                                                   IsVisible="{Binding HasSoulName}"
                                                   FontSize="10"
                                                   Opacity="0.65" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Attuned to" Binding="{Binding AttunedTo}" SortMemberPath="Source.AttunedToPlayerName" />
                    <DataGridTextColumn Header="Rating" Binding="{Binding LegendaryRating}" SortMemberPath="LegendaryRatingValue" />
                    <DataGridTextColumn Header="Strain" Binding="{Binding Strain}" SortMemberPath="Source.Strain" />
                    <DataGridTextColumn Header="PvP fame" Binding="{Binding PvPFameGained}" SortMemberPath="Source.PvPFameGained" />
                    <DataGridTextColumn Header="Attunement spent" Binding="{Binding AttunementSpent}" SortMemberPath="Source.AttunementSpent" />
                    <DataGridTextColumn Header="Last seen" Binding="{Binding Source.LastSeenAtUtc, Converter={x:Static views:UiValueConverters.LocalDateTime}}" SortMemberPath="Source.LastSeenAtUtc" />
                    <DataGridTextColumn Header="Sale status" Binding="{Binding SaleState}" SortMemberPath="SaleState" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    IsVisible="{Binding HasItems}"
                    MinWidth="280"
                    MaxWidth="380"
                    Background="rgba(255,255,255,0.025)"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <TextBlock Text="Select an item to view its details."
                               IsVisible="{Binding !HasSelectedItem}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.7" />
                    <ScrollViewer IsVisible="{Binding HasSelectedItem}">
                        <StackPanel Spacing="10" Margin="0,0,10,0">
                            <Border Classes="UiCard">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding SelectedItem.ItemName}"
                                               FontSize="17"
                                               FontWeight="DemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedItem.SoulName}"
                                               IsVisible="{Binding SelectedItem.HasSoulName}"
                                               FontStyle="Italic"
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                                        <Image Width="48"
                                               Height="48"
                                               Stretch="Uniform"
                                               items:LazyItemImage.ItemUniqueName="{Binding SelectedItem.ItemUniqueName}"
                                               items:LazyItemImage.Quality="{Binding SelectedItem.ImageQuality}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding SelectedItem.ServerName}" FontSize="11" Opacity="0.7" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding SelectedItem.Quality}" FontSize="11" Foreground="#F0B94A" />
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Rating" Classes="UiLabel" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedItem.LegendaryRating}"
                                                           FontSize="16"
                                                           FontWeight="DemiBold"
                                                           Foreground="#F0A21B" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="View in calculator"
                                                Classes="UiAction UiSecondary"
                                                Tag="{Binding SelectedItem.CalculatorUrl}"
                                                IsEnabled="{Binding SelectedItem.CanViewInCalculator}"
                                                Click="OpenCalculatorButton_Click"
                                                Margin="0,0,8,0"
                                                Padding="10,6" />
                                        <Button Name="ListForSaleButton"
                                                Classes="UiAction UiSecondary"
                                                Content="{Binding SelectedItem.SaleActionText, TargetNullValue='List for sale'}"
                                                IsEnabled="{Binding CanListSelectedItem}"
                                                Click="ListForSaleButton_Click"
                                                Padding="10,6" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SaleStatus}" Classes="UiLabel" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="10"
                                  DataContext="{Binding SelectedItem}">
                                <Border Grid.Row="2" Classes="UiCard">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Classes="UiSectionTitle" Text="Sale listing" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#4B4B4B" CornerRadius="10" Padding="9,3" IsVisible="{Binding !HasListing}">
                                                <TextBlock Text="Not listed" FontSize="11" FontWeight="DemiBold" />
                                            </Border>
                                            <Border Grid.Column="1" Background="#356B3D" CornerRadius="10" Padding="9,3" IsVisible="{Binding IsActiveListing}">
                                                <TextBlock Text="Active" FontSize="11" FontWeight="DemiBold" />
                                            </Border>
                                            <Border Grid.Column="1" Background="#7A6230" CornerRadius="10" Padding="9,3" IsVisible="{Binding IsSold}">
                                                <TextBlock Text="Sold" FontSize="11" FontWeight="DemiBold" />
                                            </Border>
                                            <Border Grid.Column="1" Background="#70413D" CornerRadius="10" Padding="9,3" IsVisible="{Binding IsCanceled}">
                                                <TextBlock Text="Canceled" FontSize="11" FontWeight="DemiBold" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding SaleStatusSummary}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.8" />

                                        <Grid IsVisible="{Binding HasListing}"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock Classes="UiLabel" Text="Current price" />
                                                <TextBlock Text="{Binding LatestPrice}"
                                                           FontSize="17"
                                                           FontWeight="DemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="UiLabel" Text="Last listed" />
                                                <TextBlock Text="{Binding Listing.LastListedAt, Converter={x:Static views:UiValueConverters.LocalDateTime}}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel IsVisible="{Binding HasListing}">
                                            <CheckBox Name="SoldCheckBox"
                                                      Content="Mark as sold"
                                                      IsVisible="{Binding !IsCanceled}"
                                                      IsChecked="{Binding IsSold, Mode=OneWay}"
                                                      IsEnabled="{Binding CanChangeSold}"
                                                      Click="SoldCheckBox_Click"
                                                      Margin="0,0,12,0" />
                                            <Button Content="Cancel listing"
                                                    Classes="UiAction UiSecondary"
                                                    IsVisible="{Binding IsActiveListing}"
                                                    Click="CancelListingButton_Click"
                                                    Padding="8,4" />
                                        </WrapPanel>

                                        <Expander Header="{Binding SellOrdersHeading}"
                                                  IsVisible="{Binding HasListing}"
                                                  IsExpanded="False"
                                                  HorizontalContentAlignment="Stretch">

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="No sale orders have been recorded."
                                                           IsVisible="{Binding !HasSellOrders}"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding SellOrders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LegendarySellOrderRowViewModel">
                                                            <Border Classes="UiCard" Margin="0,0,0,8" BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="1">
                                                                <StackPanel Spacing="7">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Price}"
                                                                                       FontSize="16"
                                                                                       FontWeight="DemiBold" />
                                                                            <TextBlock Text="{Binding Source.CreatedAt, Converter={x:Static views:UiValueConverters.LocalDateTime}}"
                                                                                       FontSize="11"
                                                                                       Opacity="0.65" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="1"
                                                                                Background="#303030"
                                                                                CornerRadius="8"
                                                                                Padding="7,2"
                                                                                VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding OrderLabel}"
                                                                                       FontSize="10"
                                                                                       Foreground="#FFB74D" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Classes="UiLabel" Text="Contact" />
                                                                        <TextBlock Text="{Binding Contact}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <Border Background="rgba(255,255,255,0.055)"
                                                                            CornerRadius="5"
                                                                            Padding="8,5">
                                                                        <TextBlock Text="{Binding DiscordStatus}"
                                                                                   FontSize="11"
                                                                                   TextWrapping="Wrap" />
                                                                    </Border>
                                                                    <Button Content="Open Discord post"
                                                                            Classes="UiAction UiSecondary"
                                                                            Tag="{Binding MessageUrl}"
                                                                            IsVisible="{Binding HasDiscordPost}"
                                                                            Click="OpenDiscordPostButton_Click"
                                                                            HorizontalAlignment="Left"
                                                                            Padding="8,4" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Classes="UiCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="UiSectionTitle" Text="Traits" />
                                        <TextBlock Text="No traits" IsVisible="{Binding !HasTraits}" Opacity="0.65" />
                                        <ItemsControl ItemsSource="{Binding Traits}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LegendaryTraitRowViewModel">
                                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                            <TextBlock Text="{Binding Value}" FontWeight="DemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Rarity}" Opacity="0.65" />
                                                        </Grid>
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding RollPercentage}"
                                                                     Height="5"
                                                                     Foreground="#79B83A"
                                                                     Background="rgba(255,255,255,0.14)" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Classes="UiCard">
                                    <StackPanel Spacing="9">
                                        <TextBlock Classes="UiSectionTitle" Text="Awakened stats" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                                            <StackPanel>
                                                <TextBlock Classes="UiLabel" Text="Attuned to" />
                                                <TextBlock Text="{Binding AttunedTo}" FontWeight="DemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="UiLabel" Text="Strain" />
                                                <TextBlock Text="{Binding Strain}" FontWeight="DemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Classes="UiLabel" Text="PvP fame gained" />
                                                <TextBlock Text="{Binding PvPFameGained}" FontWeight="DemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Classes="UiLabel" Text="Attunement" />
                                                <TextBlock Text="{Binding Attunement}" FontWeight="DemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                                <TextBlock Classes="UiLabel" Text="Attunement spent" />
                                                <TextBlock Text="{Binding AttunementSpent}" FontWeight="DemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Expander Grid.Row="3" Header="Other details" IsExpanded="False" HorizontalContentAlignment="Stretch">
                                    <Border Classes="UiCard">
                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowSpacing="6">
                                            <TextBlock Grid.Row="0" Classes="UiLabel" Text="Crafter" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Source.CrafterName, TargetNullValue=Unknown}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Classes="UiLabel" Text="Location" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Location}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Classes="UiLabel" Text="First seen" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source.FirstSeenAtUtc, Converter={x:Static views:UiValueConverters.LocalDateTime}}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Classes="UiLabel" Text="Last seen" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Source.LastSeenAtUtc, Converter={x:Static views:UiValueConverters.LocalDateTime}}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="4" Classes="UiLabel" Text="Item ID" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ItemUniqueName}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Expander>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <TextBlock Grid.ColumnSpan="2" Text="{Binding EmptyStateText}"
                       IsVisible="{Binding !HasItems}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Classes="UiLabel" TextAlignment="Center" />
        </Grid>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsAwakeningItemsTrackerDisabled}"
              Background="{DynamicResource ThemeBackgroundBrush}"
              Panel.ZIndex="10">
            <Border MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ThemeBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Awakened items tracker is disabled"
                               FontSize="18"
                               FontWeight="DemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="Enable it in Settings &gt; Awakened to resume detecting and storing awakened items."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
