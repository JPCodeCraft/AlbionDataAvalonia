<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:logging="clr-namespace:AlbionDataAvalonia.Logging"
             xmlns:events="clr-namespace:Serilog.Events;assembly=Serilog"
             x:Class="AlbionDataAvalonia.Views.LogsView"
			 Classes="AppPage"
			 x:DataType="vm:LogsViewModel">

	<UserControl.Styles>
		<Style Selector="TextBox.Filter">
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
		<Style Selector="ComboBox.Filter">
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*">
		<Border Grid.Row="0" Classes="UiBanner" Margin="0,8,0,0" IsVisible="{Binding IsDiagnosticsEnabled}">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeSmall}">
					<Run Text="Diagnostics mode is on." FontWeight="SemiBold" />
					<Run Text="Packets go to" />
					<Run Text="{Binding DiagnosticsFileName, Mode=OneWay}" />
					<Run Text="and are deleted after 2 days." />
				</TextBlock>
				<Button Grid.Column="1" Classes="UiAction" Content="Turn off" Command="{Binding TurnOffDiagnosticsCommand}" />
			</Grid>
		</Border>
		<WrapPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,8">
			<StackPanel Orientation="Vertical" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
				<TextBlock Classes="UiLabel" Text="Search logs" />
				<TextBox Classes="Filter"
						 Text="{Binding FilterText}"
						 Name="FilterBox"
						 Width="250" />
			</StackPanel>

			<StackPanel Orientation="Vertical" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
				<TextBlock Classes="UiLabel" Text="Rows" />
				<ComboBox Classes="Filter"
						  ItemsSource="{Binding AmountShownOptions}"
						  SelectedItem="{Binding SelectedAmountShown}"
						  Width="100" />
			</StackPanel>

			<StackPanel Orientation="Vertical" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
				<TextBlock Classes="UiLabel" Text="Show" />
				<ComboBox Classes="Filter"
						  ItemsSource="{Binding LogVerbosityOptions}"
						  SelectedItem="{Binding SelectedLogVerbosity}"
						  ToolTip.Tip="Filters this list only. The log file always keeps Debug and up."
						  Width="170">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="events:LogEventLevel">
							<TextBlock Text="{Binding StringFormat='{}{0} and up'}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>
		</WrapPanel>

		<DataGrid Grid.Row="2" Margin="0" ItemsSource="{Binding Events}"
				  RowHeight="NaN"
				  CopyingRowClipboardContent="LogsGrid_CopyingRowClipboardContent">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Time" Binding="{Binding LogEvent.Timestamp.UtcDateTime, Mode=OneWay, Converter={x:Static views:UiValueConverters.LocalTimestamp}}" SortMemberPath="LogEvent.Timestamp" FontSize="{DynamicResource UiFontSizeSmall}" />
				<DataGridTextColumn Header="Level" Binding="{Binding LogEvent.Level}" FontSize="{DynamicResource UiFontSizeSmall}" />
				<DataGridTemplateColumn Header="Message" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="logging:LogEventWrapper">
							<TextBlock Text="{Binding RenderedMessage}" FontSize="{DynamicResource UiFontSizeSmall}" TextWrapping="Wrap" VerticalAlignment="Center"
									   Margin="0,7" MaxLines="2" TextTrimming="CharacterEllipsis"
									   Classes="log-message"
									   DataContextChanged="LogMessage_DataContextChanged"
									   PointerReleased="LogMessage_PointerReleased">
								<ToolTip.Tip>
									<TextBlock Text="{Binding RenderedMessage}" TextWrapping="Wrap" MaxWidth="720" />
								</ToolTip.Tip>
								<TextBlock.Styles>
									<Style Selector="TextBlock.log-message.link">
										<Setter Property="Cursor" Value="Hand" />
										<Setter Property="Foreground" Value="{DynamicResource UiAccentTextBrush}" />
										<Setter Property="TextDecorations" Value="Underline" />
									</Style>
								</TextBlock.Styles>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>

</UserControl>
