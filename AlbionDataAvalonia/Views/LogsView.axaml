<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
             xmlns:logging="clr-namespace:AlbionDataAvalonia.Logging"
             xmlns:events="clr-namespace:Serilog.Events;assembly=Serilog"
             x:Class="AlbionDataAvalonia.Views.LogsView"
			 Classes="AppPage"
			 x:DataType="vm:LogsViewModel">


	<Grid RowDefinitions="Auto,Auto,*">
		<controls:InfoBanner Grid.Row="0" Margin="0,8,0,0" IsVisible="{Binding IsDiagnosticsEnabled}"
							 Title="Diagnostics mode is on"
							 Message="{Binding DiagnosticsFileName, StringFormat='Packets go to {0} and are deleted after 2 days.'}">
			<Button Classes="UiAction" Content="Turn off" Command="{Binding TurnOffDiagnosticsCommand}" />
		</controls:InfoBanner>
		<WrapPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0">
			<controls:FilterField Label="Search logs">
				<TextBox Text="{Binding FilterText}" Name="FilterBox" Width="230" />
			</controls:FilterField>
			<controls:FilterField Label="Rows">
				<ComboBox ItemsSource="{Binding AmountShownOptions}" SelectedItem="{Binding SelectedAmountShown}" Width="100" />
			</controls:FilterField>
			<controls:FilterField Label="Show">
				<ComboBox ItemsSource="{Binding LogVerbosityOptions}"
						  SelectedItem="{Binding SelectedLogVerbosity}"
						  ToolTip.Tip="Filters this list only. The log file always keeps Debug and up."
						  Width="170">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="events:LogEventLevel">
							<TextBlock Text="{Binding StringFormat='{}{0} and up'}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</controls:FilterField>
		</WrapPanel>

		<DataGrid Grid.Row="2" Margin="0" ItemsSource="{Binding Events}"
				  RowHeight="NaN"
				  CopyingRowClipboardContent="LogsGrid_CopyingRowClipboardContent">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Time" Binding="{Binding LogEvent.Timestamp.UtcDateTime, Mode=OneWay, Converter={x:Static views:UiValueConverters.LocalTimestamp}}" SortMemberPath="LogEvent.Timestamp" FontSize="{DynamicResource UiFontSizeSmall}" />
				<DataGridTextColumn Header="Level" Binding="{Binding LogEvent.Level}" FontSize="{DynamicResource UiFontSizeSmall}" />
				<DataGridTemplateColumn Header="Message" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="logging:LogEventWrapper">
							<TextBlock Text="{Binding RenderedMessage}" FontSize="{DynamicResource UiFontSizeSmall}" TextWrapping="Wrap" VerticalAlignment="Center"
									   Margin="0,7" MaxLines="2" TextTrimming="CharacterEllipsis"
									   Classes="log-message"
									   DataContextChanged="LogMessage_DataContextChanged"
									   PointerReleased="LogMessage_PointerReleased">
								<ToolTip.Tip>
									<TextBlock Text="{Binding RenderedMessage}" TextWrapping="Wrap" MaxWidth="720" />
								</ToolTip.Tip>
								<TextBlock.Styles>
									<Style Selector="TextBlock.log-message.link">
										<Setter Property="Cursor" Value="Hand" />
										<Setter Property="Foreground" Value="{DynamicResource UiAccentTextBrush}" />
										<Setter Property="TextDecorations" Value="Underline" />
									</Style>
								</TextBlock.Styles>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
		<controls:EmptyState Grid.Row="2" IsVisible="{Binding Events.Count, Converter={x:Static views:UiValueConverters.IsZero}}"
							 Message="No log entries to show." Hint="Try another search, or show more levels." />
	</Grid>

</UserControl>
