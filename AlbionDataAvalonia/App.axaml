<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             x:Class="AlbionDataAvalonia.App"
             RequestedThemeVariant="Dark">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://AlbionDataAvalonia/Themes/Tokens.axaml" />
				<ResourceInclude Source="avares://AlbionDataAvalonia/Themes/ControlThemes.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
	
	<Application.Styles>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<FluentTheme>
			<FluentTheme.Palettes>
				<ColorPaletteResources x:Key="Light" Accent="#ffff5722" AltHigh="White" AltLow="White" AltMedium="White" AltMediumHigh="White" AltMediumLow="White" BaseHigh="Black" BaseLow="#ffd7ccc8" BaseMedium="#ffa1847c" BaseMediumHigh="#ff7d5449" BaseMediumLow="#ff8f6c62" ChromeAltLow="#ff7d5449" ChromeBlackHigh="Black" ChromeBlackLow="#ffd7ccc8" ChromeBlackMedium="#ff7d5449" ChromeBlackMediumLow="#ffa1847c" ChromeDisabledHigh="#ffd7ccc8" ChromeDisabledLow="#ffa1847c" ChromeGray="#ff8f6c62" ChromeHigh="#ffd7ccc8" ChromeLow="#fffde9e4" ChromeMedium="#fff5e3de" ChromeMediumLow="#fffde9e4" ChromeWhite="White" ListLow="#fff5e3de" ListMedium="#ffd7ccc8" RegionColor="#ffefebe9" />
				<!-- Neutral grays at the lightness of the tokens in Themes/Tokens.axaml; orange comes only from the accent. -->
				<ColorPaletteResources x:Key="Dark" Accent="#fff57c00" AltHigh="Black" AltLow="Black" AltMedium="Black" AltMediumHigh="Black" AltMediumLow="Black" BaseHigh="White" BaseLow="#ff505050" BaseMedium="#ffa5a5a5" BaseMediumHigh="#ffbcbcbc" BaseMediumLow="#ff767676" ChromeAltLow="#ffbcbcbc" ChromeBlackHigh="Black" ChromeBlackLow="#ffbcbcbc" ChromeBlackMedium="Black" ChromeBlackMediumLow="Black" ChromeDisabledHigh="#ff505050" ChromeDisabledLow="#ffa5a5a5" ChromeGray="#ff8d8d8d" ChromeHigh="#ff8d8d8d" ChromeLow="#ff1c1c1c" ChromeMedium="#ff2a2a2a" ChromeMediumLow="#ff3a3a3a" ChromeWhite="White" ListLow="#ff474747" ListMedium="#ff555555" RegionColor="#ff303030" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<StyleInclude Source="avares://AlbionDataAvalonia/Themes/Typography.axaml" />
		<StyleInclude Source="avares://AlbionDataAvalonia/Themes/Buttons.axaml" />
		<StyleInclude Source="avares://AlbionDataAvalonia/Themes/Surfaces.axaml" />
		<StyleInclude Source="avares://AlbionDataAvalonia/Themes/Controls.axaml" />
	</Application.Styles>	

	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon Icon="/Assets/logo.ico"
                      ToolTipText="Albion Data Client"
					  Clicked="OnTrayClicked">
				<TrayIcon.Menu>
					<NativeMenu x:DataType="vm:MainViewModel">
						<NativeMenuItem Header="Show Window" Command="{Binding ShowMainWindowCommand}"/>
						<NativeMenuItem Header="Exit" Command="{Binding ExitCommand}"/>
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>
</Application>
